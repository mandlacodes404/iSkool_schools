# ============================================================
#  iSkool — .htaccess (sandbox + live — same file for both)
#  Place in root folder alongside index.php
# ============================================================

# ── START REWRITE ENGINE ─────────────────────────────────────
RewriteEngine On
RewriteOptions inherit


# ── 1. FORCE HTTPS (your original rules — untouched) ─────────
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^(^.*)\\.iskool\\.online$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/%{REQUEST_URI} [L,R=301]


# ── 2. LANDING PAGE ON ROOT DOMAIN (your original — untouched) ──
RewriteCond %{HTTP_HOST} ^(www\.)?iskool\.online$ [NC]
RewriteRule ^$ /website/website-clone.html [L]


# ── 3. MANIFEST.JSON → MANIFEST.PHP (your original — untouched) ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^manifest\.json$ manifest.php [L]


# ── 4. HIDE .PHP EXTENSION FROM URLS ─────────────────────────
# yoursite/learner_dashboard works instead of learner_dashboard.php
# Existing .php links still work — nothing breaks
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]


# ── 5. BLOCK DIRECTORY LISTING ───────────────────────────────
# Stops people browsing your folders like /uploads/, /api/ etc.
Options -Indexes


# ── 6. PROTECT SENSITIVE FILES ───────────────────────────────
# These files cannot be opened directly in a browser
<FilesMatch "(^\.env|config\.php|check_remember_me\.php|php_errors\.log|composer\.json|composer\.lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>


# ── 7. BLOCK SENSITIVE FOLDERS ───────────────────────────────
RewriteRule ^(auth|migrations|old_files|tests|vendor|\.git)(/|$) - [F,L]


# ── 8. PROTECT API FOLDER (fetch/AJAX only) ──────────────────
# Blocks direct browser visits to /api/...
# Your app's fetch() calls still work fine
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteCond %{HTTP_X_REQUESTED_WITH} !XMLHttpRequest [NC]
RewriteCond %{HTTP_ACCEPT} !application/json [NC]
RewriteRule ^ - [F,L]


# ── 9. SECURITY HEADERS ──────────────────────────────────────
<IfModule mod_headers.c>
    # Hide PHP version and server info
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Prevent your pages being loaded inside iframes on other sites (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Stop browsers guessing file types (MIME sniffing attacks)
    Header always set X-Content-Type-Options "nosniff"

    # Forces HTTPS for 1 year once browser has visited once
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Basic XSS protection for older browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Controls what info is sent when clicking links to other sites
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # CORS: Allow icons + manifest on all subdomains (your original — untouched)
    <FilesMatch "\.(png|ico|json|php)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>


# ── 10. BLOCK COMMON ATTACK PATTERNS ─────────────────────────
RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} base64_encode.*\(.*\) [NC,OR]
RewriteCond %{QUERY_STRING} union.*select.*\( [NC,OR]
RewriteCond %{QUERY_STRING} concat.*\( [NC]
RewriteRule ^ - [F,L]


# ── 11. BLOCK BAD BOTS ───────────────────────────────────────
RewriteCond %{HTTP_USER_AGENT} (havij|libwww-perl|wget|python|nikto|curl|scan|java|winhttp|clshttp|loader) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} (%0A|%0D|%27|%3C|%3E|%00) [NC]
RewriteRule ^ - [F,L]


# ── 12. BLOCK HIDDEN FILES (.git, .env etc.) ─────────────────
RewriteRule (^|/)\.(?!well-known) - [F,L]


# ── 13. PHP SECURITY SETTINGS ────────────────────────────────
<IfModule mod_php.c>
    php_flag expose_php off
    php_flag session.cookie_httponly on
    php_flag session.cookie_secure on
    php_value session.cookie_samesite "Strict"
</IfModule>
