RewriteEngine On

# Security hardening
Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Block sensitive files, hidden files, and private folders.
RewriteRule (^|/)\.(?!well-known/) - [F,L,NC]
RewriteRule (^|/)(config\.php|\.env|php_errors\.log)$ - [F,L,NC]
RewriteRule (^|/)(auth|migrations|old_files|tests|vendor|\.git)(/|$) - [F,L,NC]

# Keep API endpoints available to fetch(), but block direct browser document visits.
RewriteCond %{REQUEST_URI} (^|/)api/ [NC]
RewriteCond %{HTTP:Sec-Fetch-Mode} ^navigate$ [NC,OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^ - [F,L]

# Block common SQL injection and XSS probes in query strings.
RewriteCond %{QUERY_STRING} "(union(\s|%20)+select|select(\s|%20)+.*(\s|%20)+from|insert(\s|%20)+into|drop(\s|%20)+table|update(\s|%20)+.*(\s|%20)+set|delete(\s|%20)+from|sleep\(|benchmark\(|load_file\(|outfile|(<|%3C)(script|iframe|object|embed)|javascript:|onerror(\s|%20)*=|onload(\s|%20)*=|base64_decode\(|GLOBALS=|_REQUEST=)" [NC]
RewriteRule ^ - [F,L]

# Clean URLs for normal pages. API .php URLs are left alone so existing fetch() calls keep working.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !/(api)/ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[?\s] [NC]
RewriteRule ^(.+)\.php$ $1 [R=308,L,NE]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Route manifest.json -> manifest.php for dynamic school name
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^manifest\.json$ manifest.php [L]
