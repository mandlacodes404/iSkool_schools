                    :host {
                        /* Base styling for the drop indicator */
                        position: absolute;
                        z-index: 130; /* drop indicator to show up on top of toolstrip (zIndex 20) and WebWindowDialog (Zindex 100) */
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        box-sizing: border-box;
                        overflow: hidden;
                    
                        /* Customizable properties set by element properties */
                        left: var(--mw-drop-indicator-x, -100px);
                        top: var(--mw-drop-indicator-y, -100px);
                        width: var(--mw-drop-indicator-width, 0px);
                        height: var(--mw-drop-indicator-height, 0px);
                        border: var(--mw-drop-indicator-border-size, 3px) solid var(--mw-drop-indicator-border-color, #4080ff); /* Dark Mode: #90ceff? */
                        background-color: var(--mw-drop-indicator-background-color, #80c0ff40);
                        pointer-events: none; /* Element should not capture mouse events */
                    }
                    
                    :host([hidden]) {
                        display: none;
                    }

                    :host([mode="undocking"]) {
                        /*
                            --mw-drop-indicator-x: 0px !important;
                            --mw-drop-indicator-y: 0px !important;
                            --mw-drop-indicator-width: 100% !important;
                            --mw-drop-indicator-height: 100% !important;
                        */

                        --mw-drop-indicator-stroke-color: var(--mw-backgroundColor-tertiary, #ffffff);

                        --mw-drop-indicator-background-border-color: var(--mw-borderColor-primary, #7d7d7d);
                        --mw-drop-indicator-background-header-color: var(--mw-borderColor-secondary, #bfbfbf);
                        --mw-drop-indicator-background-background-color: var(--mw-backgroundColor-primary, #d9d9d9);

                        --mw-drop-indicator-foreground-border-color: var(--mw-borderColor-focus, #268cdd);
                        --mw-drop-indicator-foreground-header-color: var(--mw-color-blue300, #83caff);
                        --mw-drop-indicator-foreground-background-color: var(--mw-backgroundColor-primary, #ffffff);
                        --mw-drop-indicator-foreground-button-color: var(--mw-color-blue550, #1171be);
                    }

                    :host([mode="undocking"]) svg {
                        width: 50%;
                    }

                    :host([mode="partial"]) {
                        --mw-drop-indicator-border-color: rgb(103, 76, 6);
                        --mw-drop-indicator-background-color: rgba(255, 239, 145, 0.25);
                        --mw-drop-indicator-font-color: rgba(255, 239, 145);
                        --mw-drop-indicator-msg-visibility: flex;
                    }

                    #msgBox {
                        display: var(--mw-drop-indicator-msg-visibility, none);
                        align-items: center;
                        justify-content: center;
                        flex-direction: column;
                        gap: 16px;

                        padding: 32px;
                        border-radius: 8px;
                        background-color: var(--mw-drop-indicator-border-color, #4080ff);

                        font-size: large;
                        font-weight: bold;
                        color: var(--mw-drop-indicator-font-color, rgb(255, 239, 145));
                    }

                    #msgBox:empty {
                        display: none;
                    }
