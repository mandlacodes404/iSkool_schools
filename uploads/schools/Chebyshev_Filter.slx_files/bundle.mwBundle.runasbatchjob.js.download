	   cellspacing="0">
	<tbody class="dijitReset" data-dojo-attach-point="containerNode"></tbody>
</table>
`},"dojo/text!dijit/templates/MenuItem.html":y=>{y.exports=`<tr class="dijitReset" data-dojo-attach-point="focusNode" role="menuitem" tabIndex="-1">
	<td class="dijitReset dijitMenuItemIconCell" role="presentation">
		<span role="presentation" class="dijitInline dijitIcon dijitMenuItemIcon" data-dojo-attach-point="iconNode"></span>
	</td>
	<td class="dijitReset dijitMenuItemLabel" colspan="2" data-dojo-attach-point="containerNode,textDirNode"
		role="presentation"></td>
	<td class="dijitReset dijitMenuItemAccelKey" style="display: none" data-dojo-attach-point="accelKeyNode"></td>
	<td class="dijitReset dijitMenuArrowCell" role="presentation">
		<span data-dojo-attach-point="arrowWrapper" style="visibility: hidden">
			<span class="dijitInline dijitIcon dijitMenuExpand"></span>
			<span class="dijitMenuExpandA11y">+</span>
		</span>
	</td>
</tr>
`},"dojo/text!mw-form/templates/CheckBox.html":y=>{y.exports=`<div data-dojo-attach-point="focusNode" role="checkbox" aria-checked="false"
    ><div data-dojo-attach-point="checkBoxRadioIconNode" class="mwCheckBoxRadioIconNode"
        ><div class="mwCheckBoxRadioIconInner"></div></div
    ><div data-dojo-attach-point="textNode" class="mwTextNode"></div
></div>`},"dojo/text!mw-form/templates/ComboBox.html":y=>{y.exports=`<div>
    <div class="mwComboBoxInnerContainer"><div class="mwTextFieldContainerNode" data-dojo-attach-point="textFieldContainerNode"></div><div class="mwArrowContainerNode" data-dojo-attach-point="arrowNode"><div class="mwArrowNode"></div></div></div>
</div>`},"dojo/text!mw-form/templates/Menu.html":y=>{y.exports=`<div data-dojo-attach-point="focusNode" tabindex="0" role="menu" data-focus="temporary"></div>
`},"dojo/text!mw-form/templates/MenuItem.html":y=>{y.exports=`<div data-dojo-attach-point="focusNode" role="menuitem"
        ><div class="mwIconNode" data-dojo-attach-point="iconNode"></div
        ><div class="mwTextAndDescriptionContainerNode" data-dojo-attach-point="textAndDescriptionContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
        ><div data-dojo-attach-point="descriptionNode" class='mwDescriptionNode'></div
    ></div
    ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
></div>`},"dojo/text!mw-form/templates/MenuPanel.html":y=>{y.exports=`<div data-dojo-attach-point="focusNode" tabindex="0"></div>
`},"dojo/text!mw-form/templates/MenuSeparator.html":y=>{y.exports=`<div data-refuse-key-nav="true"></div>
`},"dojo/text!mw-form/templates/TextField.html":y=>{y.exports='<div><input class= "mwInputNode mwAlignmentNode" spellcheck="false" type="text" data-dojo-attach-point="inputNode,focusNode"></div>'},"dojo/text!mw-notifications/templates/ProgressBar.html":y=>{y.exports='<div data-test-id="${data-test-id}" data-value="${value}">\n    <div data-dojo-attach-point="gutterNode" class="${baseClass}Gutter">\n        <div data-dojo-attach-point="progressNode" class="${baseClass}Progress"></div>\n    </div>\n    <div data-dojo-attach-point="progressTextNode" class="${baseClass}Text">50%</div>\n</div>'},"dojo/text!pct/app/jobmonitor/JobMonitor.html":y=>{y.exports=`<div>
    <div class="\${baseClass}Header">
        <div class="pctNoWrap \${baseClass}TextLabel">\${nls.SelectProfile}</div>
        <div id="\${id}ProfileSelector"
             class="\${baseClass}ProfileSelector"
             data-dojo-type="pct/app/cluster/profiles/ProfileSelector"
             data-dojo-attach-event="change: _handleSelectedProfileChanged"
             data-dojo-attach-point="profileSelector"
             data-dojo-props="width: 'auto'"></div>
        <div id="\${id}UsersCheckBox"
             class="\${baseClass}UsersCheckBox"
             data-dojo-type="mw-form/CheckBox"
             data-dojo-attach-point="showAllUsersCheckBox"
             data-dojo-attach-event="change: _refresh"
             data-dojo-props="text: '\${nls.ShowJobsFromAllUsers}'"></div>
    </div>
    <div id="\${id}TableGrid"
         class="\${baseClass}TableGrid"
         data-dojo-type="pct/app/jobmonitor/JobMonitorTable"
         data-dojo-props="sort: 'id'"
         data-dojo-attach-point="table"
         data-dojo-attach-event="delete-job: _handleDelete"></div>
    <div class="\${baseClass}Footer">
        <mw-progress-or-icon-label
             id="\${id}Status"
             class="\${baseClass}Status \${baseClass}TextLabel"
             data-dojo-attach-point="statusLine"></mw-progress-or-icon-label>
        <div class="pctNoWrap \${baseClass}TextLabel">\${nls.AutoUpdate}</div>
        <div id="\${id}UpdateFrequency"
             class="\${baseClass}UpdateFrequency"
             data-dojo-type="pct/app/jobmonitor/JobMonitorUpdateFrequencySelector"
             data-dojo-attach-event="change: _handleUpdateFrequencyChanged"
             data-dojo-attach-point="updateFrequencyComboBox"></div>
        <button id="\${id}UpdateButton"
                class="\${baseClass}UpdateButton"
                data-dojo-type="mw-form/PushButton"
                data-dojo-attach-point="updateButton"
                data-dojo-attach-event="click: _handleUpdateClicked"
                data-dojo-props="text: '\${nls.UpdateNow}'">
        </button>
    </div>
</div>
`},"dojo/text!MW/layout/templates/Tab.html":y=>{y.exports=`<div class="tab">
    <span class="mwTabHeader" data-dojo-attach-point="headerNode"
    ></span><span class="tabIcon" data-dojo-attach-point="iconNode"
    ></span><span class="mwTabLabel" data-dojo-attach-point="labelNode,containerNode"
    ></span>
    <span class="closeContainer"><span class="busyIndicatorPlaceholder" data-dojo-attach-point="busyIndicatorNode"
    ></span><span class="tabCloseIcon" data-dojo-attach-point="closeNode"
    >
    <mw-icon icon-id="deleteBorderlessUI" icon-width="12" icon-height="12" class="closeIcon"
    ></mw-icon>
    <mw-icon icon-id="errorCrossUI" icon-width="12" icon-height="12" class="crossCloseIcon"
    ></mw-icon>
    </span></span>
</div>
`},"dojo/text!MW/layout/templates/TabPlusButton.html":y=>{y.exports=`<div class="tabPlusButton" role="button">
    <div class="tabPlusIconWrapper">
    <div class="tabPlusIcon" data-dojo-attach-point="plusNode"
    ></div>
