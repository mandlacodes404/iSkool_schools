table.exampleLine{
    border-spacing: 5px;
    border-collapse: separate;
}

.previewContainer{
    margin-top: 5px;
}

.deploymentHelpTextWrapper{
    overflow: auto;
    /* width: 100%; */
}

.helpTextWidget{
    color: var(--mw-color-primary);
}`,""]),c.exports=E},"1eabf3a49404cdc601a1a641f1b77f6b51e5e639":(c,v,t)=>{var C=t("mwBundle.compiler-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),m=t("mwBundle.compiler-ui|cb47172937e548a863ab648aecddd4b09386a96d"),E=t("mwBundle.compiler-ui|2f397a74fb736377a9f06c6aacb963ed00b193ea"),f=m(C);f.i(E),f.push([c.id,"",""]),c.exports=f},"2f397a74fb736377a9f06c6aacb963ed00b193ea":(c,v,t)=>{var C=t("mwBundle.compiler-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),m=t("mwBundle.compiler-ui|cb47172937e548a863ab648aecddd4b09386a96d"),E=m(C);E.push([c.id,`/* Copyright 2022 The MathWorks, Inc. */

body {
}

.main {
    
}

div.appFooter {
    margin: 0;
}

/* SETTINGS DIALOG */
.mwDialog .mwModalDialog .mwModalDialogFg {
    height: auto;
}

/* DEPLOY DIALOG */
div.autoDeployDiv  {
    padding-left: 15px;
    padding-top: 5px;
}

div.webAppServerDropdownDiv {
    padding-left: 15px;
    padding-top: 5px;
    float: left;
}

div.deployWebAppFolderDiv {
    padding-left: 15px;
}

.deployRadioSelection > .autoDeployDiv {
    font-size: 13px;
}

.deploymentSection + .deploymentSection{
    margin-top: 15px ;
}

.deploymentSection.deploymentSectionContiguous{
    break-before:avoid-column;
}

.deployButtonDiv {
    display: flex;
    padding-left: 20px;
    padding-top: 5px;
    line-height: 14px;
}

.directDeployDiv {
    margin-left: 25px;
}

.webAppServerDropdownDiv {
    width: 240px !important;
}

.errorDiv {
    margin-left: 40px;
    color: #B7312C;
    height: 35px;
    overflow-y: auto;
}
