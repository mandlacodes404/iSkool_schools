            }

            :host([vertical]) > div {
                border-top: none;
                border-left: 1px solid var(--mw-borderColor-secondary);
            }

            :host > div.mw-menu {
                display: grid;
                border: none;
                grid-template-columns: [gutter] var(--separator-gutter-size) [separator] auto;
            }

            :host > div.mw-menu [part=gutter] {
                grid-column: gutter;
            }

            :host > div.mw-menu [part=separator] {
                grid-column: separator;
                border-top: 1px solid var(--mw-borderColor-secondary);
            }

            :host > div.mw-combobox {
                display: none;
            }

            :host > div.mw-menu-collapsible-area,
            :host > div.mw-menu-focused-area,
            :host > div.mw-menu-area {
