            ><div data-dojo-attach-point="dropDownAlignmentNode" class="mwDropDownAlignmentNode"></div
            ><div data-dojo-attach-point="dropDownContainerNode" class="mwDropDownContainerNode"
                ><div data-dojo-attach-point="inlineTextNode" class="mwTextNode mwInlineTextNode"
                    ><div data-dojo-attach-point="inlineTextLine" class="mwTextContentNode"></div
                ></div
                ><div data-dojo-attach-point="arrowNode" class="mwArrowNode"
                    ><div data-dojo-attach-point="lastTextLineNode" class="mwLastTextLineNode"
                        ><div data-dojo-attach-point="lastTextLine" class="mwTextContentNode"></div
                    ></div
                    ><div data-dojo-attach-point="arrowIconNode" class="mwArrowIconNode"></div
                ></div
            ></div
        ></div
    ></div
></div>`},"dojo/text!mw-form/templates/Label.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode"
    ><div data-dojo-attach-point="contentWrapperNode" class="mwContentWrapperNode"
        ><div data-dojo-attach-point="iconAndTextContainerNode" class="mwIconAndTextContainerNode mwAlignmentNode"
            ><div data-dojo-attach-point="iconNode" class="mwIconNode"></div
