B2C8\uB2E4.",setupToolboxReaccess:"\uD234\uBC15\uC2A4 \uC791\uC5C5\uC744 \uB2EB\uC740 \uACBD\uC6B0 <b>\uD504\uB85C\uC81D\uD2B8</b> \uD0ED\uC5D0\uC11C <b>\uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5 \uAD00\uB9AC\uC790</b>\uB97C \uD074\uB9AD\uD558\uC5EC \uC5B8\uC81C\uB4E0\uC9C0 \uB2E4\uC2DC \uC5F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",setupToolboxReaccessFromApp:"\uD234\uBC15\uC2A4 \uC791\uC5C5\uC744 \uB2EB\uC740 \uD6C4 \uACF5\uC720\uD560 \uC571\uC744 \uC7AC\uAD6C\uC131\uD558\uB824\uBA74 <b>\uD504\uB85C\uC81D\uD2B8</b> \uD0ED\uC5D0\uC11C <b>\uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5 \uAD00\uB9AC\uC790</b>\uB97C \uD074\uB9AD\uD558\uC5EC \uC791\uC5C5\uC744 \uB2E4\uC2DC \uC5EC\uC2ED\uC2DC\uC624.",setupToolboxRootFolderFromApp:"\uC571 \uC815\uBCF4\uB97C \uC0AC\uC6A9\uD558\uC5EC \uD234\uBC15\uC2A4 \uD3F4\uB354\uAC00 \uC124\uC815\uB418\uC5C8\uC73C\uBA70 \uC571\uC774 \uC791\uC5C5\uC5D0 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uD234\uBC15\uC2A4\uAC00 \uC124\uCE58\uB41C \uACBD\uC6B0 \uC571\uC774 \uC124\uCE58\uB418\uACE0 \uC571 \uAC24\uB7EC\uB9AC\uC5D0 \uCD94\uAC00\uB429\uB2C8\uB2E4.",setupToolboxRootFolderFromUpgrade:"\uC791\uC5C5\uC744 \uC704\uD55C \uD234\uBC15\uC2A4 \uD3F4\uB354\uB294 \uD234\uBC15\uC2A4\uC758 \uC815\uBCF4\uB97C \uC0AC\uC6A9\uD558\uC5EC \uC124\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uD544\uC694\uC5D0 \uB530\uB77C \uD30C\uC77C\uACFC \uD3F4\uB354\uB97C \uC81C\uC678\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",setupToolboxRootFolderNew:"\uD234\uBC15\uC2A4 \uAD6C\uC131\uC744 \uC2DC\uC791\uD558\uB824\uBA74 \uBA54\uC778 \uD234\uBC15\uC2A4 \uD3F4\uB354\uB97C \uC9C0\uC815\uD558\uC2ED\uC2DC\uC624. \uD30C\uC77C \uBBF8\uB9AC\uBCF4\uAE30\uB294 \uD234\uBC15\uC2A4\uC5D0 \uD3EC\uD568\uB420 \uD30C\uC77C\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uD544\uC694\uC5D0 \uB530\uB77C \uD30C\uC77C\uACFC \uD3F4\uB354\uB97C \uC81C\uC678\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",showAllOptions:`\uBAA8\uB4E0 \uC635\uC158
\uD45C\uC2DC`,showCode:"\uCF54\uB4DC \uD45C\uC2DC",sidebarImage:"\uC0AC\uC774\uB4DC\uBC14 \uC774\uBBF8\uC9C0",specifyDetails:"\uC0C8 \uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5\uC758 \uC138\uBD80 \uC815\uBCF4\uB97C \uC9C0\uC815\uD569\uB2C8\uB2E4.",splashScreen:"\uC2DC\uC791 \uD654\uBA74",subfolderErrorMessage:"\uD504\uB85C\uC81D\uD2B8\uAC00 \uC571 \uD3F4\uB354\uC758 \uD558\uC704 \uD3F4\uB354\uC5D0 \uC774\uBBF8 \uC874\uC7AC\uD558\uBBC0\uB85C \uD504\uB85C\uC81D\uD2B8\uB97C \uC0DD\uC131\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uAE30\uC874 \uD504\uB85C\uC81D\uD2B8\uB97C \uC81C\uAC70\uD558\uAC70\uB098 \uAE30\uC874 \uD504\uB85C\uC81D\uD2B8\uC5D0 \uC571\uC744 \uCD94\uAC00\uD558\uC2ED\uC2DC\uC624.",supportPackageDriverLocation:"${0}\uC774(\uAC00) \uB2E4\uC74C\uC5D0 \uC788\uB294 \uCD94\uAC00 \uB4DC\uB77C\uC774\uBC84\uB97C \uC81C\uACF5\uD568: ${1}\n",supportPackagePlaceholder:"\uC9C0\uC6D0 \uD328\uD0A4\uC9C0 \uC885\uC18D \uAD00\uACC4\uAC00 \uBC1C\uACAC\uB418\uC9C0 \uC54A\uC74C",supportPackagesRequired:"\uC774 \uBC30\uD3EC\uC5D0\uB294 \uCD94\uAC00 \uC9C0\uC6D0 \uD328\uD0A4\uC9C0\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4. \uC120\uD0DD\uD55C \uC9C0\uC6D0 \uD328\uD0A4\uC9C0\uAC00 \uBC30\uD3EC\uB41C \uC560\uD50C\uB9AC\uCF00\uC774\uC158\uC5D0 \uD3EC\uD568\uB429\uB2C8\uB2E4.",target:"\uD0C0\uAE43",targetType:"\uD0C0\uAE43 \uC720\uD615:",taskName:"\uC791\uC5C5 \uC774\uB984:",tasksDetected:"\uD604\uC7AC \uC5F4\uB824 \uC788\uB294 \uD504\uB85C\uC81D\uD2B8\uC5D0 \uB2E4\uC74C\uACFC \uAC19\uC740 \uC791\uC5C5\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uD2B9\uC815 \uC791\uC5C5\uC744 \uC120\uD0DD\uD558\uC5EC \uC5F4\uAC70\uB098 \uC0C8 \uBC30\uD3EC \uC791\uC5C5\uC744 \uB9CC\uB4DC\uC2ED\uC2DC\uC624.",toggleShowAll:"\uBAA8\uB4E0 \uAD6C\uC131 \uD328\uB110\uC758 \uD45C\uC2DC \uCF1C\uAE30/\uB044\uAE30",toggleShowCode:"\uD604\uC7AC \uC120\uD0DD\uC5D0 \uB300\uD55C MATLAB \uCF54\uB4DC\uC758 \uD45C\uC2DC \uCF1C\uAE30/\uB044\uAE30",toolboxInfo:"\uD234\uBC15\uC2A4 \uD30C\uC77C\uC744 \uD3EC\uD568\uD558\uB294 \uD3F4\uB354\uB97C \uC120\uD0DD\uD558\uC2ED\uC2DC\uC624. \uC774\uB7EC\uD55C \uD30C\uC77C\uC740 \uD234\uBC15\uC2A4\uB97C \uD328\uD0A4\uC9D5\uD558\uB294\uB370 \uC0AC\uC6A9\uB418\uB294 \uC0C8 MATLAB \uD504\uB85C\uC81D\uD2B8\uC5D0 \uD3EC\uD568\uB429\uB2C8\uB2E4. \uD3F4\uB354\uC5D0 \uC774\uBBF8 \uD504\uB85C\uC81D\uD2B8\uAC00 \uD3EC\uD568\uB418\uC5B4 \uC788\uB294 \uACBD\uC6B0 \uAE30\uC874 \uD504\uB85C\uC81D\uD2B8\uAC00 \uB300\uC2E0 \uC0AC\uC6A9\uB429\uB2C8\uB2E4.",toolboxInfoNew:"R2025a\uBD80\uD130 \uD234\uBC15\uC2A4 \uD328\uD0A4\uC9D5\uC740 \uAD6C\uC131 \uD655\uC7A5\uC744 \uC704\uD574 \uD504\uB85C\uC81D\uD2B8\uC640 \uD1B5\uD569\uB418\uBA70 \uD234\uBC15\uC2A4\uB97C \uAD6C\uC131\uD558\uACE0 \uD328\uD0A4\uC9D5\uD558\uB294 \uC791\uC5C5\uC744 \uD3EC\uD568\uD569\uB2C8\uB2E4.",toolboxUpgradeDescription:"\uC774 \uD234\uBC15\uC2A4\uB294 \uC774\uC804 \uB9B4\uB9AC\uC2A4\uC758 MATLAB\uC5D0\uC11C \uC0DD\uC131\uB418\uC5C8\uC73C\uBA70 \uC774 \uB9B4\uB9AC\uC2A4\uB85C \uC131\uACF5\uC801\uC73C\uB85C \uC5C5\uADF8\uB808\uC774\uB4DC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.",toolboxUpgradeIssues:"\uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uB294 \uC911 \uD234\uBC15\uC2A4\uC758 \uAE30\uB2A5\uC5D0 \uC601\uD5A5\uC744 \uBBF8\uCE60 \uC218 \uC788\uB294 \uBA87 \uAC00\uC9C0 \uBB38\uC81C\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4.",toolboxUpgradeSpecialInfo:"R2025a\uBD80\uD130 \uD234\uBC15\uC2A4 \uD328\uD0A4\uC9D5\uC740 \uAD6C\uC131 \uD655\uC7A5\uC744 \uC704\uD574 \uD504\uB85C\uC81D\uD2B8\uC640 \uD1B5\uD569\uB418\uBA70 \uD234\uBC15\uC2A4\uB97C \uAD6C\uC131\uD558\uACE0 \uD328\uD0A4\uC9D5\uD558\uB294 \uC791\uC5C5\uC744 \uD3EC\uD568\uD569\uB2C8\uB2E4.",toolboxUpgradeTitle:"\uD234\uBC15\uC2A4 \uD328\uD0A4\uC9D5 \uC5C5\uB370\uC774\uD2B8",toolstripLabelActions:"\uB3D9\uC791",toolstripLabelDeployment:"\uBC30\uD3EC",toolstripLabelPackage:"\uD328\uD0A4\uC9D5",versionLabel:"\uBC84\uC804",viewDetails:"\uC138\uBD80 \uC815\uBCF4 \uBCF4\uAE30",viewIssues:"\uBB38\uC81C \uBCF4\uAE30",webAppCardPreview:"\uC6F9 \uC571 \uCE74\uB4DC \uBBF8\uB9AC\uBCF4\uAE3