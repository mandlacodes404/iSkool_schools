:host([iconAlignment='rightmargin']) .mwAlignmentText, :host([iconAlignment='leftmargin']) .mwAlignmentText {
    flex-grow: 1;
}
:host([iconAlignment='center']) .mwAlignmentText {
    z-index: 1;
