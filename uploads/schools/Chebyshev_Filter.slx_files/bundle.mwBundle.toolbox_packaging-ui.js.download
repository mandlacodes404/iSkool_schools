        ><div data-dojo-attach-point="descriptionNode" class='mwDescriptionNode'></div
    ></div
    ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
    ><div class="mwOverlayNode"></div
></div>
`},"dojo/text!mw-form/templates/ComboBox.html":h=>{h.exports=`<div>
    <div class="mwComboBoxInnerContainer"><div class="mwTextFieldContainerNode" data-dojo-attach-point="textFieldContainerNode"></div><div class="mwArrowContainerNode" data-dojo-attach-point="arrowNode"><div class="mwArrowNode"></div></div></div>
</div>`},"dojo/text!mw-form/templates/DropDownButton.html":h=>{h.exports=`<div data-dojo-attach-point="contentWrapperNode" class="mwContentWrapperNode"
    ><div data-dojo-attach-point="focusNode" class="mwFocusNode"  role="button" aria-haspopup="true"
          aria-expanded="false"
        ><div data-dojo-attach-point="buttonNode" class="mwButtonNode"
