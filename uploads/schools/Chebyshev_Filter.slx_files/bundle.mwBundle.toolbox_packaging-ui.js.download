                ><div data-dojo-attach-point="iconNode" class="mwIconNode"></div
                ><div data-dojo-attach-point="textNode" class="mwTextNode mwBlockTextNode"
                    ><div data-dojo-attach-point="textLine" class="mwTextContentNode"></div
                ></div
            ></div
        ></div
