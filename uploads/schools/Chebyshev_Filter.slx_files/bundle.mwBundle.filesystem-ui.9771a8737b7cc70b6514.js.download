.git-label-head {
    border: 1px solid var(--mw-borderColor-breakpointConditional);
    background-color: var(--mw-backgroundColor-searchHighlight-secondary);
}

.git-label-branch {
    border: 1px solid var(--mw-backgroundColor-currentLineExecutionBrick);
    background-color: var(--mw-backgroundColor-currentLineExecution);
}

.git-label-remote {
    border: 1px solid var(--mw-backgroundColor-scrollbarThumb-active);
    background-color: var(--mw-backgroundColor-tab);
}

.git-label-tag {
    border: 1px solid var(--mw-backgroundColor-toolstripContextualTab);
    background-color: var(--mw-backgroundColor-announcementBanner);
}

.git-label-worktree, .git-label-main-worktree {
    border: 1px solid var(--mw-backgroundColor-currentLineExecutionBrick);
    background-color: var(--mw-backgroundColor-currentLineExecution);
}

.git-label-tag, .git-label-head, .git-label-branch, .git-label-remote, .git-label-worktree, .git-label-main-worktree {
    white-space: nowrap;
    padding-left: 2px;
    padding-right: 2px;
    height: 100%;
    box-sizing: border-box;
}
