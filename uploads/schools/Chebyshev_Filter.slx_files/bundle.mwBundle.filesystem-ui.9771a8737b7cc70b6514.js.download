.mw-git-blameview-section {
    width: 100%;
    border: none;
    border-bottom: 1px solid;
    margin-top: 1px;
    border-color: var(--panelHeader-border-color);
    display: flex;
    flex-wrap: nowrap;
}

mw-cmlink-hunk-widget{
    display: flex;
    gap: 2px;
    flex-direction: row;
    flex-wrap: nowrap;
    flex-grow: 1;
}

.mw-git-blameview-section .mw-git-blameview-selected{
    background: var(--mw-backgroundColor-input);
}

.mw-git-blameview-name{
    flex-grow: 1;
    text-align: left;
    margin-top: 2px;
}

.mw-git-blameview-date{
    margin-top: 2px;
}

.mw-git-blame-avatar{
    z-index: -2;
    height: 16px;
    width: 16px;
    margin-left: 2px;
    margin-right: 8px;
    display: flex;
    border-radius: 50%;
    overflow: hidden;
}

.mw-git-blameview-section-none {
    background: var(--mw-backgroundColor-secondary);
