#connectionsPanel {
}

#connectionsPanel mw-fsui-subpanel {
}

#connectionsPanel .mw-treeNode-renderer-container {
    width: 100%;
}

.hideDomNode {
    display: none !important;
}

#connectionsPanel .connectionsView {
    height: 100%;
    display: flex;
    align-items: stretch;
    flex-direction: column;
}

#connectionsPanel .connectionListing {
    min-width: 32px;
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: center;
    margin-top: 3px;
    text-overflow: ellipsis;
    overflow: hidden;
}

#connectionsPanel .tree {
    max-width: 100%;
    height: 100%;
}

#connectionsPanel .connectionsTree {
    height: 100%;
}

#connectionsPanel .mwSearchTextField {
    width: 100%;
}

#connectionsPanel .connectionIcon {
    margin-right: 5px;
}

#connectionsPanel .parentNode {
    margin-left: 0px !important;
}

#connectionsPanel .mw-tree .treeNode {
    padding-bottom: 6px;
}

#connectionsPanel .dijitTitlePaneContentOuter {
    background: var(--mw-backgroundColor-primary) !important;
    border: 1px solid var(--mw-borderColor-primary) !important;
}

#connectionsPanel mw-connections-myconnections-view, 
#connectionsPanel mw-connections-availableconnections-view, 
#connectionsPanel .dijitReset,
#connectionsPanel .dijitTitlePaneContentInner,
#connectionsPanel .connections-search-section-tree,
#connectionsPanel .connections-search-section-tree .mw-tree  {
    height: 100%;
    overflow-y: hidden;
}

#connectionsPanel mw-connections-availableconnections-view, mw-connections-myconnections-view {
    display: flex;
    flex-direction: column;
}

#connectionsPanel mw-connections-availableconnections-view .mw-tree.treeContainer {
    height: auto !important;
}

  /** Action zone: Begin **/
.mwconnectionActionsContainer {
    height: 100%;
}

.connectionActionZone {
    position: relative;
    vertical-align: middle;
    top: 25%;
}

  /** Action zone: End **/

#connectionsPanel .mw-tree-scroll-component{
    overflow: hidden;
}

mw-connections-availableconnections-view .mw-tree-body-component{
    height: 100% !important;
    max-height: 100% !important;
    width: 100% !important;
}

mw-connections-myconnections-view .mw-tree-body-component{
    height: 100% !important;
    max-height: 100% !important;
    width: 100% !important;
}

mw-connections-myconnections-view .treeNodeData {
    
}

mw-connections-availableconnections-view .treeNodeData {
    
}

