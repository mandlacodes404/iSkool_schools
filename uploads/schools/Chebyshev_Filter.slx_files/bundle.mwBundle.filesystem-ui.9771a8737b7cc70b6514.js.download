}
`,""]),f.exports=g},b38ae27b31cfe3b64199c0cb44a2f9feb38f7528:(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`.mwDialog.DCDDialog {
    min-width: 600px;
    height: auto !important;
}

.mwDialog.DCDDialog > .mwDialogBody {
    overflow-y: hidden;
    padding-bottom: 0px;
}

.DCDFormContainer {
    display: flex;
    flex-direction: column;
    min-width: 500px;
}

.DCDGridContainer {
    display: grid;
    grid-template-rows: auto auto;
    grid-template-columns: max-content auto;
    row-gap: 1rem;
    column-gap: 1rem;
    padding-top: 1rem;
    padding-bottom: 0.7rem;
    align-items: center;
}

.DCDRowContainer {
    display: flex;
    align-items: center;
    flex-direction: row;
    column-gap: 0.5rem;
}

.DCDErrorContainer {
    display: flex;
    flex-wrap: nowrap;
    min-height: 1rem;
}

.DCDErrorIcon {
    margin-right: 5px;
}

.DCDErrorIcon [icon-id='errorAlertRecolorUI'] {
    --mw-icon-object-primary: var(--mw-backgroundColor-primary-error);
    --mw-icon-object-secondary: var(--mw-color-tertiary);
}

.DCDErrorMessage {
    color: var(--mw-color-error);
    font-size: var(--mw-fontSize-m, 12px);
    font-family: var(--mw-fontFamily);
}

.DCDFlexElement {
    flex: 1;
