</div>`},"dojo/text!mw-notifications/templates/ProgressBar.html":f=>{f.exports='<div data-test-id="${data-test-id}" data-value="${value}">\n    <div data-dojo-attach-point="gutterNode" class="${baseClass}Gutter">\n        <div data-dojo-attach-point="progressNode" class="${baseClass}Progress"></div>\n    </div>\n    <div data-dojo-attach-point="progressTextNode" class="${baseClass}Text">50%</div>\n</div>'},"dojo/text!mw-overlay-utils/templates/busyOverlayTemplate.html":f=>{f.exports=`<div class="mw-busyIndicator" data-dojo-attach-point="_busyOverlayNode">
	<div class="underlayNode"  data-dojo-attach-point="_underlayNode"></div>
