		<div class="spinnerNode" data-dojo-attach-point="_spinnerNode" ></div>
	</div>
</div>
`},"dojo/text!addonssidepanel-ui/templates/ApplicationContainer.html":f=>{f.exports=`<iframe class = "iframe-container-within-modal-dialog" src="" data-dojo-attach-point="iframeNode"></iframe>
`},"dojo/text!addonssidepanel-ui/templates/LicenseAgreementContainerWidget.html":f=>{f.exports=`<div data-dojo-attach-point="licenseAgreementContainer" class="licenseAgreementContainer">
    <p data-dojo-attach-point="licenseAgreementTextNode" class="licenseAgreementTextNode"></p>
</div>`},"dojo/text!file_chooser_service_js/template/ValidationDialogWidget.html":f=>{f.exports=`<div class="validationContainer" id="validationContainer" data-dojo-attach-point="containerNode">
    <div id="warningMsg" data-dojo-attach-point="warningMsgNode">
        <div id="iconImg" data-dojo-attach-point="iconNode"></div>
        <div id="message" data-dojo-attach-point="msgNode">
            <div id="firstLine" data-dojo-attach-point="firstLineNode"></div>
            <div id="secondLine" data-dojo-attach-point="secondLineNode"></div>
            <div id="filePathLine" data-dojo-attach-point="filePathLineNode">
                <div id="textLine" data-dojo-attach-point="pathLineTextNode"></div>
                <div id="fileTextField" data-dojo-attach-point="fileNameNode"></div>
                <div id="extension" data-dojo-attach-point="extensionNode"></div>
            </div>
            <div id="messageLine" data-dojo-attach-point="messageLineNode"></div>
        </div>
    </div>
    
    <div id="buttonContainer" data-dojo-attach-point="buttonContainerNode">
        <div id="saveButton" data-dojo-attach-point="saveButtonNode"></div>
        <div id="cancelButton" data-dojo-attach-point="cancelButtonNode"></div>
    </div>
</div>`},"dojo/text!filebrowser_utils-ui/js/actions/preview/previewPopupTemplate.html":f=>{f.exports=`<div class="previewPopup" data-dojo-attach-point="previewNode">
    <div class="header" data-dojo-attach-point="headerNode">
        <div class="fileIcon" data-dojo-attach-point="fileIconNode"></div>
        <div class="title" data-dojo-attach-point="titleNode"></div>
        <div class="upperRightMetadata" data-dojo-attach-point="upperRightMetadataNode"></div>
    </div>
    <div class="body" data-dojo-attach-point="bodyNode">
        <div class="richContent" data-dojo-attach-point="richContentNode"></div>
        <div class="richContentLabel" data-dojo-attach-point="richContentLabelNode"></div>
        <div class="primaryMetadata" data-dojo-attach-point="primaryMetadataNode"></div>
        <div class="secondaryMetadata" data-dojo-attach-point="secondaryMetadataNode"></div>
        <div class="sharingContent" data-dojo-attach-point="sharingContentNode"></div>
    </div>
    <div class="footer" data-dojo-attach-point="footerNode">
        <div class="openButton" data-dojo-attach-point="openButtonNode"></div>
    </div>
</div>`},"dojo/text!filebrowser_utils-ui/js/actions/upload/legacy/LegacyUploadWidgetTemplate.html":f=>{f.exports=`<form data-dojo-attach-point="uploadForm" class="upload"
      method="post"
      enctype="multipart/form-data"
      action="\${_action}"
      target="\${_targetFrame}">
    <!-- Firefox does not respect css width property for input type="file". This is firefox bug which has been
    there since 12years. https://bugzilla.mozilla.org/show_bug.cgi?id=52500. Workaround for this bug is to set the
     size so that the text length is nearer to how the text box looks in IE.-->
    <div class="upload statusText" data-dojo-attach-point="statusText"></div>
    <div class="upload browseFile">
        <input class="upload inputFile" size="29"
               data-dojo-attach-point="fileInput" name="uploadFileName"
               data-dojo-attach-event="onchange:onChangeHandler"
               id="fileToUpload" type="file" multiple/>
    </div>
    <div class="upload errText" data-dojo-attach-point="errorText"></div>
    <div class="upload uploadControls">
        <button class="upload cancelButton"
                data-dojo-attach-point="cancelButton" type="reset"
                data-dojo-attach-event="onclick:onCancel"
                name="\${_localization.cancelLabel}">
            \${_localization.cancelLabel}
        </button>
        <input class="upload uploadButton" data-dojo-attach-point="fileSubmit"
               data-dojo-attach-event="onclick:onUpload" type="button"
               disabled="disabled" value="\${_localization.submitLabel}"/>
    </div>
</form>`},"dojo/text!filechooser-ui/fileChooserNavigationBarTemplate.html":f=>{f.exports=`<div class="fileChooserNavigationBarContainer" data-dojo-attach-point="fileChooserNavigationBarContainer">
</div>`},"dojo/text!filechooser-ui/fileChooserTemplate.html":f=>{f.exports=`<div class="fileChooser2">
    <div class = "fileChooserNavigationBar" data-dojo-attach-point="fileChooserNavigationBarNode">
    </div>
    <div class = "fileBrowser" tabindex="-1" data-dojo-attach-point="fileBrowserNode"></div>
    <div class="bottom" data-dojo-attach-point="bottom">
        <div class="fileNameWithLabel" data-dojo-attach-point="fileNameWithLabelNode">
            <div class="fileNameLabel fileChooserLabels" data-dojo-attach-point="fileNameLabelNode">\${localization.saveAsFileNameLabel}</div>
            <div class="fileName fileChooserFields" data-dojo-attach-point="fileNameNode"></div>
        </div>
        <div class="fileTypeWithLabel" data-dojo-attach-point="fileTypeWithLabelNode">
            <div class="inputLabel fileChooserLabels" data-dojo-attach-point="fileTypeLabelNode">\${localization.saveAsFileDropDownLabel}</div>
            <div class="fileType fileChooserFields" data-dojo-attach-point="fileTypeNode"></div>
        </div>
        <div class="buttons" data-dojo-attach-point="buttons">
            <div class="okButton fileChooserButtons" data-dojo-attach-point="okButtonNode"></div>
            <div class="cancelButton fileChooserButtons" data-dojo-attach-point="cancelButtonNode"></div>
        </div>
    </div>
</div>`},"dojo/text!gotofile/resultItemTemplate.html":f=>{f.exports=`<div class="resultItemContent">
    <div class="resultIcon" data-dojo-attach-point="resultIconNode"></div>
    <div class="filenameNode" data-dojo-attach-point="filenameNode"></div>
    <div class="filePathContainer">
        <span data-dojo-attach-point="filePathNode" dir="ltr"></span>
    </div>
</div>
`},"dojo/text!mldosharing-js/ui/shareDialogTemplate.html":f=>{f.exports=`<div class="shareDialogContainer" data-dojo-attach-point="shareDialogContainer" style="visibility: hidden; z-index: 950; width: 600px; top: calc(50vh - 200px); left: calc(50vw - 300px); position: absolute">
    <iframe id = "mldoIframe" data-dojo-attach-point="shareDialogIFrameContainer" style="width: 600px; height: 100%"></iframe>
</div>`},"dojo/text!MW/layout/templates/Tab.html":f=>{f.exports=`<div class="tab">
    <span class="mwTabHeader" data-dojo-attach-point="headerNode"
    ></span><span class="tabIcon" data-dojo-attach-point="iconNode"
    ></span><span class="mwTabLabel" data-dojo-attach-point="labelNode,containerNode"
    ></span>
    <span class="closeContainer"><span class="busyIndicatorPlaceholder" data-dojo-attach-point="busyIndicatorNode"
    ></span><span class="tabCloseIcon" data-dojo-attach-point="closeNode"
    >
    <mw-icon icon-id="deleteBorderlessUI" icon-width="12" icon-height="12" class="closeIcon"
    ></mw-icon>
    <mw-icon icon-id="errorCrossUI" icon-width="12" icon-height="12" class="crossCloseIcon"
    ></mw-icon>
    </span></span>
</div>
`},"dojo/text!MW/layout/templates/TabPlusButton.html":f=>{f.exports=`<div class="tabPlusButton" role="button">
