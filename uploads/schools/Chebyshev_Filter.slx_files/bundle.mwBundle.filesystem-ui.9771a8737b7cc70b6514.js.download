.git-branchmanager {
    /* Provide default fonts.
     * There are currently no semantic variables for fonts.
     */
    font-family: Helvetica, Arial, sans-serif;
    font-size: 12px;
    color: var(--mw-color-primary);
}

.git-branchmanager a {
    cursor: pointer;
    color: var(--mw-color-hyperlink);
}

.git-branchmanager a:hover {
    color: var(--mw-color-hyperlink-hover);
    text-decoration: underline;
}

.git-branchmanager .emptyList {
    margin: 10px;
    text-align: center;
}`,""]),f.exports=M},"94351c122eddb17692af94a8694f977a25e5f0cc":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=t("mwBundle.filesystem-ui|87e26cd3249100f6a08de246d6f07512f7601eda"),h=t("mwBundle.filesystem-ui|6c7583fd0eb635509533c9608de82672fe005493"),c=t("mwBundle.filesystem-ui|289515e917a2a08a8e006fe9c8f8d0d1e027a077"),d=t("mwBundle.filesystem-ui|a79d21ad7aa7f50661b8a4510bd2e6712044a890"),u=t("mwBundle.filesystem-ui|433895b1be807915480b7aef4a16001343c3f7f2"),a=t("mwBundle.filesystem-ui|e772b67b3ee1428dc06afb7dc0e59cdc589338ea"),r=t("mwBundle.filesystem-ui|8d1e5ce8745b647e01032554a60818cb9b587e2d"),e=C(E);e.i(g),e.i(h),e.i(c),e.i(d),e.i(u),e.i(a),e.i(r),e.push([f.id,`/* Copyright 2021-2024 The MathWorks, Inc. */

