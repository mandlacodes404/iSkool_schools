earchfield/SearchField":(f,S,t)=>{var E,C;E=[t(t.dj.r.absMids["element_core/ElementBase"]),t(t.dj.r.absMids["ui_core_utils/KeyboardKeys"]),t(t.dj.r.absMids["element_core/IconElement"])],C=t.dj.d(E,({ElementBase:g,html:h,css:c},d,u)=>{class a extends g{static get styles(){return c`
                :host {
                    display: inline-block;
                    display: flex;
                    border-radius: 3px;
                    color: var(--mw-color-primary);
                    background-color: var(--mw-backgroundColor-input);
                    border: 1px solid var(--mw-borderColor-primary);
                    padding-left: 5px;
                }

                :host(:focus-within) {
                    border-color: var(--mw-borderColor-focus)
                }

                :host([disabled]) {
                    background-color: var(--mw-backgroundColor-input-readonly);
                }

                #mwIconContainer,
                #mwClearIconContainer {
                    width: 24px;
                    height: 100%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                }

                #mwClearIconContainer {
                    width: 12px;
                }

                #mwIconContainer[disabled] {
                    pointer-events: none;
                }

                #mwSearchInput {
                    color: inherit;
                    display: inline-block;
                    border: none;
                    border-top-right-radius: 3px;
                    border-bottom-right-radius: 3px;
                    flex: 1;
                    box-shadow: none;
                    margin: 0;
                    padding: 0;
                    font-size: inherit;
                    font-style: inherit;
                    background: transparent;
                    min-width: 0;
                }

                ::placeholder {
                    color: var(--mw-color-secondary);
                }

                #mwSearchInput:focus {
