#addOnsPanel .addOnListing {
    min-width: 32px;
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    text-overflow: ellipsis;
    overflow: hidden;
    height: 37px;
}

.addOnListing .imageContainer {
    width: 25px;
    display: flex;
    justify-content: flex-start;
    align-content: center;
    padding-left: 1px;
}

.addOnListing .addOnInfo {
    display: flex;
    align-items: center;
    min-width: 0;
    height: 100%;
    flex-grow: 1;
    font-size: 11px;
}

.addOnListing .mwAddOnInfoContainer {
    overflow: hidden;
    white-space: nowrap;
    padding-left: 2px;
    display: flex;
    flex-direction: column;
}
.addOnListing .addOnName {
    margin-right: 8px;
    text-overflow: ellipsis;
    align-items: center;
    padding-left: 4px;
    padding-bottom: 2px;
    color: var(--mw-color-primary);
    overflow: hidden;
    white-space: nowrap;
}
.addOnListing .authorNode {
    margin-top: -3px;
}

.addOnListing .authorNode,
.addOnListing .summaryNode,
.addOnListing .ribbons {
    padding-left: 4px;
    align-items: center;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}

.addOnListing .authorNode,
.addOnListing .summaryNode {
    margin-right: 8px;
}

.addOnListing .ribbons {
    padding-right: 3px;
}

.addOnListing .popularityAndActionsContainer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 5px;
    height: 100%;
}

.addOnListing .authorNode, .addOnListing .mwAddOnNameAndActionZoneContainer {
    display: flex;
}

.addOnListing .addOnRatingsAndDownloads {
    display: flex;
    justify-content: space-between;
    flex-direction: row;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    padding-right: 0px;
}

.addOnListing .popularityInfoContainer {
    font-size: 11px;
    height: 22px;
    display: flex;
    position: relative;
}

mw-addons-actionzonewidget {
    right: 10px;
}

.addOnListing .downloadsContainer {
    display: flex;
    width: 40px;
}
.addOnListing .summaryNode {
    display: block;
}

.addOnListing .authorNode .authorIcon  {
    width: 16px;
    padding-right: 1px;
}

.addOnListing .authorNode .authorIcon img {
    height: 16px;
    width: 16px;;
}

.addOnListing .authorNode .authorName  {
    text-overflow: ellipsis;
    overflow: hidden;
    line-height: 1.5;
}

.addOnListing .addOnInfo.disabled, .addOnListing .addOnRating.disabled, .addOnListing .ribbons.disabled {
    opacity: 0.5;
}

.addOnListing .addOnIcon,
.addOnListing .addOnIcon img,
.addOnListing .addOnIcon svg {
    height: 24px !important;
    width: 24px !important;
}

.addOnListing .addOnIcon img {
    border: thin solid var(--mw-borderColor-secondary);
    border-radius: 5px;
}

.addOnListing .addOnIcon mw-icon {
    border: thin transparent;
}

/** Style for ratings **/

.addOnListing .addOnRating {
    display: flex;
    width: 28px;
    margin: 0;
    margin-right: 2px;
    margin-left: 5px;
}
  
.addOnListing .addOnRating-upper {
    color: var(--mw-color-primary);
    overflow: hidden;
    font-size: 10px;
    font-style: normal !important;
}

.addOnListing .addOnRating .ratings {
    padding-left: 2px;
    color: var(--mw-color-primary); 
    font-size: 9px;
}

.addOnListing .downloadsIconContainer {
    display: flex;
    padding-top: 1px;
    filter: grayscale(100%);
    fill: var(--mw-color-primary);
}

.addOnListing .downloadsNumber {
    color: var(--mw-color-primary);
    vertical-align: top;
    padding-left: 3px;
    font-size: 9px;
}

.addOnListing .ribbon {
    color: #fff;
    text-align: center;
    font-size: 0.95em;
    padding: 1px 2px;
}

.addOnListing .updateIconContainer {
    filter: grayscale(100%);
    fill: var(--mw-color-primary);
}

.addOnListing .ribbons {
    color: var(--mw-color-primary);
}

.addOnListing .updateLabel, .addOnListing .installedLabel {
    vertical-align: top;
}

.addOnListing .popularityInfoContainer .ribbons {
    width: 68px;
}

.addOnListing .hideNode {
    display: none !important;
}

mw-addons-actionzonewidget .actionButton {
    height: 22px;
    font-size: 10px;
    padding-top: 2px;
    padding-right: 3px;
}

.addOnListing .mwButton {
    border-color: var(--mw-borderColor-secondary);
}

#addOnsPanel .treeNodeData .addOnActionZone,
#addOnsPanel .treeNode .addOnActionZone{
    padding-bottom: 5px;
    font-size: 11px;
    /* height: 22px; */
}

#addOnsPanel .treeNode .addOnsKebabOptionsMenuButton,
#addOnsPanel .treeNode .addOnsSidePanelInstallButton,
#addOnsPanel .treeNode .addOnsSidePanelViewInExplorerButton,
#addOnsPanel .treeNode .addOnsSidePanelUpdateButton,
#addOnsPanel .treeNode .addOnsSidePanelDownloadButton {
    display: none;
}

#addOnsPanel .treeNode:hover .addOnsKebabOptionsMenuButton,
#addOnsPanel .treeNode:hover .addOnsSidePanelInstallButton,
#addOnsPanel .treeNode:hover .addOnsSidePanelViewInExplorerButton,
#addOnsPanel .treeNode:hover .addOnsSidePanelUpdateButton,
#addOnsPanel .treeNode:hover .addOnsSidePanelDownloadButton,
#addOnsPanel .treeNode.selected .addOnsKebabOptionsMenuButton,
#addOnsPanel .treeNode.selected .addOnsSidePanelInstallButton,
#addOnsPanel .treeNode.selected .addOnsSidePanelViewInExplorerButton,
#addOnsPanel .treeNode.selected .addOnsSidePanelUpdateButton,
#addOnsPanel .treeNode.selected .addOnsSidePanelDownloadButton {
    display: inline-block;
}

#addOnsPanel .treeNode:hover .popularityInfoContainer,
#addOnsPanel .treeNode.selected .popularityInfoContainer {
    display: none;
}

#addOnsPanel .installUninstallProgress{
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 4px;
    padding-right: 5px;
}

.addOnListing .busyIndicator{
    display: inline-block;
    vertical-align: middle;
    padding: 0 10px 0 10px;
    position: relative !important;
    width: auto !important;
}

.addOnListing .busyIndicator .underlayNode{
    background:transparent;
}

/* Kebab Menu button */
.addOnListing .addOnsKebabOptionsMenuButton {
    padding-top: 2px;
    padding-right: 3px;
}

.addOnListing .addOnsKebabOptionsMenuButton .mwButton {
    display: block;
    width: 20px;
}

.addOnListing .mwButton:hover, .addOnListing .mwButton:active {
    border: 1px solid  var(--mw-borderColor-primary);
}

#addOnsPanel .customRepositoryPlaceholder {
    min-width: 32px;
    justify-content: space-between;
    overflow: hidden;
}

#addOnsPanel .customRepositoryPlaceholderLabel {
    color: var(--mw-color-secondary);
}

#addOnsPanel .customRepositoryHeader {
    min-width: 32px;
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    text-overflow: ellipsis;
    overflow: hidden;
    height: 24px;
}

.addOnSectionHeader .customRepositoryHeaderLabel {
    font-size: 12px;
}
`,""]),f.exports=g},db4d2a3f3c2f127849cc2321bf74a4e734305a00:(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2022 The MathWorks, Inc. */
.iframe-container-within-modal-dialog {
    height: 100%;
    width: 100%;
}
`,""]),f.exports=g},"705e5e6a87fe1010f1141d17d516c201c8c01d33":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2024 The MathWorks, Inc. */
mw-addons-updatesbanner {
    max-height: 250px;
    overflow-x: hidden;
    overflow-y: auto;
    background: var(--mw-backgroundColor-primary);
}

mw-addons-updatesbanner .notification-banner {
    padding: 0 0 5px 4px;
}


mw-addons-updatesbanner .notification-banner.error {
    background-color: var(--mw-backgroundColor-errorContainer);
}

mw-addons-updatesbanner .notification-banner.warning {
    background-color: var(--mw-backgroundColor-notificationBanner);
}




mw-addons-updatesbanner .notification-banner.with-updates {
    background-color: var(--mw-backgroundColor-announcementBanner);
    border: solid var(--mw-borderColor-info) 1px;
}

mw-addons-updatesbanner .notification-banner.no-updates {
    background-color: var(--mw-backgroundColor-secondary-success);
    border: solid var(--mw-borderColor-success) 1px;
}



mw-addons-updatesbanner .notification-banner .notification-banner-header {
    position: sticky;
    top: 0;
    padding-top: 5px;
    align-items: center;
    background-color: inherit;
    display: grid;
    grid-template-columns: 22px 1fr 25px;
    padding-left: 3px;
}


mw-addons-updatesbanner .notification-banner.error .notification-banner-header {
    box-shadow: 0 6px 3px -3px var(--mw-backgroundColor-errorContainer);
}

mw-addons-updatesbanner .notification-banner.warning .notification-banner-header { 
    box-shadow: 0 6px 3px -3px var(--mw-backgroundColor-notificationBanner);
}

mw-addons-updatesbanner .notification-banner-header #notification-banner-label {
    overflow: hidden;
}

mw-addons-updatesbanner .notification-banner-header #notification-banner-label h1 {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    user-select: text;
    -webkit-user-select: text;
    padding: 3px 0 3px 0;
}

mw-addons-updatesbanner .notification-banner-header #notification-banner-label .header-text {
    cursor: text;
}

mw-addons-updatesbanner .notification-banner .notification-banner-header mw-button[name="dismissCheckForUpdatesBannerButton"] {
    margin-right: 3px;
}`,""]),f.exports=g},"1ce4849880acc73f8cbe74e1755100c582d8f55d":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2022-2024 The MathWorks, Inc. */
.modal-installer-dialog .mwDialogTitleBar {
    border-bottom: 0px;
}

.modal-installer-dialog .mwDialogBody {
    overflow-x: hidden !important;
    overflow-y: hidden !important;
    padding: 0px !important;   /* Override since Installer dialog should not have a scroll-bar*/
    height: calc(100% - 31px) !important;
}

.modal-installer-dialog .iframe-container-within-modal-dialog {
    border-radius: 5px;
    overflow: hidden;
}
`,""]),f.exports=g},"0f96a1e1973907e6b3a5730753a876c5d1f90477":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2022 The MathWorks, Inc. */
.modal-license-agreement-dialog {
    z-index: 950;
    width: 550px;
    height: 501px;
}

.modal-license-agreement-dialog .mwDialogBody {
    min-height: 120px;
    overflow: auto;
}

.modal-license-agreement-dialog .iframe-container-within-modal-dialog {
    width: 100%;
    height: 324px;
    font-size: 12px;
    overflow: auto;
}

.modal-license-agreement-dialog .mwDialogBody, .modal-license-agreement-dialog .mwDialogButtonBar {
    background-color: var(--mw-backgroundColor-tertiary);
}`,""]),f.exports=g},"8bee79a4580e10b7154b3326f9c9ae831c2b26ca":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2023-2024 The MathWorks, Inc. */
/* Define CSS variables for repeated values */
:root {
    --white-color: #fff;
    --button-bg-color: rgb(192, 87, 8);
    --button-font-size: 12px;
}

.addOnsSidePanelHeaderContainer .newGRBannerContainer {
    box-shadow: none;
    background: url("/toolbox/matlab/addons/release/images/matlab_upgrade_background_image.jpeg") no-repeat right top;
    color: var(--white-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: inherit;
}

.addOnsSidePanelHeaderContainer .newGRBannerContainer .upgradeText {
    margin: 10px 0;
    font-weight: normal;
    font-size: 14px;
}

.addOnsSidePanelHeaderContainer .newGRBannerContainer .upgradeButton {
    --mw-boxShadow-button: none;
    --mw-backgroundColor-button: var(--button-bg-color);
    --mw-color-button: var(--white-color);
    --mw-border-button: 1px solid var(--button-bg-color);
    margin-bottom: 10px;
    --mw-fontSize-button: var(--button-font-size);
    --mw-cursor-button: pointer;
}

.addOnsSidePanelHeaderContainer .newGRBannerContainer .upgradeButton:hover {
    filter: brightness(115%);
    --mw-color-button: var(--mw-color-primary);
}

.addOnsSidePanelHeaderContainer .newGRBannerContainer .upgradeButton:focus {
    --mw-outline-button: none;
}

.addOnsSidePanelHeaderContainer .newGRBannerContainer .removeNewGRBannerButton {
    position: absolute;
    top: 5px;
    right: 5px;
}

.addOnsSidePanelHeaderContainer .newGRBannerContainer .removeNewGRBannerButton,
.addOnsSidePanelHeaderContainer .newGRBannerContainer .removeNewGRBannerButton:hover {
    background: none;
    border: none;
    font-size: var(--button-font-size);
    cursor: pointer;
    color: var(--white-color);
}
`,""]),f.exports=g},"46bf654df60cd25d83ad6291db7b65a2ae9946a8":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2024 The MathWorks, Inc. */

mw-addons-welcome-popout {
    overflow-x: hidden;
    overflow-y: auto;
    background: var(--mw-backgroundColor-primary);
}
mw-addons-welcome-popout .mw-popout-container {
    display: flex;
    flex-direction: column;
    overflow: visible;
    max-height: 100%;
}


mw-addons-welcome-popout .tippy-box {
    overflow: visible;
    max-width: 100%;
    max-height: 100%;
}

mw-addons-welcome-popout .welcomePopoutContent {
    display: flex;
    align-items: center;
    padding: 5px;
}

mw-addons-welcome-popout .welcomePopoutContent mw-icon {
    padding: 3px;
    margin-right: 10px;
}

mw-addons-welcome-popout .welcomePopoutContent #welcome-popout-label {
    display: flex;
    flex-direction: column;
}

mw-addons-welcome-popout .welcomePopoutContent #welcome-popout-label .header-text {
    cursor: text;
    margin-bottom: 10px !important;
    display: block;
}

mw-addons-welcome-popout .welcomePopoutContent #welcome-popout-label .no-show-text {
    display: flex;
    align-items: center;
}`,""]),f.exports=g},"22d4d1eba48588ee2921d2cfa2aec03ee0d1eb57":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=t("mwBundle.filesystem-ui|b1072482398147ce169c1a442bb9656ca8f8950f"),h=t("mwBundle.filesystem-ui|a859cb0b324e1159cd2f4e891da37958167e2767"),c=t("mwBundle.filesystem-ui|db4d2a3f3c2f127849cc2321bf74a4e734305a00"),d=t("mwBundle.filesystem-ui|1ce4849880acc73f8cbe74e1755100c582d8f55d"),u=t("mwBundle.filesystem-ui|0f96a1e1973907e6b3a5730753a876c5d1f90477"),a=t("mwBundle.filesystem-ui|8bee79a4580e10b7154b3326f9c9ae831c2b26ca"),r=t("mwBundle.filesystem-ui|705e5e6a87fe1010f1141d17d516c201c8c01d33"),e=t("mwBundle.filesystem-ui|46bf654df60cd25d83ad6291db7b65a2ae9946a8"),o=C(E);o.i(g),o.i(h),o.i(c),o.i(d),o.i(u),o.i(a),o.i(r),o.i(e),o.push([f.id,"/* Copyright 2025 The MathWorks, Inc. */",""]),f.exports=o},a859cb0b324e1159cd2f4e891da37958167e2767:(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2022-2025 The MathWorks, Inc. */

#addOnsPanel {
    overflow: hidden;
}

#addOnsPanel mw-fsui-subpanel {
    overflow: hidden;
}

#addOnsPanel .mw-treeNode-renderer-container {
    width: 100%;
}

#addOnsPanel .hideDomNode {
    display: none !important;
}

#addOnsPanel .addOnsSearch {
    display: flex;
    align-items: center;
}

#addOnsPanel .addOnsSearchTextField {
    height: 24px;
    display: flex;
    padding: 5px;
    flex-grow: 1;
}

#addOnsPanel .addOnsSearch mw-button {
    padding: 2px;
}

#addOnsPanel .addOnsSearch mw-button button {
    padding: 2px 2px 0 2px;
}

#addOnsPanel .addOnsView {
    height: 100%;
    display: flex;
    align-items: stretch;
    flex-direction: column;
}

#addOnsPanel .tree {
    max-width: 100%;
}

#addOnsPanel .mwSearchTextField {
    width: 100%;
}

#addOnsPanel .MLUpdateIcon {
    padding: 0px 1px;
}

#addOnsPanel .parentNode {
    margin-left: 0px !important;
}

#addOnsPanel .parentNode .treeNodeData {
    margin-left: 10px !important;
}

#addOnsPanel mw-addons-installedsection,
#addOnsPanel mw-addons-customrepositorysection,
#addOnsPanel mw-addons-recommendedsection,
#addOnsPanel mw-addons-searchresultssection,
#addOnsPanel .dijitTitlePaneContentOuter,
#addOnsPanel .dijitReset,
#addOnsPanel .dijitTitlePaneContentInner,
#addOnsPanel mw-addons-installedsection .mw-tree.treeContainer,
#addOnsPanel mw-addons-customrepositorysection .mw-tree.treeContainer,
#addOnsPanel mw-addons-recommendedsection .mw-tree.treeContainer,
#addOnsPanel mw-addons-searchresultssection .mw-tree.treeContainer  {
    height: 100%;
    overflow-y: hidden;
}

#addOnsPanel mw-addons-searchresultssection,
#addOnsPanel mw-addons-installedsection {
    /* Take up all available space */
    flex: 1;
}

#addOnsPanel .addOnsTextMessage{
    color: var(--mw-color-secondary);
}

#addOnsPanel mw-addons-recommendedsection,
#addOnsPanel mw-addons-installedsection,
#addOnsPanel mw-addons-customrepositorysection,
#addOnsPanel mw-addons-searchresultssection {
    display: flex;
    flex-direction: column;
    position: relative;
}

#addOnsPanel .addons-treeContainer{
    display: flex;
    flex-direction: column;
    flex: 1;
    height: 100%;
    overflow-y: hidden;
}

#addOnsPanel .viewMoreNode {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    background: var(--mw-backgroundColor-primary);
    margin: 4px;
}

#addOnsPanel .viewMoreExternalLink {
    cursor: pointer;
    color: var(--mw-color-hyperlink);
    font-size: 12px;
    user-select: none;
}
#addOnsPanel .viewMoreNode .viewMoreExternalLink:hover,
#addOnsPanel .viewMoreNode .viewMoreExternalLink:focus {
    text-decoration: underline;
}

#addOnsPanel .mw-tree-scroll-component{
    overflow-x:hidden;
}

#addOnsPanel .dijitTitlePaneFocused .dijitTitlePaneTitleFocus:focus .dijitTitlePaneTextNode {
    text-decoration: underline;
}

/* Filter Panel*/

.addOnsSidePanelFilterContent{
    display: flex;
    flex-direction: column;
    overflow:auto;
}

.addOnsSidePanelFilterContent .filterSubsection{
    display: flex;
    flex-direction: column;
    overflow: auto;
    margin: 2px;
}
.addOnsSidePanelFilterContent .filterSubsection mw-label {
    margin-left: 3px;
}

.addOnsSidePanelFilterContent .filterSubsection mw-checkbox {
    margin-top: 4px;
    margin-left: 10px;
}

.addons-section-message-container {
    display: flex;
    flex-direction: column;
    text-align: center;
    flex: 1; /* We want this to take up all available space so that viewModeNode is forced to the bottom of the section */
    margin: 2px 0;
}

.search-results-message-container #addons-search-section-inline-viewmore {
    position: unset;
    bottom: unset;
    border: 0;
}

#addOnsPanel .hyperlink {
    color: var(--mw-color-hyperlink);
    cursor: pointer;
}

#addOnsPanel .addOnsSearchFilterButton {
    --mw-borderBottomWidth-button: 1px;
    --mw-borderTopWidth-button: 1px;
    --mw-borderRightWidth-button: 1px;
    --mw-borderLeftWidth-button: 1px;
    --mw-borderColor-button: transparent;
    --mw-cursor-button: pointer;
    --mw-focussedBorderColor-button: var(--mw-borderColor-focus);
    --mw-hoverBorderColor-button: var(--mw-borderColor-hover);
}

/* Do not display sub-panel header for search results section*/
#addOnsPanel #search-results .dijitTitlePaneTitle {
    display: none !important;
}
`,""]),f.exports=g},"0c99a79745f4f3391e0caba8b437dcfaa3cf842c":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2023-2024 The MathWorks, Inc. */
.connectionListing .connectionInfo {
    display: flex;
    align-items: center;
    min-width: 0;
    height: 100%;
    width: 100%;
    overflow: hidden;
}

.connectionListing .mwConnectionInfoContainer {
    overflow: hidden;
    min-width: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.connectionListing .connectionName {
    margin-right: 8px;
    line-height: 20px;
    text-overflow: ellipsis;
    align-items: center;
    padding-left: 4px;
    padding-bottom: 2px;
    color: var(--mw-color-primary);
    overflow: hidden;
    white-space: nowrap;
}

.connectionListing .authorNode,  .connectionListing .summaryNode, .connectionListing .connectionRatingsAndDownloads, .connectionListing .ribbons {
    padding-left: 4px;
    padding-top: 4px;
    margin-right: 8px;
    align-items: center;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}

.connectionListing .authorAndPopularityInfoContainer, .connectionListing .authorNode, .connectionListing .connectionRatingsAndDownloads, .connectionListing .mwconnectionNameAndActionZoneContainer {
    display: flex;
}

.connectionListing .downloadsContainer {
    padding-top: 4px;
}
.connectionListing .summaryNode {
    display: block;
}

.connectionListing .authorNode .authorIcon  {
    width: 16px;
    padding-right: 3px;
}

.connectionListing .connectionInfo.disabled {
    font-style: italic;
    opacity: 0.5;
}

.connectionListing .connectionIcon .mwIconNode {
    height: 27px !important;
    width: 36px !important;
    background-size: 36px 27px;
    background-repeat: no-repeat;
    border: thin solid var(--mw-borderColor-secondary);
}


.connectionListing .installed-ribbon {
    position: absolute;
    height: 15px;
    width: 60px;
    background: green;  /* Use the same color as used by Explorer */
    color: #fff;
    text-align:center;
    font-size: 0.95em;
    padding-top: 2px;
    border-radius: 4px;
  }

.connectionListing .hideNode {
    display: none;
}

.connectionListing .connectionsPanelAddButton {
    --mw-paddingTop-button: 2px;
    --mw-paddingBottom-button: 2px;
    --mw-marginLeft-button: 5px;
    --mw-marginRight-button: 5px;
    width: 60px;
    height: 22px;
}

.connectionListing .kebabMenuButton {
    width: 26px;
    height: 23px;
}

mw-connections-availableconnections-view .connectionListing .mwconnectionActionsContainer,
mw-connections-myconnections-view .connectionListing .mwconnectionActionsContainer {
    display: none;
}

mw-connections-availableconnections-view .treeNodeData:hover .connectionListing .mwconnectionActionsContainer,
mw-connections-availableconnections-view .treeNodeData.selected .connectionListing .mwconnectionActionsContainer,
mw-connections-availableconnections-view .treeNode.selected .connectionListing .mwconnectionActionsContainer {
    display: block;
}

#connectionsPanel .treeNode .kebabMenuButton {
    display: none;
}

#connectionsPanel .treeNode.hover .kebabMenuButton,
#connectionsPanel .treeNode.selected .kebabMenuButton {
    display: inline-block;
}

.connectionListing .actionButton {
    display: inline-block;
    padding: 0 10px 0 10px;
    vertical-align: middle;
}

#connectionsPanel .treeNodeData:hover .actionButton,
#connectionsPanel .treeNode.selected .actionButton{
    visibility: visible;
}

#connectionsPanel .connectionsSidePanelInstallButton:hover {
    cursor: pointer;
}

#connectionsPanel .installUninstallProgress{
    display: flex;
    justify-content: center;
    align-items: center;
}

#connectionsPanel .busyIndicator .underlayNode{
    background:transparent;
}

#connectionsPanel .busyIndicator{
    display: inline-block;
    vertical-align: middle;
    padding: 0 10px 0 10px;
    position: relative !important;
    width: auto !important;
}

.connectionListing .mwHideConnectionNode {
    display: none !important;
}
