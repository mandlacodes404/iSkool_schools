.git-branchmanager-commitdetails-contentpane > mw-git-branchmanager-commitdetails {
    padding: 10px;
}

mw-git-branchmanager-commitdetails {
    display: flex;
    flex-direction: column;
}

mw-git-branchmanager-commitdetails a {
    cursor: pointer;
    color: var(--mw-color-hyperlink);
}

mw-git-branchmanager-commitdetails a:hover {
    color: var(--mw-color-hyperlink-hover);
    text-decoration: underline;
}

mw-git-branchmanager-commitdetails .git-commitdetails-grid {
    display: grid;
    row-gap: 10px;
    column-gap: 10px;
    grid-template-columns: auto 1fr;
    align-items: flex-start;
}

mw-git-branchmanager-commitdetails .git-commitdetails-flexauthor {
    display: flex;
    align-items: flex-start;
    flex-direction: row;
}

mw-git-branchmanager-commitdetails .git-commitdetails-col1 {
    grid-column: 1;
    font-weight: bold;
    margin-right: 2px;
    user-select: none;
    white-space: nowrap;
}

mw-git-branchmanager-commitdetails .git-commitdetails-avatar {
    height: 40px;
    width: 40px;
    margin-right: 10px;
}

mw-git-branchmanager-commitdetails .git-commitdetails-flexauthor-nameemail {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

mw-git-branchmanager-commitdetails .git-commitdetails-flexauthor-name {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

mw-git-branchmanager-commitdetails .git-commitdetails-col2 {
    grid-column: 2;
    align-self: center;
    white-space: nowrap;
}

mw-git-branchmanager-commitdetails .git-commitdetails-message {
    white-space: pre-wrap;
    margin-top: 20px;
}

mw-git-branchmanager-commitdetails .git-commitdetails-author,
mw-git-branchmanager-commitdetails .git-commitdetails-id {
    display: flex;
    align-items: flex-start;
    gap: 5px;
}

mw-git-branchmanager-commitdetails .git-commitdetails-verified {
    height: 16px;
    width: 16px;
}

mw-git-branchmanager-commitdetails .git-commitdetails-copyicon {
    cursor: pointer;
}

mw-git-branchmanager-commitdetails .git-commitdetails-referenceslist {
}

mw-git-branchmanager-commitdetails .git-commitdetails-referenceslist :not(:last-child) {
    margin-right: 3px;
}

mw-git-branchmanager-commitdetails img {
    border-radius: 50%;
}

`,""]),f.exports=g},"3d44ac431d4643d6deab9726da12ead9dab959b9":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2022-2023 The MathWorks, Inc. */

mw-git-branchmanager-commitgraph .mw-table-component .mw-table-cell-background {
    /* Override the mw-table background to be transparent. The reason for this is that the table
     * is 'read-only' and so it gets a grey background. Our design does not want this (the use of
     * table could be viewed as an implementation detail of the commit graph). */
    background-color: rgba(0, 0, 0, 0);
}

mw-git-branchmanager-commitgraph .mw-table-component .mw-table-outer-wrapper,
mw-git-branchmanager-commitgraph .mw-table-component .mw-table-outer-wrapper-blurred {
    /* Override the border of mw-table, as it makes the commit graph border look thicker
     * than all the borders of the other panes. */
    border: 0;
}

mw-git-branchmanager-commitgraph .git-commitgraph-branch-cell {
    display: flex;
    height: 100%;
}

mw-git-branchmanager-commitgraph .git-commitgraph-author-cell {
    display: flex;
    gap: 10px;
    height: 100%;
    width: 100%;
}

mw-git-branchmanager-commitgraph .git-commitgraph-author-cell svg {
    flex: 0 0 16px;
}

mw-git-branchmanager-commitgraph .git-commitgraph-author-cell img {
    border-radius: 50%;
    flex: 0 0 16px;
}

mw-git-branchmanager-commitgraph .git-commitgraph-branch-cell :not(:last-child) {
    margin-right: 3px;
}

mw-git-branchmanager-commitgraph .git-commitgraph-contentwrapper {
    display: flex;
    height: 100%;
    flex-direction: column;
}

mw-git-branchmanager-commitgraph .git-commitgraph-commitlist-contentwrapper {
    /**
     * https://stackoverflow.com/questions/42130384/why-should-i-specify-height-0-even-if-i-specified-flex-basis-0-in-css3-flexbox
     */
    min-height: 0;
    flex: 1 0 0;
}

mw-git-branchmanager-commitgraphfilter .git-commitgraph-filterlist {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 3px;
    padding: 5px;
    border-bottom: 1px solid var(--mw-borderColor-nonActiveSection);
    background-color: var(--mw-backgroundColor-primary);
}

mw-git-branchmanager-commitgraphfilter .filterButton * {
    cursor: pointer;
}

mw-git-branchmanager-commitgraphfilter .filterButton:hover * {
    text-decoration: line-through;
}

mw-git-branchmanager-commitgraph .git-commitgraph-noheadmessage {
    margin: 10px;
    text-align: center;
}
`,""]),f.exports=g},"65853fe2dfc92dd301e0ff46d5d4e2088d1647da":(f,S,t)=>{var E=t("mwBundle.filesystem-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),C=t("mwBundle.filesystem-ui|cb47172937e548a863ab648aecddd4b09386a96d"),g=C(E);g.push([f.id,`/* Copyright 2022 The MathWorks, Inc. */

/**
 * For the rails graph to appear as we want, the padding and border of the table cell needs to be
 * removed.
 */
mw-git-branchmanager-commitgraph .mw-table-cell[data-col="0"] {
    padding: 0 !important;
    border: none !important;
}

mw-git-branchmanager-commitgraph .git-commitgraph-rail-cell {
    height: 100%;
    width: 100%;
}

mw-git-branchmanager-commitgraph {
    --rail-color-filtered: var(--mw-color-code);
    --rail-color-1: var(--mw-color-matlabKeyword);
    --rail-color-2: var(--mw-color-matlabComment);
    --rail-color-3: var(--mw-color-matlabSystemCommands);
    --rail-color-4: var(--mw-color-matlabWarning);
    --rail-color-5: var(--mw-color-matlabErrors);
    --rail-color-6: var(--mw-color-matlabString);
    --rail-color-7: var(--mw-color-matlabCharacters);
}

mw-git-branchmanager-commitgraph .git-rail-line {
    stroke-width: 2;
    fill: none;
}

/**
 * Styling for a sibling div to the SVG element that displays the rail graph.
 * Position it over the SVG and apply a linear opacity gradient from the right to the left.
 * The colour matches the mw-table cell background color.
 */
mw-git-branchmanager-commitgraph .git-rail-opacity-gradient {
    background: linear-gradient(
        to left,
        var(--mw-backgroundColor-input) 0px,
        rgba(0, 0, 0 ,0) 20px
    );
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 100%;
    width: 100%;
}

mw-git-branchmanager-commitgraph .git-rail-stroke-column-filtered {
    stroke: var(--rail-color-filtered);
}

mw-git-branchmanager-commitgraph .git-rail-stroke-column-1 {
    stroke: var(--rail-color-1);
}

mw-git-branchmanager-commitgraph .git-rail-stroke-column-2 {
    stroke: var(--rail-color-2);
}

mw-git-branchmanager-commitgraph .git-rail-stroke-column-3 {
    stroke: var(--rail-color-3);
}

mw-git-branchmanager-commitgraph .git-rail-stroke-column-4 {
    stroke: var(--rail-color-4);
}

mw-git-branchmanager-commitgraph .git-rail-stroke-column-5 {
    stroke: var(--rail-color-5);
}

mw-git-branchmanager-commitgraph .git-rail-stroke-column-6 {
    stroke: var(--rail-color-6);
}

mw-git-branchmanager-commitgraph .git-rail-stroke-column-7 {
    stroke: var(--rail-color-7);
}

mw-git-branchmanager-commitgraph .git-rail-fill-column-1 {
    fill: var(--rail-color-1);
}

mw-git-branchmanager-commitgraph .git-rail-fill-column-2 {
    fill: var(--rail-color-2);
}

mw-git-branchmanager-commitgraph .git-rail-fill-column-3 {
    fill: var(--rail-color-3);
}

mw-git-branchmanager-commitgraph .git-rail-fill-column-4 {
    fill: var(--rail-color-4);
}

mw-git-branchmanager-commitgraph .git-rail-fill-column-5 {
    fill: var(--rail-color-5);
}

mw-git-branchmanager-commitgraph .git-rail-fill-column-6 {
    fill: var(--rail-color-6);
}

mw-git-branchmanager-commitgraph .git-rail-fill-column-7 {
    fill: var(--rail-color-7);
}
