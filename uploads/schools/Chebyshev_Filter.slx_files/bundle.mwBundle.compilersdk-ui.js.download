.leftColumn {
    width: 100% !important;
}
.uiSectionDevAndTest
{
    margin: 10px;
    padding: 10px;
}

.uiSection > .devAndTestLogTable{
    padding: 0%;
}

/** ------------------------Server log widget------------------------ **/
.devAndTestLogTableData
{
    /* margin-left: 10px; */
    /* margin-right: 10px; */
    text-align: left;
    font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
    font-weight: normal;
    overflow: auto;
    overflow-x: hidden;
    font-size: 12px;
    background-color: var(--mw-backgroundColor-primary);
    color: var(--mw-color-primary);
    transition: all .5s linear;
    /* transition-delay: 1s; */
}

.devAndTestLogTableData[toggle='true']{
    height: 200px;
    margin-bottom: 4px;
    border: solid var(--mw-borderColor-primary) 1px;
}

.devAndTestLogTableData[toggle='false']{
    height: 0px;
    border: none;
    margin: 0%;
}

.devAndTestLogTablePlaceHolder[toggle='true']{
    display: block;
    margin-bottom: 4px;
}

.devAndTestLogTablePlaceHolder[toggle='false']{
    display: none;
}

.devAndTestLogButton
{
   margin-bottom: 4px;
   float: right;
   cursor: pointer;
}

/** ------------------------SERVER ADDRESS WIDGET------------------------ **/
.devAndTestAddressWidget{
    margin-left: 10px;
    margin-right: 10px;
    margin-top: 5px;
    font-size: 12px;
    color: var(--mw-color-primary);
}

.devAndTestFunctionAddressSuffix{
    font-weight: bold;
    margin-right: 5px;
}

.devAndTestMainAddress{
    font-weight: bold;
    word-break: break-all;
    /*line height is 18 to comfortably clear the copy icon (16x16)*/
    line-height: 18px;
}

.devAndTestAddress{
    border: 1px solid var(--mw-borderColor-secondary);
    background-color: var(--mw-backgroundColor-secondary);
    padding: 5px;
    width: 100%;
}

.devAndTestFunctionAddresses{
    text-align: left;
    word-wrap: break-word;
    /* direction: rtl; */
}

.devAndTestFunctionAddresses div{
    padding-bottom: 5px;
}

.lastDiv {
    padding-bottom: 0px !important;
}

.devAndTestAddressDesc{
    margin-bottom: 4px;
}

.devAndTestFunctionAddressesDesc{
    margin-top: 10px;
}


/** ------------------------REQUEST TABLE------------------------ **/
.deploymentRequestSection{
    height: auto;
}

.deploymentRequestViewport[state = 'initial']
{
    display: block;
    width: 100%;
}

.deploymentRequestViewport[state = 'final']
{
    position: relative;
    height: auto;
    width: 100%;
    display: block;
}

.devAndTestRequestTablePlaceHolder[toggle = 'true']
{
    text-align: center;
    height: 92%;
    max-height: 92%;
    display: block;
}

.devAndTestRequestTablePlaceHolder[toggle = 'false']
{
    display: none;
}

.deploymentRequestTable[state = 'initial']
{
    display: none;
}

.deploymentRequestTable[state = 'request']
{
    display: block;
}

.deploymentRequestTable[state = 'final']
{
    display: block;
    margin-bottom: 5px;
}

/*
mw table does not honor auto height with a max-height
it just keeps growing past the max
Therefore we will use a definite height all the time
THis looks less good when table is not at least the max size
*/
.deploymentRequestTableWidget{
    height: 160px;
}

.deploymentUivContent{  
    /* just a guess as to what looks good, 
    todo see if we can set height more programatically based on content
    todo allow scrolling when content is long
    */
    height: 100px; 
    display: block;
    /* position: absolute; */
}

.deploymentDetailsSubSectionContent{
    border-bottom: var(--mw-borderColor-secondary) 1px solid;
    border-right: var(--mw-borderColor-secondary) 1px solid;
    border-left: var(--mw-borderColor-secondary) 1px solid;
}

.deploymentDetailsSubSectionTitle{
    text-align: center;
    font-weight: bold;
    background-color: var(--mw-backgroundColor-secondary);
    color: var(--mw-color-secondary);
}

.uivArea[toggle = 'false']{
    display: none;
    /* width: 100%; */
}

.devAndTestPlaceHolder{
    color: var(--mw-color-secondary);
}

.deploymentErrorDetails{
    color: var(--mw-color-error);
    font-weight: bold;
    text-align: center;
    padding: 5px;
    word-wrap: break-word;
}

.deploymentDetailsSubSection[toggle='false']{
    display: none;
    position: relative;
}

.deploymentDetailsSubSection[toggle='true']{
    display: block;
    position: relative;
    margin-top: 10px;
    margin-bottom: 10px;
    display: block;
}

.uivArea[toggle = 'true']{
    width: 100%;
    display: block;
    position: relative;
}

.deploymentClearRequestsButton[toggle='false']{
    display: none;
}
.deploymentClearRequestsButton[toggle='true']{
    display: block;
}

#devandtest_ui
{
    width: 100vw;
    height: 100vh;
} 

.tooltip
{
    opacity: 0;
    transition: opacity 3s;
}`,""]),d.exports=p},"1e301acd8334c790847e0ca57062115a0d2edc6d":(d,v,t)=>{var C=t("mwBundle.compilersdk-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),m=t("mwBundle.compilersdk-ui|cb47172937e548a863ab648aecddd4b09386a96d"),p=t("mwBundle.compilersdk-ui|7cf3a595224c0105c31194755781c40a093d197a"),f=m(C);f.i(p),f.push([d.id,"",""]),d.exports=f},"7cf3a595224c0105c31194755781c40a093d197a":(d,v,t)=>{var C=t("mwBundle.compilersdk-ui|b1b29db21f5608ccc260facbd0f66f378c18cc6e"),m=t("mwBundle.compilersdk-ui|cb47172937e548a863ab648aecddd4b09386a96d"),p=m(C);p.push([d.id,`/* Copyright 2022 The MathWorks, Inc. */

