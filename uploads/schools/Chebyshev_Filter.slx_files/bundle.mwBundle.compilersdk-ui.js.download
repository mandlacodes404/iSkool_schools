	<div class="dijitTooltipContainer" role="presentation">
		<div data-dojo-attach-point="contentsNode" class="dijitTooltipContents dijitTooltipFocusNode">
			<div data-dojo-attach-point="containerNode"></div>
			\${!actionBarTemplate}
		</div>
	</div>
	<div class="dijitTooltipConnector" role="presentation" data-dojo-attach-point="connectorNode"></div>
</div>
`},"dojo/text!mw-form/templates/CheckBoxRadioButtonMenuItem.html":d=>{d.exports=`<div data-dojo-attach-point="focusNode" aria-checked="false"
    ><div class="mwTextAndDescriptionContainerNode" data-dojo-attach-point="textAndDescriptionContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
        ><div data-dojo-attach-point="descriptionNode" class='mwDescriptionNode'></div
    ></div
    ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
    ><div class="mwOverlayNode"></div
></div>
`},"dojo/text!mw-form/templates/DropDownButton.html":d=>{d.exports=`<div data-dojo-attach-point="contentWrapperNode" class="mwContentWrapperNode"
    ><div data-dojo-attach-point="focusNode" class="mwFocusNode"  role="button" aria-haspopup="true"
          aria-expanded="false"
        ><div data-dojo-attach-point="buttonNode" class="mwButtonNode"
            ><div data-dojo-attach-point="buttonAlignmentNode" class="mwButtonAlignmentNode"></div
            ><div data-dojo-attach-point="buttonContainerNode" class="mwButtonContainerNode"
                ><div data-dojo-attach-point="iconNode" class="mwIconNode"></div
                ><div data-dojo-attach-point="textNode" class="mwTextNode mwBlockTextNode"
                    ><div data-dojo-attach-point="textLine" class="mwTextContentNode"></div
                ></div
            ></div
        ></div
        ><div data-dojo-attach-point="dropDownNode" class="mwDropDownNode"
            ><div data-dojo-attach-point="dropDownAlignmentNode" class="mwDropDownAlignmentNode"></div
            ><div data-dojo-attach-point="dropDownContainerNode" class="mwDropDownContainerNode"
                ><div data-dojo-attach-point="inlineTextNode" class="mwTextNode mwInlineTextNode"
                    ><div data-dojo-attach-point="inlineTextLine" class="mwTextContentNode"></div
                ></div
                ><div data-dojo-attach-point="arrowNode" class="mwArrowNode"
                    ><div data-dojo-attach-point="lastTextLineNode" class="mwLastTextLineNode"
                        ><div data-dojo-attach-point="lastTextLine" class="mwTextContentNode"></div
                    ></div
                    ><div data-dojo-attach-point="arrowIconNode" class="mwArrowIconNode"></div
                ></div
            ></div
        ></div
    ></div
></div>`},"dojo/text!mw-form/templates/ListBox.html":d=>{d.exports='<div data-dojo-attach-point="focusNode"><ul data-dojo-attach-point="containerNode"></ul></div>'},"dojo/text!mw-form/templates/MenuSeparator.html":d=>{d.exports=`<div data-refuse-key-nav="true"></div>
`},"dojo/text!mw-form/templates/PopupMenuItem.html":d=>{d.exports=`<div data-dojo-attach-point="focusNode" class="mwFocusNode" role="menuitem" aria-haspopup="true" aria-expanded="false"
    ><div class="mwIconNode" data-dojo-attach-point="iconNode"></div
    ><div class="mwTextAndDescriptionContainerNode" data-dojo-attach-point="textAndDescriptionContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
        ><div data-dojo-attach-point="descriptionNode" class='mwDescriptionNode'></div
    ></div
    ><div class="mwShortcutAndArrowWrapperNode"
        ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
        ><div class="mwMenuArrowNode"  data-dojo-attach-point="menuArrowNode"></div
    ></div
></div>
`},"dojo/text!mw-navigationbar/templates/navigationBar.html":d=>{d.exports=`<div class="navigationBarContainer" data-dojo-attach-point="navigationBarContainer">
    <div data-dojo-attach-point="navigationBarNode" class="navigationBarNode">
        <div class="locationNodeWithIcon" data-dojo-attach-point="locationNodeWithIcon">
            <div class="iconParentDiv" title="">
                <div class="navBarIcon" data-dojo-attach-point="iconNode"></div>
            </div>
            <div class="currentLocationNode" data-dojo-attach-point="currentLocationNode" data-tag=""></div>
        </div>
    </div>
</div>`},"dojo/text!mw-notifications/templates/ProgressBar.html":d=>{d.exports='<div data-test-id="${data-test-id}" data-value="${value}">\n    <div data-dojo-attach-point="gutterNode" class="${baseClass}Gutter">\n        <div data-dojo-attach-point="progressNode" class="${baseClass}Progress"></div>\n    </div>\n    <div data-dojo-attach-point="progressTextNode" class="${baseClass}Text">50%</div>\n</div>'},"dojo/text!file_chooser_service_js/template/ValidationDialogWidget.html":d=>{d.exports=`<div class="validationContainer" id="validationContainer" data-dojo-attach-point="containerNode">
    <div id="warningMsg" data-dojo-attach-point="warningMsgNode">
        <div id="iconImg" data-dojo-attach-point="iconNode"></div>
        <div id="message" data-dojo-attach-point="msgNode">
            <div id="firstLine" data-dojo-attach-point="firstLineNode"></div>
            <div id="secondLine" data-dojo-attach-point="secondLineNode"></div>
            <div id="filePathLine" data-dojo-attach-point="filePathLineNode">
                <div id="textLine" data-dojo-attach-point="pathLineTextNode"></div>
                <div id="fileTextField" data-dojo-attach-point="fileNameNode"></div>
                <div id="extension" data-dojo-attach-point="extensionNode"></div>
            </div>
            <div id="messageLine" data-dojo-attach-point="messageLineNode"></div>
        </div>
    </div>
    
    <div id="buttonContainer" data-dojo-attach-point="buttonContainerNode">
        <div id="saveButton" data-dojo-attach-point="saveButtonNode"></div>
        <div id="cancelButton" data-dojo-attach-point="cancelButtonNode"></div>
    </div>
</div>`},"dojo/text!filebrowser_utils-ui/js/actions/preview/previewPopupTemplate.html":d=>{d.exports=`<div class="previewPopup" data-dojo-attach-point="previewNode">
    <div class="header" data-dojo-attach-point="headerNode">
        <div class="fileIcon" data-dojo-attach-point="fileIconNode"></div>
        <div class="title" data-dojo-attach-point="titleNode"></div>
        <div class="upperRightMetadata" data-dojo-attach-point="upperRightMetadataNode"></div>
    </div>
    <div class="body" data-dojo-attach-point="bodyNode">
        <div class="richContent" data-dojo-attach-point="richContentNode"></div>
        <div class="richContentLabel" data-dojo-attach-point="richContentLabelNode"></div>
        <div class="primaryMetadata" data-dojo-attach-point="primaryMetadataNode"></div>
        <div class="secondaryMetadata" data-dojo-attach-point="secondaryMetadataNode"></div>
        <div class="sharingContent" data-dojo-attach-point="sharingContentNode"></div>
    </div>
    <div class="footer" data-dojo-attach-point="footerNode">
        <div class="openButton" data-dojo-attach-point="openButtonNode"></div>
    </div>
</div>`},"dojo/text!filebrowser_utils-ui/js/actions/upload/legacy/LegacyUploadWidgetTemplate.html":d=>{d.exports=`<form data-dojo-attach-point="uploadForm" class="upload"
      method="post"
      enctype="multipart/form-data"
      action="\${_action}"
      target="\${_targetFrame}">
    <!-- Firefox does not respect css width property for input type="file". This is firefox bug which has been
    there since 12years. https://bugzilla.mozilla.org/show_bug.cgi?id=52500. Workaround for this bug is to set the
     size so that the text length is nearer to how the text box looks in IE.-->
    <div class="upload statusText" data-dojo-attach-point="statusText"></div>
    <div class="upload browseFile">
        <input class="upload inputFile" size="29"
               data-dojo-attach-point="fileInput" name="uploadFileName"
               data-dojo-attach-event="onchange:onChangeHandler"
               id="fileToUpload" type="file" multiple/>
    </div>
    <div class="upload errText" data-dojo-attach-point="errorText"></div>
    <div class="upload uploadControls">
        <button class="upload cancelButton"
                data-dojo-attach-point="cancelButton" type="reset"
                data-dojo-attach-event="onclick:onCancel"
                name="\${_localization.cancelLabel}">
            \${_localization.cancelLabel}
        </button>
        <input class="upload uploadButton" data-dojo-attach-point="fileSubmit"
               data-dojo-attach-event="onclick:onUpload" type="button"
               disabled="disabled" value="\${_localization.submitLabel}"/>
    </div>
</form>`},"dojo/text!filechooser-ui/fileChooserNavigationBarTemplate.html":d=>{d.exports=`<div class="fileChooserNavigationBarContainer" data-dojo-attach-point="fileChooserNavigationBarContainer">
</div>`},"dojo/text!filechooser-ui/fileChooserTemplate.html":d=>{d.exports=`<div class="fileChooser2">
    <div class = "fileChooserNavigationBar" data-dojo-attach-point="fileChooserNavigationBarNode">
    </div>
    <div class = "fileBrowser" tabindex="-1" data-dojo-attach-point="fileBrowserNode"></div>
    <div class="bottom" data-dojo-attach-point="bottom">
        <div class="fileNameWithLabel" data-dojo-attach-point="fileNameWithLabelNode">
            <div class="fileNameLabel fileChooserLabels" data-dojo-attach-point="fileNameLabelNode">\${localization.saveAsFileNameLabel}</div>
            <div class="fileName fileChooserFields" data-dojo-attach-point="fileNameNode"></div>
        </div>
        <div class="fileTypeWithLabel" data-dojo-attach-point="fileTypeWithLabelNode">
            <div class="inputLabel fileChooserLabels" data-dojo-attach-point="fileTypeLabelNode">\${localization.saveAsFileDropDownLabel}</div>
            <div class="fileType fileChooserFields" data-dojo-attach-point="fileTypeNode"></div>
        </div>
        <div class="buttons" data-dojo-attach-point="buttons">
            <div class="okButton fileChooserButtons" data-dojo-attach-point="okButtonNode"></div>
            <div class="cancelButton fileChooserButtons" data-dojo-attach-point="cancelButtonNode"></div>
        </div>
    </div>
</div>`},"dojo/text!MW/layout/templates/CollapsedBorderChildH.html":d=>{d.exports='<div class="gripH"></div>'},"dojo/text!MW/layout/templates/CollapsedBorderChildV.html":d=>{d.exports='<div class="gripV"></div>'},"Tippy/tippy-bundle.umd":function(d,v,t){(function(C,m){d.exports=m(t("mwBundle.compilersdk-ui|popper/popper"))})(this,function(C){"use strict";var m='.tippy-box[data-animation=fade][data-state=hidden]{opacity:0}[data-tippy-root]{max-width:calc(100vw - 10px)}.tippy-box{position:relative;background-color:#333;color:#fff;border-radius:4px;font-size:14px;line-height:1.4;white-space:normal;outline:0;transition-property:transform,visibility,opacity}.tippy-box[data-placement^=top]>.tippy-arrow{bottom:0}.tippy-box[data-placement^=top]>.tippy-arrow:before{bottom:-7px;left:0;border-width:8px 8px 0;border-top-color:initial;transform-origin:center top}.tippy-box[data-placement^=bottom]>.tippy-arrow{top:0}.tippy-box[data-placement^=bottom]>.tippy-arrow:before{top:-7px;left:0;border-width:0 8px 8px;border-bottom-color:initial;transform-origin:center bottom}.tippy-box[data-placement^=left]>.tippy-arrow{right:0}.tippy-box[data-placement^=left]>.tippy-arrow:before{border-width:8px 0 8px 8px;border-left-color:initial;right:-7px;transform-origin:center left}.tippy-box[data-placement^=right]>.tippy-arrow{left:0}.tippy-box[data-placement^=right]>.tippy-arrow:before{left:-7px;border-width:8px 8px 8px 0;border-right-color:initial;transform-origin:center right}.tippy-box[data-inertia][data-state=visible]{transition-timing-function:cubic-bezier(.54,1.5,.38,1.11)}.tippy-arrow{width:16px;height:16px;color:#333}.tippy-arrow:before{content:"";position:absolute;border-color:transparent;border-style:solid}.tippy-content{position:relative;padding:5px 9px;z-index:1}';function p(pt){var dt=document.createElement("style");dt.textContent=pt,dt.setAttribute("data-tippy-stylesheet","");var gt=document.head,Tt=document.querySelector("head>style,head>link");Tt?gt.insertBefore(dt,Tt):gt.appendChi