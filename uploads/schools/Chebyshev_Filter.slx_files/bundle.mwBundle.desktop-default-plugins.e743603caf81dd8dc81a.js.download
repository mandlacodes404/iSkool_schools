mw-git-branchmanager-referenceslist,
mw-git-branchmanager-submoduleslist
 {
    min-width: 50px;
}

mw-git-branchmanager-referenceslist .mw-table-component .mw-table-inner-wrapper,
mw-git-branchmanager-submoduleslist .mw-table-component .mw-table-inner-wrapper,
mw-git-branchmanager-referenceslist .mw-table-component .mw-table-cell-background,
mw-git-branchmanager-submoduleslist .mw-table-component .mw-table-cell-background  {
    background: var(--mw-backgroundColor-primary);
}

mw-git-branchmanager-referenceslist .mw-table-component .mw-table-outer-wrapper,
mw-git-branchmanager-submoduleslist .mw-table-component .mw-table-outer-wrapper,
mw-git-branchmanager-referenceslist .mw-table-component .mw-table-outer-wrapper-blurred,
mw-git-branchmanager-submoduleslist .mw-table-component .mw-table-outer-wrapper-blurred {
    /* Override the border of mw-table, as it makes the commit graph border look thicker
     * than all the borders of the other panes. */
    border: 0;
}

mw-git-branchmanager-referenceslist .headReference {
    display: flex;
    gap: 5px;
    align-items: center;
}
`,"",{version:3,sources:["webpack://./../../toolbox/shared/cmlink/view/git_web/cmlink-git-lib/css/ReferencesList.css"],names:[],mappings:"AAAA,4CAA4C;;AAE5C;;;IAGI,eAAe;AACnB;;AAEA;;;;IAII,6CAA6C;AACjD;;AAEA;;;;IAII;iDAC6C;IAC7C,SAAS;AACb;;AAEA;IACI,aAAa;IACb,QAAQ;IACR,mBAAmB;AACvB",sourcesContent:[`/* Copyright 2022-2024 The MathWorks, Inc. */

