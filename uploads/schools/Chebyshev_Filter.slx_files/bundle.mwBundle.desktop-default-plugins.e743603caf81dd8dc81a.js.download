.deploymentSetupPopoutContent {
}

.deploymentSetupPopoutTitle {
}

.deploymentSetupPopoutHeader {
    color: var(--mw-color-list-primary);
    font-weight:bold;
    margin-top: 10px;
}

.deploymentSetupPopoutDescription {
    margin-top: 10px;
}

.deploymentSetupPopoutFooter {
    display: flex; width: 100%; justify-content: space-between;
}

.deploymentSetupPopoutDescriptionStandout {
    font-weight:bold;
}

.deploymentPreambleInfoBox{
    border: 1px solid var(--mw-borderColor-toolbar-toggleOn);
    background-color: var(--mw-backgroundColor-announcementBanner);
    padding: 5px;

}

.deploymentSetupPopoutDoc{
    margin-top: 16px;
}

.deploymentDocViewLink{
    color: var(--mw-color-hyperlink);
    display:inline;
    text-decoration:underline;
}

.deploymentDocViewLink:hover{
    color: var(--mw-color-hyperlink-hover);
    cursor:pointer
}

.deploymentUpgradeInfo[hasIssuesToDisplay = "false"] .deploymentUpgradeIssues{
    display: none;
}

.deploymentUpgradeInfo[hasIssuesToDisplay = "true"] .deploymentUpgradeIssuesList{
    display: block;
}

.deploymentUpgradeInfo[hasIssuesToDisplay = "true"] .deploymentUpgradeIssuesDescription{
    display: inline-block;
}

.deploymentUpgradeIssueEntry {
    margin-top: 5px;
    user-select: text;
    word-break:break-word
}

.deploymentUpgradeDescriptionText{
    margin-bottom: 10px;
    margin-top: 10px;
}

.deploymentUpgradeDescriptionText span{
    /* display: inline-block; */
}

.deploymentUpgradeInfo {
    display: flex;
    flex-direction: column;
    max-height: 100%;
    box-sizing: border-box;
}


.deploymentUpgradeIssuesList {
    flex-grow: 1; /* Allow this div to grow and fill available space */
    flex-shrink: 1; /* Allow this div to shrink */
    overflow-y: auto; /* Enable vertical scrolling */
    padding: 3px 10px;
    box-sizing: border-box;
    border: 1px solid var(--mw-borderColor-tertiary); 
    background-color: var(--mw-backgroundColor-tertiary); 
}

.toolboxDeploymentDialogText{
    margin-bottom: 20px;
}`,"",{version:3,sources:["webpack://./../../toolbox/deployment/common/gui/web/common_deployment_gui/common_deployment_gui-ui/css/setupGuide.css"],names:[],mappings:";AACA;AACA;;AAEA;AACA;;AAEA;IACI,mCAAmC;IACnC,gBAAgB;IAChB,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,aAAa,EAAE,WAAW,EAAE,8BAA8B;AAC9D;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,wDAAwD;IACxD,8DAA8D;IAC9D,YAAY;;AAEhB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,gCAAgC;IAChC,cAAc;IACd,yBAAyB;AAC7B;;AAEA;IACI,sCAAsC;IACtC;AACJ;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,cAAc;AAClB;;AAEA;IACI,qBAAqB;AACzB;;AAEA;IACI,eAAe;IACf,iBAAiB;IACjB;AACJ;;AAEA;IACI,mBAAmB;IACnB,gBAAgB;AACpB;;AAEA;IACI,2BAA2B;AAC/B;;AAEA;IACI,aAAa;IACb,sBAAsB;IACtB,gBAAgB;IAChB,sBAAsB;AAC1B;;;AAGA;IACI,YAAY,EAAE,oDAAoD;IAClE,cAAc,EAAE,6BAA6B;IAC7C,gBAAgB,EAAE,8BAA8B;IAChD,iBAAiB;IACjB,sBAAsB;IACtB,gDAAgD;IAChD,oDAAoD;AACxD;;AAEA;IACI,mBAAmB;AACvB",sourcesContent:[`
.deploymentSetupPopoutContent {
}

.deploymentSetupPopoutTitle {
}

.deploymentSetupPopoutHeader {
    color: var(--mw-color-list-primary);
    font-weight:bold;
    margin-top: 10px;
}

.deploymentSetupPopoutDescription {
    margin-top: 10px;
}

.deploymentSetupPopoutFooter {
    display: flex; width: 100%; justify-content: space-between;
}

.deploymentSetupPopoutDescriptionStandout {
    font-weight:bold;
}

.deploymentPreambleInfoBox{
    border: 1px solid var(--mw-borderColor-toolbar-toggleOn);
    background-color: var(--mw-backgroundColor-announcementBanner);
    padding: 5px;

}

.deploymentSetupPopoutDoc{
    margin-top: 16px;
}

.deploymentDocViewLink{
    color: var(--mw-color-hyperlink);
    display:inline;
    text-decoration:underline;
}

.deploymentDocViewLink:hover{
    color: var(--mw-color-hyperlink-hover);
    cursor:pointer
}

.deploymentUpgradeInfo[hasIssuesToDisplay = "false"] .deploymentUpgradeIssues{
    display: none;
}

.deploymentUpgradeInfo[hasIssuesToDisplay = "true"] .deploymentUpgradeIssuesList{
    display: block;
}

.deploymentUpgradeInfo[hasIssuesToDisplay = "true"] .deploymentUpgradeIssuesDescription{
    display: inline-block;
}

.deploymentUpgradeIssueEntry {
    margin-top: 5px;
    user-select: text;
    word-break:break-word
}

.deploymentUpgradeDescriptionText{
    margin-bottom: 10px;
    margin-top: 10px;
}

.deploymentUpgradeDescriptionText span{
    /* display: inline-block; */
}

.deploymentUpgradeInfo {
    display: flex;
    flex-direction: column;
    max-height: 100%;
    box-sizing: border-box;
}


.deploymentUpgradeIssuesList {
    flex-grow: 1; /* Allow this div to grow and fill available space */
    flex-shrink: 1; /* Allow this div to shrink */
    overflow-y: auto; /* Enable vertical scrolling */
    padding: 3px 10px;
    box-sizing: border-box;
    border: 1px solid var(--mw-borderColor-tertiary); 
    background-color: var(--mw-backgroundColor-tertiary); 
}

.toolboxDeploymentDialogText{
    margin-bottom: 20px;
}`],sourceRoot:""}]),h.exports=g},"4f90f648da283c757c7fe6a73110f89545a2a13f":(h,M,t)=>{var m=t("mwBundle.desktop-default-plugins|ed696428f59273ff5a3b9e7284cefe5b63dd4d1d"),p=t("mwBundle.desktop-default-plugins|cb47172937e548a863ab648aecddd4b09386a96d"),g=p(m);g.push([h.id,`.status-bar {
    /* width: 100%; */
    border-bottom: solid 1px;
    text-align: center;
    vertical-align: middle;
    /* position: relative; */
    text-align: center;
    flex-flow: column;
    vertical-align: middle;
    justify-content: center;
    /* padding-top: 6px; */
    align-self: center;
    display: flex;
    flex-grow: 1;
}

.status-bar{
    user-select: none; 
    /* position: fixed; */
    z-index: 11;
    width: 100%;
    /* height: 100%; */
    min-height: 46px;
}

.status-bar.toolboxStatus {
    color: var(--mw-color-primary) !important;
    background-color: var(--mw-backgroundColor-secondary) !important;
    border-color: var(--mw-backgroundColor-secondary) !important;
    box-shadow: var(--mw-boxShadowColor);
}

.toolboxStatus.status-bar[status='warn'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary) !important;
}

.toolboxStatus.status-bar[status='good'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary) !important;
}

.toolboxStatus.status-bar[status='info'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary) !important;
}

.toolboxStatus.status-bar[status='error'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary) !important;
}

.statusContentUmbrella {
    display: flex;
    flex-flow: row;
    justify-content: space-between;
    flex-wrap: wrap;
    align-items: center;
    width: 97%;
    /* padding-top: 6px; */
    margin: 0 auto;
    /* height: 37px; */
    flex-grow: 1;
    /* padding-bottom: 12px; */
    gap: 5px;
    margin-top: 6px;
}

.deployment-status-bar-container{
    height: 100%;
    width: 100%;
    background-color: var(--mw-backgroundColor-secondary);
}

/* Status Message */
.status-message-container {
    display: inline-block;
    text-align: center;
    vertical-align: middle;
}

/* Status Bar Message */
.deploymentStatusBarSummaryText {
    /* font-size: 110%; */
    margin: 6px;
}

.deploymentStatusMessageHeader {
    font-weight: bold;
    padding-left: 7px;
}

.deploymentStatusBarMainText{
    padding-left: 8px;
}

/* Reload Button */

.status-icon {
    width: 24px;
    height: 24px;
    vertical-align: middle;
    /* padding-top: 5px; */
}

.refresh-button:hover {
    filter: brightness(110%);
}

.refresh-button:active {
    filter: brightness(80%);
}

.deploymentStatusContainer mw-progress-indicator {
    margin: 4px;
    margin-top: 3px; 
}

/**STATUS RELATED**/
.status-bar[status='warn'] {
    background-color:var(--mw-backgroundColor-secondary-warning);
    border-color: var(--mw-borderColor-warning);
}

.status-bar[status='warn'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary);
}

.status-bar[status='error'] {
    background-color:var(--mw-backgroundColor-secondary-error);
    border-color: var(--mw-borderColor-error);
}

.status-bar[status='error'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-error);
}

.status-bar[status='good'] .deploymentStatusBarText {
    color: var(--mw-color-success);
}

.status-bar[status='good'] {
    background-color:var(--mw-backgroundColor-secondary-success);
    border-color: var(--mw-borderColor-success);
}

.status-bar[status='info'] {
    background-color: var(--mw-backgroundColor-secondary-info);
    border-color: var(--mw-borderColor-info);
}

.status-bar[status='info'] .deploymentStatusBarText {
    color: var(--mw-color-info);
}

/** SPINNING ON OR OFF**/
.status-bar[spinning='true'] .deploymentStatusBarText {
    color: var(--mw-color-info);
}

.status-bar[spinning='true']  {
        background-color: var(--mw-backgroundColor-secondary-info);
        border-color: var(--mw-borderColor-info);
}

/** STATUS REPORT WIDGET **/

/**hide overview when details are shown and available**/
.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentProfileStatusSummary{
    display: none;

}

.toolboxStatus.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentProfileStatusSummary {
    display: flex;
    vertical-align: middle;
    align-items: center;
    gap: 7px;
}

/**show details table when requested and available**/
.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentProfileStatusDetails{
    display: block;
    max-height: 12vh !important;
}

.status-bar[detailsRequested='true'][reportAccessible='true'] .statusContentUmbrella {
    margin-top: 6px;
    margin-bottom: 4px;
    min-height: 40px;
}

.deploymentStatusReport .mw-tree.treeContainer {
    overflow-y: auto !important;
    max-height: 12vh !important;
  
}

.deploymentStatusReport .mw-tree.treeContainer {
    overflow-y: auto !important;
    max-height: 12vh !important;
  
}

.deploymentStatusReport .mw-tree .mw-tree-scroll-component {
    /* height: 100%; */
    /* position: relative; */
    overflow: auto !important;
    max-height: 12vh !important;
}

/**if details are not requested and/or just not avialable, then show the overview isntead**/
.status-bar[reportAccessible='false'] .deploymentProfileStatusSummary, .status-bar[detailsRequested='false'] .deploymentProfileStatusSummary {
    display: flex;
    /* padding-top: 6px; */
    /* padding-bottom: 6px; */
    vertical-align: middle;
    vertical-align: middle;
    align-items: center;
    gap: 7px;
}

/**when details are not requested and/or not available then hide the details table**/
.status-bar[detailsRequested='false'] .deploymentProfileStatusDetails,
.status-bar[reportAccessible='false'] .deploymentProfileStatusDetails{
    display: none;
}


/**if there are no details (1 or less issues) then hide the toggle for showing details table**/
.status-bar[reportAccessible='false']  .deploymentBarToggle{
    display: none;
}

/**if there are no details (1 or less issues) then hide the toggle for showing details table**/
.status-bar[reportAccessible='false']  .deploymentSectionToggleArrow{
    display: none;
}

/**when details are available, show the toggle button**/
.status-bar[reportAccessible='true'] .deploymentSectionToggleArrow {
    display: block;
    vertical-align: middle;
    /* margin-top: 6px; */
    align-content: center;
    align-items: center;
}

/**when details are available, show the toggle button**/
.status-bar[reportAccessible='true']  .deploymentBarToggle{
    display: block;
    text-align: center;
    display: inline-block;
    height: 100%;
    padding-left: 15px;
}

/**when unexpanded, middle-align text and buttons**/
.status-bar[reportAccessible='true'][detailsRequested='false'] .deploymentBarToggle {
    vertical-align: middle;
}

.toolboxStatus.status-bar[reportAccessible='true'][detailsRequested='false'] .deploymentBarToggle {
    vertical-align: baseline;
}

/**When showing the report, the 'show less' link looks better when inline with the status report header
the followign styles make the 'status report' title be inline and the toggle float right when the report is showing **/
.status-bar[reportAccessible='true'] .deploymentBarToggleFloat{
    /* float: right; */
    padding-right: 15px;
}
.status-bar[reportAccessible='true'][detailsRequested='true']  .deploymentStatusReportHeader{
    display: inline;
}

/**when displaying details, the overalls tatus bar should be neutral colors **/
.status-bar[detailsRequested='true'][reportAccessible='true']{
    background-color:var(--mw-backgroundColor-tertiary);
    border-color: var(--mw-borderColor-tertiary);
}

.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentStatusReportHeader {
    color: var(--mw-color-primary);
}

.toolboxStatus.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentStatusReportHeader {
    color: var(--mw-color-primary);
}

/**'Status Report' header should have some weiht **/
.deploymentStatusReportHeader{
    font-weight: bolder;
    padding-right: 15px;
}

.status-bar[reportAccessible='true'][detailsRequested='true'] .deploymentStatusReportToggleBar{
    padding: 6px;
    border-bottom: 1px solid var(--mw-borderColor-primary);
}

.status-bar[reportAccessible='true'][detailsRequested='true'] .deploymentStatusReportToggleBar{
    border-bottom: 1px solid var(--mw-borderColor-primary);
}

/** when the table is placed in side the status bar, the borders become excessive so they are removed ehre**/
.status-bar[detailsRequested='true'][reportAccessible='true'] .mw-table-gridstyle-lightweight{
    border: none !important;
}

/** report table looks good when the icons are centered in there cells rather than pushed leftward**/
.deploymentIssuesStatusCell{
    text-align: center;
}

.deploymentIssuesActionLink{
    float: right;
    padding-right: 15px;
}

.refreshIconContainer {
    right: 0px;
    margin-right: 8px;
    top: 0px;
    margin-top: 7px;
    height: 33px;
    width: 33px;
    position: absolute;
    background: none;
    border: none;
}

.commonRefreshIconContainer{
    background: none;
    border: none;
}

.commonRefreshIconContainer button-mwButton {
    border: none;
    background-color: transparent !important;
}

.commonRefreshIconContainer .refreshButton {
    border: none;
    background-color: transparent !important;
    padding-left: 10px;
    padding-top: 1px;
}

.commonRefreshIconContainer button:hover {
    border: 1px solid var(--mw-borderColor-primary);
    background-color: transparent !important;
    filter: brightness(110%);
}

.commonRefreshIconContainer button:focus {
    border: 1px solid var(--mw-borderColor-focus);
}

.refreshButton button {
    border: none;
    background-color: transparent !important;
}

.refreshButton button:hover {
    border: 1px solid var(--mw-borderColor-primary);
    background-color: transparent !important;
    filter: brightness(110%);
}

.refreshButton button:focus {
    border: 1px solid var(--mw-borderColor-focus);
}

.deployButtonContainer {
    display: flex;
    flex-direction: row-reverse;
    gap: 10px;
}

.statusMessageUmbrella {
    display: flex;
    flex-flow: row;
    align-items: center;
    gap: 6px;
}

.status-bar[detailsRequested='true'] .deploymentSectionToggleArrow{
    transform: rotate(90deg);
    transition: 200ms linear transform;
}

.deploymentStatusReportTreeNodeRow {
    display: flex;
    flex-flow: row;
    gap: 10px;
    vertical-align: baseline;
    margin-top: 0.5px;
}

.deploymentStatusReportTreeNodeRow mw-button{
    display: none;
}

.deploymentStatusReportTreeNodeRow:hover mw-button{
    display: block;
}

.deploymentStatusReport .mw-treeNode-renderer-container {
    width: 95%;
}

.buildAndPackageButton .mwWidgetDisabled {
    pointer-events: none;
}

.deploymentProfileStatusTable .mw-tree-body-component {
    height: auto !important;
    max-height: fit-content;
}

.deploymentProfileStatusTable .mw-tree .treeNode .treeNodeData {
    height: 26px
}

.deploymentProfileStatusTable .tree {
    max-height: 12vh;
}`,"",{version:3,sources:["webpack://./../../toolbox/deployment/common/gui/web/common_deployment_gui/common_deployment_gui-ui/css/statusBar.css"],names:[],mappings:"AAAA;IACI,iBAAiB;IACjB,wBAAwB;IACxB,kBAAkB;IAClB,sBAAsB;IACtB,wBAAwB;IACxB,kBAAkB;IAClB,iBAAiB;IACjB,sBAAsB;IACtB,uBAAuB;IACvB,sBAAsB;IACtB,kBAAkB;IAClB,aAAa;IACb,YAAY;AAChB;;AAEA;IACI,iBAAiB;IACjB,qBAAqB;IACrB,WAAW;IACX,WAAW;IACX,kBAAkB;IAClB,gBAAgB;AACpB;;AAEA;IACI,yCAAyC;IACzC,gEAAgE;IAChE,4DAA4D;IAC5D,oCAAoC;AACxC;;AAEA;IACI,sBAAsB;IACtB,yCAAyC;AAC7C;;AAEA;IACI,sBAAsB;IACtB,yCAAyC;AAC7C;;AAEA;IACI,sBAAsB;IACtB,yCAAyC;AAC7C;;AAEA;IACI,sBAAsB;IACtB,yCAAyC;AAC7C;;AAEA;IACI,aAAa;IACb,cAAc;IACd,8BAA8B;IAC9B,eAAe;IACf,mBAAmB;IACnB,UAAU;IACV,sBAAsB;IACtB,cAAc;IACd,kBAAkB;IAClB,YAAY;IACZ,0BAA0B;IAC1B,QAAQ;IACR,eAAe;AACnB;;AAEA;IACI,YAAY;IACZ,WAAW;IACX,qDAAqD;AACzD;;AAEA,mBAAmB;AACnB;IACI,qBAAqB;IACrB,kBAAkB;IAClB,sBAAsB;AAC1B;;AAEA,uBAAuB;AACvB;IACI,qBAAqB;IACrB,WAAW;AACf;;AAEA;IACI,iBAAiB;IACjB,iBAAiB;AACrB;;AAEA;IACI,iBAAiB;AACrB;;AAEA,kBAAkB;;AAElB;IACI,WAAW;IACX,YAAY;IACZ,sBAAsB;IACtB,sBAAsB;AAC1B;;AAEA;IACI,wBAAwB;AAC5B;;AAEA;IACI,uBAAuB;AAC3B;;AAEA;IACI,WAAW;IACX,eAAe;AACnB;;AAEA,mBAAmB;AACnB;IACI,4DAA4D;IAC5D,2CAA2C;AAC/C;;AAEA;IACI,sBAAsB;IACtB,8BAA8B;AAClC;;AAEA;IACI,0DAA0D;IAC1D,yCAAyC;AAC7C;;AAEA;IACI,sBAAsB;IACtB,4BAA4B;AAChC;;AAEA;IACI,8BAA8B;AAClC;;AAEA;IACI,4DAA4D;IAC5D,2CAA2C;AAC/C;;AAEA;IACI,0DAA0D;IAC1D,wCAAwC;AAC5C;;AAEA;IACI,2BAA2B;AAC/B;;AAEA,wBAAwB;AACxB;IACI,2BAA2B;AAC/B;;AAEA;QACQ,0DAA0D;QAC1D,wCAAwC;AAChD;;AAEA,2BAA2B;;AAE3B,uDAAuD;AACvD;IACI,aAAa;;AAEjB;;AAEA;IACI,aAAa;IACb,sBAAsB;IACtB,mBAAmB;IACnB,QAAQ;AACZ;;AAEA,oDAAoD;AACpD;IACI,cAAc;IACd,2BAA2B;AAC/B;;AAEA;IACI,eAAe;IACf,kBAAkB;IAClB,gBAAgB;AACpB;;AAEA;IACI,2BAA2B;IAC3B,2BAA2B;;AAE/B;;AAEA;IACI,2BAA2B;IAC3B,2BAA2B;;AAE/B;;AAEA;IACI,kBAAkB;IAClB,wBAAwB;IACxB,yBAAyB;IACzB,2BAA2B;AAC/B;;AAEA,2FAA2F;AAC3F;IACI,aAAa;IACb,sBAAsB;IACtB,yBAAyB;IACzB,sBAAsB;IACtB,sBAAsB;IACtB,mBAAmB;IACnB,QAAQ;AACZ;;AAEA,oFAAoF;AACpF;;IAEI,aAAa;AACjB;;;