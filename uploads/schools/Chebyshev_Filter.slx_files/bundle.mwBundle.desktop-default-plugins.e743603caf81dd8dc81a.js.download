    /* width: 100%; */
    border-bottom: solid 1px;
    text-align: center;
    vertical-align: middle;
    /* position: relative; */
    text-align: center;
    flex-flow: column;
    vertical-align: middle;
    justify-content: center;
    /* padding-top: 6px; */
    align-self: center;
    display: flex;
    flex-grow: 1;
}

.status-bar{
    user-select: none; 
    /* position: fixed; */
    z-index: 11;
    width: 100%;
    /* height: 100%; */
    min-height: 46px;
}

.status-bar.toolboxStatus {
    color: var(--mw-color-primary) !important;
    background-color: var(--mw-backgroundColor-secondary) !important;
    border-color: var(--mw-backgroundColor-secondary) !important;
    box-shadow: var(--mw-boxShadowColor);
}

.toolboxStatus.status-bar[status='warn'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary) !important;
}

.toolboxStatus.status-bar[status='good'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary) !important;
}

.toolboxStatus.status-bar[status='info'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary) !important;
}

.toolboxStatus.status-bar[status='error'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary) !important;
}

.statusContentUmbrella {
    display: flex;
    flex-flow: row;
    justify-content: space-between;
    flex-wrap: wrap;
    align-items: center;
    width: 97%;
    /* padding-top: 6px; */
    margin: 0 auto;
    /* height: 37px; */
    flex-grow: 1;
    /* padding-bottom: 12px; */
    gap: 5px;
    margin-top: 6px;
}

.deployment-status-bar-container{
    height: 100%;
    width: 100%;
    background-color: var(--mw-backgroundColor-secondary);
}

/* Status Message */
.status-message-container {
    display: inline-block;
    text-align: center;
    vertical-align: middle;
}

/* Status Bar Message */
.deploymentStatusBarSummaryText {
    /* font-size: 110%; */
    margin: 6px;
}

.deploymentStatusMessageHeader {
    font-weight: bold;
    padding-left: 7px;
}

.deploymentStatusBarMainText{
    padding-left: 8px;
}

/* Reload Button */

.status-icon {
    width: 24px;
    height: 24px;
    vertical-align: middle;
    /* padding-top: 5px; */
}

.refresh-button:hover {
    filter: brightness(110%);
}

.refresh-button:active {
    filter: brightness(80%);
}

.deploymentStatusContainer mw-progress-indicator {
    margin: 4px;
    margin-top: 3px; 
}

/**STATUS RELATED**/
.status-bar[status='warn'] {
    background-color:var(--mw-backgroundColor-secondary-warning);
    border-color: var(--mw-borderColor-warning);
}

.status-bar[status='warn'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-primary);
}

.status-bar[status='error'] {
    background-color:var(--mw-backgroundColor-secondary-error);
    border-color: var(--mw-borderColor-error);
}

.status-bar[status='error'] .deploymentStatusBarText {
    vertical-align: middle;
    color: var(--mw-color-error);
}

.status-bar[status='good'] .deploymentStatusBarText {
    color: var(--mw-color-success);
}

.status-bar[status='good'] {
    background-color:var(--mw-backgroundColor-secondary-success);
    border-color: var(--mw-borderColor-success);
}

.status-bar[status='info'] {
    background-color: var(--mw-backgroundColor-secondary-info);
    border-color: var(--mw-borderColor-info);
}

.status-bar[status='info'] .deploymentStatusBarText {
    color: var(--mw-color-info);
}

/** SPINNING ON OR OFF**/
.status-bar[spinning='true'] .deploymentStatusBarText {
    color: var(--mw-color-info);
}

.status-bar[spinning='true']  {
        background-color: var(--mw-backgroundColor-secondary-info);
        border-color: var(--mw-borderColor-info);
}

/** STATUS REPORT WIDGET **/

/**hide overview when details are shown and available**/
.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentProfileStatusSummary{
    display: none;

}

.toolboxStatus.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentProfileStatusSummary {
    display: flex;
    vertical-align: middle;
    align-items: center;
    gap: 7px;
}

/**show details table when requested and available**/
.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentProfileStatusDetails{
    display: block;
    max-height: 12vh !important;
}

.status-bar[detailsRequested='true'][reportAccessible='true'] .statusContentUmbrella {
    margin-top: 6px;
    margin-bottom: 4px;
    min-height: 40px;
}

.deploymentStatusReport .mw-tree.treeContainer {
    overflow-y: auto !important;
    max-height: 12vh !important;
  
}

.deploymentStatusReport .mw-tree.treeContainer {
    overflow-y: auto !important;
    max-height: 12vh !important;
  
}

.deploymentStatusReport .mw-tree .mw-tree-scroll-component {
    /* height: 100%; */
    /* position: relative; */
    overflow: auto !important;
    max-height: 12vh !important;
}

/**if details are not requested and/or just not avialable, then show the overview isntead**/
.status-bar[reportAccessible='false'] .deploymentProfileStatusSummary, .status-bar[detailsRequested='false'] .deploymentProfileStatusSummary {
    display: flex;
    /* padding-top: 6px; */
    /* padding-bottom: 6px; */
    vertical-align: middle;
    vertical-align: middle;
    align-items: center;
    gap: 7px;
}

/**when details are not requested and/or not available then hide the details table**/
.status-bar[detailsRequested='false'] .deploymentProfileStatusDetails,
.status-bar[reportAccessible='false'] .deploymentProfileStatusDetails{
    display: none;
}


/**if there are no details (1 or less issues) then hide the toggle for showing details table**/
.status-bar[reportAccessible='false']  .deploymentBarToggle{
    display: none;
}

/**if there are no details (1 or less issues) then hide the toggle for showing details table**/
.status-bar[reportAccessible='false']  .deploymentSectionToggleArrow{
    display: none;
}

/**when details are available, show the toggle button**/
.status-bar[reportAccessible='true'] .deploymentSectionToggleArrow {
    display: block;
    vertical-align: middle;
    /* margin-top: 6px; */
    align-content: center;
    align-items: center;
}

/**when details are available, show the toggle button**/
.status-bar[reportAccessible='true']  .deploymentBarToggle{
    display: block;
    text-align: center;
    display: inline-block;
    height: 100%;
    padding-left: 15px;
}

/**when unexpanded, middle-align text and buttons**/
.status-bar[reportAccessible='true'][detailsRequested='false'] .deploymentBarToggle {
    vertical-align: middle;
}

.toolboxStatus.status-bar[reportAccessible='true'][detailsRequested='false'] .deploymentBarToggle {
    vertical-align: baseline;
}

/**When showing the report, the 'show less' link looks better when inline with the status report header
the followign styles make the 'status report' title be inline and the toggle float right when the report is showing **/
.status-bar[reportAccessible='true'] .deploymentBarToggleFloat{
    /* float: right; */
    padding-right: 15px;
}
.status-bar[reportAccessible='true'][detailsRequested='true']  .deploymentStatusReportHeader{
    display: inline;
}

/**when displaying details, the overalls tatus bar should be neutral colors **/
.status-bar[detailsRequested='true'][reportAccessible='true']{
    background-color:var(--mw-backgroundColor-tertiary);
    border-color: var(--mw-borderColor-tertiary);
}

.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentStatusReportHeader {
    color: var(--mw-color-primary);
}

.toolboxStatus.status-bar[detailsRequested='true'][reportAccessible='true'] .deploymentStatusReportHeader {
    color: var(--mw-color-primary);
}

/**'Status Report' header should have some weiht **/
.deploymentStatusReportHeader{
    font-weight: bolder;
    padding-right: 15px;
}

.status-bar[reportAccessible='true'][detailsRequested='true'] .deploymentStatusReportToggleBar{
    padding: 6px;
    border-bottom: 1px solid var(--mw-borderColor-primary);
}

.status-bar[reportAccessible='true'][detailsRequested='true'] .deploymentStatusReportToggleBar{
    border-bottom: 1px solid var(--mw-borderColor-primary);
}

/** when the table is placed in side the status bar, the borders become excessive so they are removed ehre**/
.status-bar[detailsRequested='true'][reportAccessible='true'] .mw-table-gridstyle-lightweight{
    border: none !important;
}

/** report table looks good when the icons are centered in there cells rather than pushed leftward**/
.deploymentIssuesStatusCell{
    text-align: center;
}

.deploymentIssuesActionLink{
    float: right;
    padding-right: 15px;
}

.refreshIconContainer {
    right: 0px;
    margin-right: 8px;
    top: 0px;
    margin-top: 7px;
    height: 33px;
    width: 33px;
    position: absolute;
    background: none;
    border: none;
}

.commonRefreshIconContainer{
    background: none;
    border: none;
}

.commonRefreshIconContainer button-mwButton {
    border: none;
    background-color: transparent !important;
}

.commonRefreshIconContainer .refreshButton {
    border: none;
    background-color: transparent !important;
    padding-left: 10px;
    padding-top: 1px;
}

.commonRefreshIconContainer button:hover {
    border: 1px solid var(--mw-borderColor-primary);
    background-color: transparent !important;
    filter: brightness(110%);
}

.commonRefreshIconContainer button:focus {
    border: 1px solid var(--mw-borderColor-focus);
}

.refreshButton button {
    border: none;
    background-color: transparent !important;
}

.refreshButton button:hover {
    border: 1px solid var(--mw-borderColor-primary);
    background-color: transparent !important;
    filter: brightness(110%);
}

.refreshButton button:focus {
    border: 1px solid var(--mw-borderColor-focus);
}

.deployButtonContainer {
    display: flex;
    flex-direction: row-reverse;
    gap: 10px;
}

.statusMessageUmbrella {
    display: flex;
    flex-flow: row;
    align-items: center;
    gap: 6px;
}

.status-bar[detailsRequested='true'] .deploymentSectionToggleArrow{
    transform: rotate(90deg);
    transition: 200ms linear transform;
}

.deploymentStatusReportTreeNodeRow {
    display: flex;
    flex-flow: row;
    gap: 10px;
    vertical-align: baseline;
    margin-top: 0.5px;
}

.deploymentStatusReportTreeNodeRow mw-button{
    display: none;
}

.deploymentStatusReportTreeNodeRow:hover mw-button{
    display: block;
}

.deploymentStatusReport .mw-treeNode-renderer-container {
    width: 95%;
}

.buildAndPackageButton .mwWidgetDisabled {
    pointer-events: none;
}

.deploymentProfileStatusTable .mw-tree-body-component {
    height: auto !important;
    max-height: fit-content;
}

.deploymentProfileStatusTable .mw-tree .treeNode .treeNodeData {
    height: 26px
}

.deploymentProfileStatusTable .tree {
    max-height: 12vh;
}`],sourceRoot:""}]),h.exports=g},dfd9f0f28c66c6198ae8f03ff6d9f69c92eb8546:(h,M,t)=>{var m=t("mwBundle.desktop-default-plugins|ed696428f59273ff5a3b9e7284cefe5b63dd4d1d"),p=t("mwBundle.desktop-default-plugins|cb47172937e548a863ab648aecddd4b09386a96d"),g=t("mwBundle.desktop-default-plugins|5f64bd5079506f102e35fea5d110508493a4c84e"),f=p(m);f.i(g),f.push([h.id,`/* Copyright 2021 The MathWorks, Inc. */

body {
    background: rgb(240,240,240);
}

.main {
    min-width: 300px;
    background: rgb(240,240,240);
}

.titlePane {
    margin: 40px;
}`,"",{version:3,sources:["webpack://./../../toolbox/deployment/compiler/profile_management_gui/profile_management_gui-ui/css/export.css"],names:[],mappings:"AAAA,uCAAuC;;AAIvC;IACI,4BAA4B;AAChC;;AAEA;IACI,gBAAgB;IAChB,4BAA4B;AAChC;;AAEA;IACI,YAAY;AAChB",sourcesContent:[`/* Copyright 2021 The MathWorks, Inc. */

@import "./main.css";

body {
    background: rgb(240,240,240);
}

.main {
    min-width: 300px;
    background: rgb(240,240,240);
}

.titlePane {
    margin: 40px;
}`],sourceRoot:""}]),h.exports=f},"5f64bd5079506f102e35fea5d110508493a4c84e":(h,M,t)=>{var m=t("mwBundle.desktop-default-plugins|ed696428f59273ff5a3b9e7284cefe5b63dd4d1d"),p=t("mwBundle.desktop-default-plugins|cb47172937e548a863ab648aecddd4b09386a96d"),g=t("mwBundle.desktop-default-plugins|91f08457ae39f728dda081a8e184ff177ba16c7f"),f=p(m);f.i(g),f.push([h.id,`/* Copyright 2021 The MathWorks, Inc. */


body {
}

.main {
    width: 100%;
    height: 100%;
}

.titlePane {
    margin: 40px;
}
/** **/
.deploymentPreamblePersistenceBox{
    margin-top: 20px;
}

/**App Gallery WORKFLOW**/
.newItemWidget{
    margin-top: 10px;
    /* width: 400px; */
    border-collapse: separate;
    border-spacing: 4px 0px;
}

.creationLabel{
    text-align: center;
    vertical-align: middle;
    white-space: nowrap;
}

.createProfileOption{
    margin-top: 20px;
}

/* .deploymentProjectSelectionWidget{
    margin-left: 40px;
    margin-top: 10px;
} */

.creationField{
    width: 100%;
}

.singleCreationWidget{
    margin-top: 35px;
}

.profileCreationWidget{
    margin-top: 25px;
}

.profilesTable{
    margin-top: 10px;
    height: 140px;
    max-height: 140px;
}

.profilesTableSection[status='empty']{
    display: none;
}

.profilesTableSection[status='nonempty']{
    display: block;
}

.profilesTableSection{
    height: 100%;
    width: 100%;
}
/** ------------------- Styling for profile selection pane ------------------- **/
.deploymentProfileManagementContainer{
    height: 96%;
}

.deploymentProfileSelectionPane{
    display: flex;
    flex-flow: column;
    min-height: 10%;
    max-height: 60%;
    overflow-y: auto;
}

.deploymentProfileSelectionPanelTitle{
    color: var(--mw-color-primary);
    font-size: x-large;
    font-weight: bold;
}

.deploymentProfileManageSection{
    margin: 10px;
    margin-bottom: 0px;
}
.deploymentProfilePanelTitle{
    margin-bottom: 5px;
}

.deploymentOpenProfilesSection[toggle='true']{
    display: block;
    flex: 0 1 auto;
    min-height: 265px;
}

.deploymentOpenProfilesSection[toggle='false']{
    display: none;
}

.deploymentCreateProfilesSection{
    flex: 1 1 auto;
    overflow-y: hidden;
    height: 100%;
    display: flex;
    flex-flow: column;
    min-height: 150px;
    background-color: var(--mw-backgroundColor-primary);
    z-index: 100;
    position: relative;
    padding-top: 10px;
}

/* Sets bottom of the gallery panel to zero height, there may still be extra border */
.deploymentTargetSelectionWidget .footerContainer{
    height: 0px;
    overflow-y: auto;
}

/**todo this is bad 35 accounts for the title  + its margin**/
.deploymentProfileSelectionPanel{
    overflow-y: auto;
    border: 1.5px solid var(--mw-color-secondary);
    border-left: 0;
}

.deploymentProfileSelectionPanelTitle{
    flex: 0 1 auto;

}
.deploymentProfileSelectionPanelContent{
    flex: 1 1 auto;
}

/** ------------------- Styling for cards ------------------- **/

.deploymentProfileCard{
    border: 1px solid var(--mw-borderColor-primary);
    width: 150px;
    height: 200px;
    margin: 10px;
    margin-bottom: 5px;
    display: inline-block;
    cursor: pointer;
    color: var(--mw-color-primary);
    background-color: var(--mw-backgroundColor-primary);
}

.deploymentProfileCard:focus{
    border-color: var(--mw-borderColor-focus);
}

.deploymentProfileCard:hover{
    background-color: var(--mw-backgroundColor-hover);
    border-color: var(--mw-border-hover);
}

.deploymentProfileCard[available='false']{
    /* background-color: var(--mw-backgroundColor-hover);
    border-color: var(--mw-border-hover);
    color: var(--mw-color-primary); */
    color: var(--mw-color-primary);
    border: 1px solid var(--mw-borderColor-primary);
    background-color: var(--mw-backgroundColor-primary);
    cursor: default;
}

.deploymentProfileCard[available='false'] .deploymentProfileCardImage{
    opacity: var(--mw-opacity-disabled);
}

.deploymentProfileCardImage{
    height: 100px;
    width: 150px;
    object-fit: cover;
    border-bottom: 1px solid var(--mw-borderColor-primary);
    object-position: right top;
    background-color: var(--mw-backgroundColor-secondary);
}

.deploymentCardGallery{
    width: 100%;
}

.deploymentProfileCardDetailsRow{
    padding: 5px;
}

.deploymentProfileCardContent{
    display: table;
}

.deploymentProfileCardProfileName{
    font-size: small;
    margin-bottom: 3px;
}

/*todo make this only line clamp based on total lines name + summary*/
.deploymentProfileCardArtifactName{
    font-size: small;
    line-clamp: 1;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    width: 140px;
}

.deploymentProfileCardTarget{
    font-size: smaller;
    color: var(--mw-color-secondary);

}

.deploymentProfileCardSummary{
    font-size: smaller;
    line-clamp: 2;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    width: 140px;
}

.deploymentProfileCardProfileDetails{
    margin-bottom: 10px;
}

.deploymentProfileCardDetailRow{
    display: table-row;
    width: 100%;
}

.deploymentProfileCardDetailsRow, 
.deploymentProfileCardTable,
.deploymentProfileCardContent {
    height:100%;
}


.deploymentProfileCardImageRemovalButtonContainer{

}

.deploymentProfileCard:hover .removeDeploymentProfileCardButton{
    /* float: right;
     */
/*      display:block; */
     opacity: 1;
}


.removeDeploymentProfileCardButton{
    /* float: right; */
    top:-195px;
    left:130px;
    position:absolute;
    width:12px;
    height:14px;
    margin:1px;   
    opacity: 0;
    outline-width: 1px !important;
     background-color: var(--mw-backgroundColor-primary);
    outline-style: solid !important;
    outline-color: var(--mw-borderColor-primary) !important;
}
                        

.removeDeploymentProfileCardButton:hover{
/*     border: 1px solid var(--mw-borderColor-primary); */
    cursor: pointer;
     background-color: var(--mw-backgroundColor-input-readonly) !important;
    opacity: 1;
    
}

.removeDeploymentProfileCardButton:focus{
    outline-width: thin !important;
    outline-style: solid !important;
    outline-color: var(--mw-borderColor-focus) !important;
     background-color: var(--mw-backgroundColor-hover);
    border: 0px;
    opacity: 1;
}
    
.deploymentProfileCardProfileDetails{
    /*todo improve*/
    width: 140px;
}

/*EDITABLELABEL WIDGET*/

.deploymentEditableLabelDisplayLabel{
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /*remvoes 16pz to accoutn for the icon to the right*/
    width: calc(100% - 16px);
}

.deploymentEditableLabelDisplayLabelButton{
    width: 16px;
}

.deploymentEditableLabelEditField{
    /* margin-bottom: 2px; */
}

.deploymentEditableLabelDisplayItem{
    vertical-align: middle;
}

.deploymentEditabelLabel[mode='edit'] .deploymentEditableLabelEditField{
    display: block;
}

.deploymentEditabelLabel[mode='edit'] .deploymentEditableLabelDisplayItem{
    display: none;
}

.deploymentEditabelLabel[mode='display'] .deploymentEditableLabelEditField{
    display: none;
}

.deploymentEditabelLabel[mode='display'] .deploymentEditableLabelDisplayItem{
    display: inline-block;
}

.deploymentEditableLabelDisplayToEditArea:hover{
    outline-width: thin;
    outline-style: solid;
    outline-color: var(--mw-borderColor-hover);
    background-color: var(--mw-backgroundColor-hover);
}

.deploymentEditableLabelDisplayToEditArea:focus{
    outline-width: thin;
    outline-style: solid;
    outline-color: var(--mw-borderColor-focus);
}

.deploymentEditableLabelDisplayLabelButton{
    float: right;
}

.noCardsMessage {
    padding: 25px;
    color: var(--mw-color-secondary);
    font-size: 16px;
    font-style: italic;
}
`,"",{version:3,sources:["webpack://./../../toolbox/deployment/compiler/profile_management_gui/profile_management_gui-ui/css/main.css"],names:[],mappings:"AAAA,uCAAuC;;;AAIvC;AACA;;AAEA;IACI,WAAW;IACX,YAAY;AAChB;;AAEA;IACI,YAAY;AAChB;AACA,MAAM;AACN;IACI,gBAAgB;AACpB;;AAEA,yBAAyB;AACzB;IACI,gBAAgB;IAChB,kBAAkB;IAClB,yBAAyB;IACzB,uBAAuB;AAC3B;;AAEA;IACI,kBAAkB;IAClB,sBAAsB;IACtB,mBAAmB;AACvB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;;;GAGG;;AAEH;IACI,WAAW;AACf;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;IAChB,aAAa;IACb,iBAAiB;AACrB;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,cAAc;AAClB;;AAEA;IACI,YAAY;IACZ,WAAW;AACf;AACA,iFAAiF;AACjF;IACI,WAAW;AACf;;AAEA;IACI,aAAa;IACb,iBAAiB;IACjB,eAAe;IACf,eAAe;IACf,gBAAgB;AACpB;;AAEA;IACI,8BAA8B;IAC9B,kBAAkB;IAClB,iBAAiB;AACrB;;AAEA;IACI,YAAY;IACZ,kBAAkB;AACtB;AACA;IACI,kBAAkB;AACtB;;AAEA;IACI,cAAc;IACd,cAAc;IACd,iBAAiB;AACrB;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,cAAc;IACd,kBAAkB;IAClB,YAAY;IACZ,aAAa;IACb,iBAAiB;IACjB,iBAAiB;IACjB,mDAAmD;IACnD,YAAY;IACZ,kBAAkB;IAClB,iBAAiB;AACrB;;AAEA,qFAAqF;AACrF;IACI,WAAW;IACX,gBAAgB;AACpB;;AAEA,6DAA6D;AAC7D;IACI,gBAAgB;IAChB,6CAA6C;IAC7C,cAAc;AAClB;;AAEA;IACI,cAAc;;AAElB;AACA;IACI,cAAc;AAClB;;AAEA,gEAAgE;;AAEhE;IACI,+CAA+C;IAC/C,YAAY;IACZ,aAAa;IACb,YAAY;IACZ,kBAAkB;IAClB,qBAAqB;IACrB,eAAe;IACf,8BAA8B;IAC9B,mDAAmD;AACvD;;AAEA;IACI,yCAAyC;AAC7C;;AAEA;IACI,iDAAiD;IACjD,oCAAoC;AACxC;;AAEA;IACI;;qCAEiC;IACjC,8BAA8B;IAC9B,+CAA+C;IAC/C,mDAAmD;IACnD,eAAe;AACnB;;AAEA;IACI,mCAAmC;AACvC;;AAEA;IACI,aAAa;IACb,YAAY;IACZ,iBAAiB;IACjB,sDAAsD;IACtD,0BAA0B;IAC1B,qDAAqD;AACzD;;AAEA;IACI,WAAW;AACf;;AAEA;IACI,YAAY;AAChB;;AAEA;IACI,cAAc;AAClB;;AAEA;IACI,gBAAgB;IAChB,kBAAkB;AACtB;;AAEA,qEAAqE;AACrE;IACI,gBAAgB;IAChB,aAAa;IACb,uBAAuB;IACvB,gBAAgB;IAChB,mBAAmB;IACnB,YAAY;AAChB;;AAEA;IACI,kBAAkB;IAClB,gCAAgC;;AAEpC;;AAEA;IACI,kBAAkB;IAClB,aAAa;IACb,uBAAuB;IACvB,gBAAgB;IAChB,mBAAmB;IACnB,YAAY;AAChB;;AAEA;IACI,mBAAmB;AACvB;;AAEA;IACI,kBAAkB;IAClB,WAAW;AACf;;AAEA;;;IAGI,WAAW;AACf;;;AAGA;;AAEA;;AAEA;IACI;MACE;AACN,wBAAwB;KACnB,UAAU;AACf;;;AAGA;IACI,kBAAkB;IAClB,UAAU;IACV,UAAU;IACV,iBAAiB;IACjB,UAAU;IACV,WAAW;IACX,UAAU;IACV,UAAU;IACV,6BAA6B;KAC5B,mDAAmD;IACpD,+BAA+B;IAC/B,uDAAuD;AAC3D;;;AAGA;AACA,yDAAyD;IACrD,eAAe;KACd,qEAAqE;IACtE,UAAU;;AAEd;;AAEA;IACI,8BAA8B;IAC9B,+BAA+B;IAC/B,qDAAqD;KACpD,iDAAiD;IAClD,WAAW;IACX,UAAU;AACd;;AAEA;IACI,eAAe;IACf,YAAY;AAChB;;AAEA,uBAAuB;;AAEvB;IACI,mBAAmB;IACnB,gBAAgB;IAChB,uBAAuB;IACvB,oDAAoD;IACpD,wBAAwB;AAC5B;;AAEA;IACI,WAAW;AACf;;AAEA;IACI,wBAAwB;AAC5B;;AAEA;IACI,sBAAsB;AAC1B;;AAEA;IACI,cAAc;AAClB;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,qBAAqB;AACzB;;AAEA;IACI,mBAAmB;IACnB,oBAAoB;IACpB,0CAA0C;IAC1C,iDAAiD;AACrD;;AAEA;IACI,mBAAmB;IACnB,oBAAoB;IACpB,0CAA0C;AAC9C;;AAEA;IACI,YAAY;AAChB;;AAEA;IACI,aAAa;IACb,gCAAgC;IAChC,eAAe;IACf,kBAAkB;AACtB",sourcesContent:[`/* Copyright 2021 The MathWorks, Inc. */
@import "../../../../../deployment/common/gui/web/common_deployment_gui/common_deployment_gui-ui/css/main.css";


body {
}

.main {
    width: 100%;
    height: 100%;
}

.titlePane {
    margin: 40px;
}
/** **/
.deploymentPreamblePersistenceBox{
    margin-top: 20px;
}

/**App Gallery WORKFLOW**/
.newItemWidget{
    margin-top: 10px;
    /* width: 400px; */
    border-collapse: separate;
    border-spacing: 4px 0px;
}

.creationLabel{
    text-align: center;
    vertical-align: middle;
    white-space: nowrap;
}

.createProfileOption{
    margin-top: 20px;
}

/* .deploymentProjectSelectionWidget{
    margin-left: 40px;
    margin-top: 10px;
} */

.creationField{
    width: 100%;
}

.singleCreationWidget{
    margin-top: 35px;
}

.profileCreationWidget{
    margin-top: 25px;
}

.profilesTable{
    margin-top: 10px;
    height: 140px;
    max-height: 140px;
}

.profilesTableSection[status='empty']{
    display: none;
}

.profilesTableSection[status='nonempty']{
    display: block;
}

.profilesTableSection{
    height: 100%;
    width: 100%;
}
/** ------------------- Styling for profile selection pane ------------------- **/
.deploymentProfileManagementContainer{
    height: 96%;
}

.deploymentProfileSelectionPane{
    display: flex;
    flex-flow: column;
    min-height: 10%;
    max-height: 60%;
    overflow-y: auto;
}

.deploymentProfileSelectionPanelTitle{
    color: var(--mw-color-primary);
    font-size: x-large;
    font-weight: bold;
}

.deploymentProfileManageSection{
    margin: 10px;
    margin-bottom: 0px;
}
.deploymentProfilePanelTitle{
    margin-bottom: 5px;
}

.deploymentOpenProfilesSection[toggle='true']{
    display: block;
    flex: 0 1 auto;
    min-height: 265px;
}

.deploymentOpenProfilesSection[toggle='false']{
    display: none;
}

.deploymentCreateProfilesSection{
    flex: 1 1 auto;
    overflow-y: hidden;
    height: 100%;
    display: flex;
    flex-flow: column;
    min-height: 150px;
    background-color: var(--mw-backgroundColor-primary);
    z-index: 100;
    position: relative;
    padding-top: 10px;
}

/* Sets bottom of the gallery panel to zero height, there may still be extra border */
.deploymentTargetSelectionWidget .footerContainer{
    height: 0px;
    overflow-y: auto;
}

/**todo this is bad 35 accounts for the title  + its margin**/
.deploymentProfileSelectionPanel{
    overflow-y: auto;
    border: 1.5px solid var(--mw-color-secondary);
    border-left: 0;
}

.deploymentProfileSelectionPanelTitle{
    flex: 0 1 auto;

}
.deploymentProfileSelectionPanelContent{
    flex: 1 1 auto;
}

/** ------------------- Styling for cards ------------------- **/

.deploymentProfileCard{
    border: 1px solid var(--mw-borderColor-primary);
    width: 150px;
    height: 200px;
    margin: 10px;
    margin-bottom: 5px;
    display: inline-block;
    cursor: pointer;
    color: var(--mw-color-primary);
    background-color: var(--mw-backgroundColor-primary);
}

.deploymentProfileCard:focus{
    border-color: var(--mw-borderColor-focus);
}

.deploymentProfileCard:hover{
    background-color: var(--mw-backgroundColor-hover);
    border-color: var(--mw-border-hover);
}

.deploymentProfileCard[available='false']{
    /* background-color: var(--mw-backgroundColor-hover);
    border-color: var(--mw-border-hover);
    color: var(--mw-color-primary); */
    color: var(--mw-color-primary);
    border: 1px solid var(--mw-borderColor-primary);
    background-color: var(--mw-backgroundColor-primary);
    cursor: default;
}

.deploymentProfileCard[available='false'] .deploymentProfileCardImage{
    opacity: var(--mw-opacity-disabled);
}

.deploymentProfileCardImage{
    height: 100px;
    width: 150px;
    object-fit: cover;
    border-bottom: 1px solid var(--mw-borderColor-primary);
    object-position: right top;
    background-color: var(--mw-backgroundColor-secondary);
}

.deploymentCardGallery{
    width: 100%;
}

.deploymentProfileCardDetailsRow{
    padding: 5px;
}

.deploymentProfileCardContent{
    display: table;
}

.deploymentProfileCardProfileName{
    font-size: small;
    margin-bottom: 3px;
}

/*todo make this only line clamp based on total lines name + summary*/
.deploymentProfileCardArtifactName{
    font-size: small;
    line-clamp: 1;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    width: 140px;
}

.deploymentProfileCardTarget{
    font-size: smaller;
    color: var(--mw-color-secondary);

}

.deploymentProfileCardSummary{
    font-size: smaller;
    line-clamp: 2;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    width: 140px;
}

.deploymentProfileCardProfileDetails{
    margin-bottom: 10px;
}

.deploymentProfileCardDetailRow{
    display: table-row;
    width: 100%;
}

.deploymentProfileCardDetailsRow, 
.deploymentProfileCardTable,
.deploymentProfileCardContent {
    height:100%;
}


.deploymentProfileCardImageRemovalButtonContainer{

}

.deploymentProfileCard:hover .removeDeploymentProfileCardButton{
    /* float: right;
     */
/*      display:block; */
     opacity: 1;
}


.removeDeploymentProfileCardButton{
    /* float: right; */
    top:-195px;
    left:130px;
    position:absolute;
    width:12px;
    height:14px;
    margin:1px;   
    opacity: 0;
    outline-width: 1px !important;
     background-color: var(--mw-backgroundColor-primary);
    outline-style: solid !important;
    outline-color: var(--mw-borderColor-primary) !important;
}
                        

.removeDeploymentProfileCardButton:hover{
/*     border: 1px solid var(--mw-borderColor-primary); */
    cursor: pointer;
     background-color: var(--mw-backgroundColor-input-readonly) !important;
    opacity: 1;
    
}

.removeDeploymentProfileCardButton:focus{
    outline-width: thin !important;
    outline-style: solid !important;
    outline-color: var(--mw-borderColor-focus) !important;
     background-color: var(--mw-backgroundColor-hover);
    border: 0px;
    opacity: 1;
}
    
.deploymentProfileCardProfileDetails{
    /*todo improve*/
    width: 140px;
}

/*EDITABLELABEL WIDGET*/

.deploymentEditableLabelDisplayLabel{
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /*remvoes 16pz to accoutn for the icon to the right*/
    width: calc(100% - 16px);
}

.deploymentEditableLabelDisplayLabelButton{
    width: 16px;
}

.deploymentEditableLabelEditField{
    /* margin-bottom: 2px; */
}

.deploymentEditableLabelDisplayItem{
    vertical-align: middle;
}

.deploymentEditabelLabel[mode='edit'] .deploymentEditableLabelEditField{
    display: block;
}

.deploymentEditabelLabel[mode='edit'] .deploymentEditableLabelDisplayItem{
    display: none;
}

.deploymentEditabelLabel[mode='display'] .deploymentEditableLabelEditField{
    display: none;
}

.deploymentEditabelLabel[mode='display'] .deploymentEditableLabelDisplayItem{
    display: inline-block;
}

.deploymentEditableLabelDisplayToEditArea:hover{
    outline-width: thin;
    outline-style: solid;
    outline-color: var(--mw-borderColor-hover);
    background-color: var(--mw-backgroundColor-hover);
}

.deploymentEditableLabelDisplayToEditArea:focus{
    outline-width: thin;
    outline-style: solid;
    outline-color: var(--mw-borderColor-focus);
}

.deploymentEditableLabelDisplayLabelButton{
    float: right;
}

.noCardsMessage {
    padding: 25px;
    color: var(--mw-color-secondary);
    font-size: 16px;
    font-style: italic;
}
`],sourceRoot:""}]),h.exports=f},b1072482398147ce169c1a442bb9656ca8f8950f:(h,M,t)=>{var m=t("mwBundle.desktop-default-plugins|ed696428f59273ff5a3b9e7284cefe5b63dd4d1d"),p=t("mwBundle.desktop-default-plugins|cb47172937e548a863ab648aecddd4b09386a96d"),g=p(m);g.push([h.id,`/* Copyright 2023-2025 The MathWorks, Inc. */

#addOnsPanel .addOnListing {
    min-width: 32px;
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    text-overflow: ellipsis;
    overflow: hidden;
    height: 37px;
}

.addOnListing .imageContainer {
    width: 25px;
    display: flex;
    justify-content: flex-start;
    align-content: center;
    padding-left: 1px;
}

.addOnListing .addOnInfo {
    display: flex;
    align-items: center;
    min-width: 0;
    height: 100%;
    flex-grow: 1;
    font-size: 11px;
}

.addOnListing .mwAddOnInfoContainer {
    overflow: hidden;
    white-space: nowrap;
    padding-left: 2px;
    display: flex;
    flex-direction: column;
}
.addOnListing .addOnName {
    margin-right: 8px;
    text-overflow: ellipsis;
    align-items: center;
    padding-left: 4px;
    padding-bottom: 2px;
    color: var(--mw-color-primary);
    overflow: hidden;
    white-space: nowrap;
}
.addOnListing .authorNode {
    margin-top: -3px;
}

.addOnListing .authorNode,
.addOnListing .summaryNode,
.addOnListing .ribbons {
    padding-left: 4px;
    align-items: center;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
}

.addOnListing .authorNode,
.addOnListing .summaryNode {
    margin-right: 8px;
}

.addOnListing .ribbons {
    padding-right: 3px;
}

.addOnListing .popularityAndActionsContainer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 5px;
    height: 100%;
}

.addOnListing .authorNode, .addOnListing .mwAddOnNameAndActionZoneContainer {
    display: flex;
}

.addOnListing .addOnRatingsAndDownloads {
    display: flex;
    justify-content: space-between;
    flex-direction: row;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    padding-right: 0px;
}

.addOnListing .popularityInfoContainer {
    font-size: 11px;
    height: 22px;
    display: flex;
    position: relative;
}

mw-addons-actionzonewidget {
    right: 10px;
}

.addOnListing .downloadsContainer {
    display: flex;
    width: 40px;
}
.addOnListing .summaryNode {
    display: block;
}

.addOnListing .authorNode .authorIcon  {
    width: 16px;
    padding-right: 1px;
}

.addOnListing .authorNode .authorIcon img {
    height: 16px;
    width: 16px;;
}

.addOnListing .authorNode .authorName  {
    text-overflow: ellipsis;
    overflow: hidden;
    line-height: 1.5;
}

.addOnListing .addOnInfo.disabled, .addOnListing .addOnRating.disabled, .addOnListing .ribbons.disabled {
    opacity: 0.5;
}

.addOnListing .addOnIcon,
.addOnListing .addOnIcon img,
.addOnListing .addOnIcon svg {
    height: 24px !important;
    width: 24px !important;
}

.addOnListing .addOnIcon img {
    border: thin solid var(--mw-borderColor-secondary);
    border-radius: 5px;
}

.addOnListing .addOnIcon mw-icon {
    border: thin transparent;
}

/** Style for ratings **/

.addOnListing .addOnRating {
    display: flex;
    width: 28px;
    margin: 0;
    margin-right: 2px;
    margin-left: 5px;
}
  
.addOnListing .addOnRating-upper {
    color: var(--mw-color-primary);
    overflow: hidden;
    font-size: 10px;
    font-style: normal !important;
}

.addOnListing .addOnRating .ratings {
    padding-left: 2px;
    color: var(--mw-color-primary); 
    font-size: 9px;
}

.addOnListing .downloadsIconContainer {
    display: flex;
    padding-top: 1px;
    filter: grayscale(100%);
    fill: var(--mw-color-primary);
}

.addOnListing .downloadsNumber {
    color: var(--mw-color-primary);
    vertical-align: top;
    padding-left: 3px;
    font-size: 9px;
}

.addOnListing .ribbon {
    color: #fff;
    text-align: center;
    font-size: 0.95em;
    padding: 1px 2px;
}

.addOnListing .updateIconContainer {
    filter: grayscale(100%);
    fill: var(--mw-color-primary);
}

.addOnListing .ribbons {
    color: var(--mw-color-primary);
}

.addOnListing .updateLabel, .addOnListing .installedLabel {
    vertical-align: top;
}

.addOnListing .popularityInfoContainer .ribbons {
    width: 68px;
}

.addOnListing .hideNode {
    display: none !important;
}

mw-addons-actionzonewidget .actionButton {
    height: 22px;
    font-size: 10px;
    padding-top: 2px;
    padding-right: 3px;
}

.addOnListing .mwButton {
    border-color: var(--mw-borderColor-secondary);
}

#addOnsPanel .treeNodeData .addOnActionZone,
#addOnsPanel .treeNode .addOnActionZone{
    padding-bottom: 5px;
    font-size: 11px;
    /* height: 22px; */
}

#addOnsPanel .treeNode .addOnsKebabOptionsMenuButton,
#addOnsPanel .treeNode .addOnsSidePanelInstallButton,
#addOnsPanel .treeNode .addOnsSidePanelViewInExplorerButton,
#addOnsPanel .treeNode .addOnsSidePanelUpdateButton,
#addOnsPanel .treeNode .addOnsSidePanelDownloadButton {
    display: none;
}

#addOnsPanel .treeNode:hover .addOnsKebabOptionsMenuButton,
#addOnsPanel .treeNode:hover .addOnsSidePanelInstallButton,
#addOnsPanel .treeNode:hover .addOnsSidePanelViewInExplorerButton,
#addOnsPanel .treeNode:hover .addOnsSidePanelUpdateButton,
#addOnsPanel .treeNode:hover .addOnsSidePanelDownloadButton,
#addOnsPanel .treeNode.selected .addOnsKebabOptionsMenuButton,
#addOnsPanel .treeNode.selected .addOnsSidePanelInstallButton,
#addOnsPanel .treeNode.selected .addOnsSidePanelViewInExplorerButton,
#addOnsPanel .treeNode.selected .addOnsSidePanelUpdateButton,
#addOnsPanel .treeNode.selected .addOnsSidePanelDownloadButton {
    display: inline-block;
}

#addOnsPanel .treeNode:hover .popularityInfoContainer,
#addOnsPanel .treeNode.selected .popularityInfoContainer {
    display: none;
}

#addOnsPanel .installUninstallProgress{
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 4px;
    padding-right: 5px;
}

.addOnListing .busyIndicator{
    display: inline-block;
    vertical-align: middle;
    padding: 0 10px 0 10px;
    position: relative !important;
    width: auto !important;
}

.addOnListing .busyIndicator .underlayNode{
    background:transparent;
}

/* Kebab Menu button */
.addOnListing .addOnsKebabOptionsMenuButton {
    padding-top: 2px;
    padding-right: 3px;
}

.addOnListing .addOnsKebabOptionsMenuButton .mwButton {
    display: block;
    width: 20px;
}

.addOnListing .mwButton:hover, .addOnListing .mwButton:active {
    border: 1px solid  var(--mw-borderColor-primary);
}

#addOnsPanel .customRepositoryPlaceholder {
    min-width: 32px;
    justify-content: space-between;
    overflow: hidden;
}

#addOnsPanel .customRepositoryPlaceholderLabel {
    color: var(--mw-color-secondary);
}

#addOnsPanel .customRepositoryHeader {
    min-width: 32px;
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    text-overflow: ellipsis;
    overflow: hidden;
    height: 24px;
}

.addOnSectionHeader .customRepositoryHeaderLabel {
    font-size: 12px;
}
