                '---------------'
        
                DESCRIPTION:
            
                    Sidebar is a top-level container element which provides a tabbed
                    and grouped panel navigation experience.
            
                    Sidebar can be instantiated in one of three ways:
            
                        1. Using the Sidebar constructor
            
                            let container = document.getElementById('container');
                            const properties = {
                                placeholder: 'Dummy Text'
                            };
                            const sidebar = Sidebar(properties);
                            container.appendChild(sidebar);
            
                        2. Using the createElement API
            
                            const container = document.querySelector('#container');
                            let sidebar = document.createElement('mw-sidebar');
            
                            sidebar.placeholder = 'Dummy Text';
            
                            container.appendChild(sidebar);
            
                        3. Using HTML
            
                            <div id="container" style="width:400px;height:30px;background-color:blue">
                                <mw-sidebar></mw-sidebar>
                            </div>
            
                ATTRIBUTES:
            
                    hidden - (default: 'true') indicates whether the sidebar is shown to display its contents, or not shown to hide its contents
            
                PROPERTIES:
            
                    tabposition - (default: 'left') the region of the Sidebar in which the SidebarRail lives [ 'left' | 'right' | 'top' | 'bottom' ]
                    activecontainer - (default: '') the id for the currently active child container
                    collapsed - (default: false) true if the drawer is collapsed
                    // TODO: collapsible - (default: true) true if it should be possible to collapse the drawer
                    showpanelsgallerybutton - (default: false) true if the rail should show a meatballs button
            
                EVENTS:
            
                    sidebar_expand - emitted when the SidebarDrawer is made visible from a previously hidden state
                    sidebar_collapse - emitted when the SidebarDrawer is hidden from a previously visible state
                    sidebar_dragstart - emitted when a drag interaction is initiated for a hosted SidebarButton
                    sidebar_drop - emitted when a drop interaction is caught from a hosted SidebarRail, SidebarGroup or SidebarButton
            `}static get styles(){const u=`
                :host {
                    --mw-sidebar-rail-border-color-fallback: #000000;
                }

                :host,
                #contentRoot {
                    width: 100%;
                    height: 100%;
                    display: flex;
                }

                :host(.sidebarDragging) {
                    display: flex;
                }
                
                :host([tabposition="left"]) #contentRoot,
                :host([tabposition="right"]) #contentRoot {
                    flex-direction: row;
                }
                
                :host([tabposition="top"]) #contentRoot,
                :host([tabposition="bottom"]) #contentRoot {
                    flex-direction: column;
                }
                
                :host([tabposition="bottom"]) #contentRoot,
                :host([tabposition="right"]) #contentRoot {
                    justify-content: flex-end;
                }
                
                :host([tabposition="top"]) #beforeWrapper {
                    border-bottom-width: var(--mw-sidebar-rail-border-size, thin);
                    border-bottom-style: solid;
                    border-bottom-color: var(--mw-sidebar-rail-border-color, var(--mw-sidebar-rail-border-color-fallback));
                    flex-shrink: 0;
                }
                
                :host([tabposition="top"][collapsed]) #beforeWrapper {
                    border-bottom-width: 0;
                }
                
                :host([tabposition="left"]) #beforeWrapper {
                    border-right-width: var(--mw-sidebar-rail-border-size, thin);
                    border-right-style: solid;
                    border-right-color: var(--mw-sidebar-rail-border-color, var(--mw-sidebar-rail-border-color-fallback));
                    flex-shrink: 0;
                }
                
                :host([tabposition="left"][collapsed]) #beforeWrapper {
                    border-right-width: 0;
                }
                
                :host([tabposition="right"]) #afterWrapper {
                    border-left-width: var(--mw-sidebar-rail-border-size, thin);
                    border-left-style: solid;
                    border-left-color: var(--mw-sidebar-rail-border-color, var(--mw-sidebar-rail-border-color-fallback));
                    flex-shrink: 0;
                }
                
                :host([tabposition="right"][collapsed]) #afterWrapper {
                    border-left-width: 0;
                }
                
                :host([tabposition="bottom"][collapsed]) #afterWrapper {
                    border-top-width: 0;
                }

                .fragmentWrapper {
                    display: flex;
                }

                .vertical .${s} {
                    width: 100%;
                }
                
                .horizontal .${s} {
                    height: 100%;
                }
            `;return[super.styles,c([u])]}static get attributes(){return{role:"region",hidden:""}}static get properties(){return{tabposition:{type:String,reflect:!0,default:"left",validator:u=>["left","right","bottom","top"].includes(u)},collapsed:{type:Boolean,reflect:!0,default:!1,postSet:function(u){this._drawer&&(this._drawer.hidden=u)}},activecontainer:{type:String,reflect:!1,default:""},showpanelsgallerybutton:{type:Boolean,reflect:!0,default:!1},scope:{type:String,reflect:!1,default:""}}}constructor(){super(),this.globalTarget=n.GLOBAL_TARGET||document.defaultView}set activecontainer(u){const C=this.activecontainer;u&&this._hasContainer(u)?(this.hasUpdated&&this._showContainer(u),this.collapsed&&(this.collapsed=!1)):(this.hasUpdated&&this._hideAllContainers(),this.collapsed=!0),this._set("activecontainer",u),this.requestUpdate("activecontainer",C)}get activecontainer(){return this.get("activecontainer")}set rail(u){if(u){const C=this.rail;this.externalRail=!0,this._rail=u,this._rail.getExternalSidebar=()=>this,this.requestUpdate("rail",C)}}get rail(){return this._rail}set scope(u){const C=this._get("scope");this._set("scope",u),this._setChildScopes(),this.requestUpdate("scope",C)}get scope(){return this._get("scope")}render(){const u=this._getOrientation();if(this._contentRoot)return this._contentRoot.classList.remove("vertical"),this._contentRoot.classList.remove("horizontal"),this._contentRoot.classList.add(u),this._beforeWrapper.classList.remove(s),this._afterWrapper.classList.remove(s),this._rail.orientation=u,this._rail.showpanelsgallerybutton=this.showpanelsgallerybutton,this._drawer.orientation=u,["right","bottom"].indexOf(this.tabposition)>-1?(this._beforeWrapper.contains(this._drawer)||(this._beforeWrapper.appendChild(this._drawer),this.externalRail||this._afterWrapper.appendChild(this._rail)),this._beforeWrapper.classList.add(s)):(this._afterWrapper.contains(this._drawer)||(this.externalRail||this._beforeWrapper.appendChild(this._rail),this._afterWr