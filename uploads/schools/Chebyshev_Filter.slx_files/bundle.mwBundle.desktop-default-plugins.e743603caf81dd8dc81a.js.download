:host {
    display: inline-flex;
    font-size: 16px;
    box-sizing: border-box;
    width:100%;
    height:100%;
    --mw-whitespace-mwAlignment: normal;
}

:host .mwAlignmentLayoutWrapper {
    display: flex;
}

:host .mwAlignmentIcon {
    padding: 2px;
    align-self: stretch;
    display: flex;
    align-items: center;
}

:host .mwAlignmentText {
    padding: 2px;
    white-space: var(--mw-whitespace-mwAlignment);
    color: var(--mw-color-primary);
    font-size: 0.75em;
}

:host([verticalAlignment='top']), :host([verticalAlignment='top']) .mwAlignmentLayoutWrapper {
    align-items:flex-start;
}
:host([verticalAlignment='middle']), :host([verticalAlignment='middle']) .mwAlignmentLayoutWrapper {
    align-items:center;
}
:host([verticalAlignment='bottom']), :host([verticalAlignment='bottom']) .mwAlignmentLayoutWrapper {
    align-items:flex-end;
}

:host([iconAlignment='left']) .mwAlignmentLayoutWrapper, :host([iconAlignment='right']) .mwAlignmentLayoutWrapper {
    flex-direction: row;
}
:host([iconAlignment='top']) .mwAlignmentLayoutWrapper, :host([iconAlignment='bottom']) .mwAlignmentLayoutWrapper {
    flex-direction: column;
}
:host([iconAlignment='left']) .mwAlignmentIcon, :host([iconAlignment='top']) .mwAlignmentIcon {
    order: 0;
}
:host([iconAlignment='right']) .mwAlignmentIcon, :host([iconAlignment='bottom']) .mwAlignmentIcon {
    order: 1;
}
:host([horizontalAlignment='left']), :host([horizontalAlignment='left']) .mwAlignmentIcon {
    justify-content: left;
}
:host([horizontalAlignment='right']), :host([horizontalAlignment='right']) .mwAlignmentIcon {
    justify-content: right;
}
:host([horizontalAlignment='center']), :host([horizontalAlignment='center']) .mwAlignmentIcon {
    justify-content: center;
}
:host([horizontalAlignment='left']) .mwAlignmentText {
    text-align: left;
}
:host([horizontalAlignment='center']) .mwAlignmentText {
    text-align: center;
}
:host([horizontalAlignment='right']) .mwAlignmentText {
    text-align: right;
}

:host([iconAlignment='center']) .mwAlignmentLayoutWrapper {
    position: relative;
}
:host([iconAlignment='leftmargin']) .mwAlignmentLayoutWrapper, :host([iconAlignment='rightmargin']) .mwAlignmentLayoutWrapper {
    width: 100%;
    position: relative;
}
:host([iconAlignment='leftmargin']) .mwAlignmentLayoutWrapper{
    justify-content: flex-start;
}
:host([iconAlignment='rightmargin']) .mwAlignmentLayoutWrapper{
    justify-content: flex-end;
}
:host([iconAlignment='center']) .mwAlignmentIcon {
    position: absolute;
    inset: 0;
    justify-content: center;
}
:host([iconAlignment='leftmargin'][horizontalAlignment='center']) .mwAlignmentIcon, :host([iconAlignment='rightmargin'][horizontalAlignment='center']) .mwAlignmentIcon {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
}
:host([iconAlignment='leftmargin'][horizontalAlignment='left']) .mwAlignmentIcon {
    position: static;
    order: 0;
}
:host([iconAlignment='rightmargin'][horizontalAlignment='right']) .mwAlignmentIcon, :host([iconAlignment='rightmargin'][horizontalAlignment='left']) .mwAlignmentIcon {
    position: static;
    order: 2;
}
:host([iconAlignment='rightmargin']) .mwAlignmentText, :host([iconAlignment='leftmargin']) .mwAlignmentText {
    flex-grow: 1;
}
:host([iconAlignment='center']) .mwAlignmentText {
    z-index: 1;
