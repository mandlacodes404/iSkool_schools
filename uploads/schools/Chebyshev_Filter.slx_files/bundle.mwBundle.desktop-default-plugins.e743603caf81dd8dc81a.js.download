iDAAiD;IACjD;AACJ;;AAEA;IACI,qBAAqB;IACrB,gCAAgC;AACpC;;AAEA;IACI,2BAA2B;IAC3B,aAAa;IACb,YAAY;IACZ,qBAAqB;IACrB,gBAAgB;IAChB;AACJ;;AAEA;IACI,8BAA8B;IAC9B,eAAe;IACf,kBAAkB;IAClB,oBAAoB;IACpB,iBAAiB;IACjB,iBAAiB;IACjB,iBAAiB;IACjB,qBAAqB;IACrB,uBAAuB;IACvB,oBAAoB;IACpB,qBAAqB;IACrB,4BAA4B;IAC5B,gBAAgB;IAChB,aAAa;IACb,gBAAgB;IAChB,8BAA8B;AAClC;;AAEA;IACI,mBAAmB;IACnB,WAAW;IACX,eAAe;IACf,8BAA8B;IAC9B,gCAAgC;IAChC,WAAW;IACX,gBAAgB;IAChB,uBAAuB;AAC3B;;AAEA;IACI,eAAe;IACf,8BAA8B;IAC9B,gCAAgC;IAChC,uBAAuB;IACvB,oBAAoB;IACpB,4BAA4B;IAC5B,gBAAgB;IAChB,eAAe;AACnB;;AAEA;IACI,YAAY;IACZ,kBAAkB;AACtB;;AAEA;IACI,YAAY;AAChB;;AAEA;IACI,gBAAgB;IAChB,iBAAiB;IACjB,iBAAiB;IACjB,qBAAqB;IACrB,WAAW;AACf;;AAEA;IACI,cAAc;AAClB;;AAEA;IACI,aAAa;AACjB;AACA;;;EAGE;AACF;IACI,gBAAgB;IAChB,eAAe;IACf,kBAAkB;AACtB;;AAEA;IACI,eAAe;IACf,8BAA8B;IAC9B,qBAAqB;IACrB,uBAAuB;IACvB,oBAAoB;IACpB,qBAAqB;IACrB,4BAA4B;IAC5B,gBAAgB;IAChB,8BAA8B;AAClC;;AAEA;IACI,SAAS;AACb",sourcesContent:[`/* Copyright 2021-2024 The MathWorks, Inc. */
@import "./statusBar.css";
@import "./setupGuide.css";

body {
}

.main {
    min-width: 300px;
}

.titlePane {
    margin: 40px;
}

.deploymentLeftPageArea{
    width: 0px;
    height: 100px;
}

/* MOVED FROM GENERIC COMPILER */

.attempt{
    visibility: hidden;
}

#deployment_ui {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}


.toggleSwitch {
    height: 32px;
}

.toggleView {
    float: right;
    padding-top: 5px;
    padding-right: 5px;
}

.autoDetectDataFilesWidget {
    padding-top: 3px; 
}

/* FILE SELECTION*/


.negativeFileEntryWidget{
    padding-bottom: 8px;
    max-width: 100%;
    /* width: fit-content; */
}

.negativeFileListWidgetTable{
    max-width: 100%;
    /* width: fit-content; */
    table-layout: fixed;
    text-overflow: ellipsis;
}

hr{
    display: block;
}


/*copy button will appear inline and need a margin to clear nearby elements*/
.deploymentCopyToClipBoardButton{
    margin: 2px;
}

/*Miscellaneous spacing for rendeirng output sections in dialogs*/
/*a widget description vertical spacing, seems like it may be more useful in more areas than current use in FolderSelector */

.deploymentFolderWidgetDescription [toggle='true']{
    min-height: 20px; /* for placeholder so dialogs containign this widget can know a good height*/
    width:100%;
    display: block;
}

.deploymentFolderWidgetDescription [toggle='false']{

    display: none;
}

/*GENERAL RADIO SELECTION*/
/*following is because radio elements are by default inline-blocks, but i wanted a vertical list*/
.compilerRadioSelection>div{
    display: block;
    padding-bottom: 5px;
}

.compilerRadioSelection .mwWidget.mwCheckBox.mwTextMixin .mwTextNode{
    white-space: break-spaces;
    vertical-align: top;
    width: 90% !important;
}

.compilerRadioSelection .mwWidget.mwRadioButton.mwTextMixin .mwTextNode{
    white-space: break-spaces;
    vertical-align: top;
    width: 80% !important;
}

/* INSTALLER TYPE*/

.installerChoice{
    margin-bottom: 4px;
}

/* SWITCHABLE CONTENT PANE */
#switchingContainer {
    height: 100%;
    width: 100%;
}

.switchableContentPane {
    height: 100%;
    overflow: hidden;
}

.contentPaneWrapper {
    height: 100%;
    width: 100%;
}

#primaryContent, #secondaryContent {
    height: 100%;
    width: 100%;
}

#primaryContent[hide], #secondaryContent[hide] {
    position: absolute;
    top: -20000px;
}


/* PACKAGE DIALOG*/

.phaseTable, .PackageDialogInfoContainer, .packageDialogTableRow, .packageDialogTable, .deployingInfoTable{
    width: 50%;
}

.deployingInfoTable{
    /* border-spacing: 10px; */
    margin-top: 10px;
    margin-bottom: 10px;
    border-collapse: separate;
    
}

.packageDialogContainer{
    height: 100%;
    width: 100%;
    display: flex;
    flex-flow:column;
}

.packageDialogTableRowHigh{
    /* flex: 0 1 auto; */
}

.logWidget {
    /* flex: 1 1 auto; */
    flex-grow: 1;
    flex-shrink: 1;
  }

.logWidget{
    /* height: 100%; */
    /* width: 100%; */
}

.phaseTable{
    margin-left: 20px;
    border-spacing: 10px;
    border-collapse: separate;
}

.phaseTableContainer{
    /* width: 80%; */
}

.phaseStatusTitle[status='started']{
    cursor: pointer;
    text-decoration: underline;
}

.deployingStatus, .phaseSpinner{
    vertical-align: text-top;
}

/**format around log contents**/
.deploymentLogViewPort{
    border: 1px solid var(--mw-borderColor-primary);
    overflow-y: scroll;
    padding: 1em;
    /* width: 100%; */
    user-select: text;
}
/**
* remove extra padding so that this is placed like the other phase icons
**/
.phaseSpinner >mw-progress-indicator{
    padding: 0%;
}

/**
* phase spinner is about 17^2 
* but since it's a spinning square, it takes the diagonal (largest span) size of icon as width
* here we constrain to 17, the circle will still be entirely visible
**/
 .phaseLine{
    height: 17px;
    max-height: 17px;
    /* overflow-y: hidden; */
}

.phaseImageRow{
    height: 17px;
    float: left;
    margin-right: 5px;
}
.phaseImageRow, .phaseSpinner, .packageProgressSpinner{
    max-height: 17px;
    /* overflow: hidden; */
}

.deploymentLogViewPort[toggle='true']{
    display: block;
    /* width: 100% */
    background-color: var(--mw-backgroundColor-input);
}

.deploymentLogViewPort[toggle='true'] p {
    font-family: 'Menlo','Monaco', 'Consolas', 'DejaVu Sans Mono', monospace;
}

.deploymentLogViewPort[toggle='true'] h1 {
    color: var(--mw-color-primary);
    font-family: 'Menlo','Monaco', 'Consolas', 'DejaVu Sans Mono', monospace;
    font-weight: normal;
}

.deploymentLogViewPort[toggle='true'] .logInfo {
    color: var(--mw-color-primary);
    font-family: 'Menlo','Monaco', 'Consolas', 'DejaVu Sans Mono', monospace;
}

.deploymentLogViewPort[toggle='true'] .logWarning {
    color: var(--mw-color-matlabWarning);
}

.deploymentLogViewPort[toggle='true'] .logError {
    color: var(--mw-color-matlabErrors);
}

.deploymentLogViewPort[toggle='false']{
    display: none;
}

/** width should be at least that of the image**/
.deployingInfoImage{
    width: 146px;
    display: flex;
    flex-flow: row;
    gap: 10px;
    flex-wrap: wrap;
}

.deployingInfo{
    min-width: 150px;
    flex-flow: row;
    overflow-wrap: anywhere;
    width: 100%;
    margin-left: 10px;
    overflow-x: hidden;
    width: 90%
}

.deploymentLogViewPort{
    height: 100%;
    overflow-y: scroll;
}

.deployingLogButton{
    font-weight: bold;
}

.deployingInfoNameImage {
    font-weight: normal;
    font-size: 14px;
    max-width: 146px;
}

.deployingInfoName {
    font-weight: normal;
    font-size: 14px;
    max-width: 90%;
}

.deployingInfoVersion{
    font-size: 14px;
    text-decoration: double
}
/* Package Window */
.packageDialogDisplayTable {
    border-collapse: collapse;
    width: 100%;
    height: 100%;
    table-layout: fixed;
    word-wrap: break-word;
}

.packageDialogDisplayTable td {
    padding: 5px;
    vertical-align: middle;
    align-items: left;
    text-align: left;
}

.packageDialogTableRow {
    width: 100%
}

.packageDialogImage img{
    border: var(--mw-borderColor-primary) solid 1px;
    height: 100%;
    width: 135px;
    vertical-align: bottom;
}

.packageDialogImage{
    width: 33%;
}

.packageDialogDefaultImage img{
    width: 100%;
    height: 100%;
}

.packageDialogDefaultImage{
    width: 30%;
    height: 12%;
    vertical-align: center !important;
}

.errorDiv {
    margin-left: 10%;
    padding-top: 1%;
}

.deployingStatusInfo {
    margin-left: 10%;
    color: var(--mw-color-primary);
}


/*SETTINGS*/

/* subfolder seleciton widget for install */

.installRootColumn{
    background-color: var(--mw-backgroundColor-secondary);
    border-radius:53px;
    padding: 4px;
    color: var(--mw-color-secondary);
    width: 80px;
    align-content: center;
}

.subfolderField{
    padding-left: 2px;   
}

.subfolderSelectionWidget, .subfolderSelectionWidgetTable{
    width: 100%;
}

/*  ORIGINAL COMMON*/
/* GENERAL PAGE AND SECTION SIZING*/
#deploymentPage{
    display: flex;
    flex-flow: column;
}

.deploymentPage{
    display: flex;
    flex-flow: column;
}

.columnedPage {
    display: flex;
    flex-flow: row;
    gap: 15px;
    flex-wrap: wrap;
}

.leftColumn {
    flex: 1 1 49%;
}

.rightColumn {
    flex: 1 1 49%;
}

.uiSection{
    /* margin: 10px; */
    padding: 15px;
    padding-bottom: 20px;
    border: solid var(--mw-borderColor-primary) 1px;
    border-top: 0px;
    overflow: hidden;
}

.deploymentPane{
    overflow-y: auto !important;
}

.deploymentPage.borderContainer{
    display: flex;
    flex-flow: column;
}

/*When there is no section title pane, we can remove the padding that was added to the contained page
This is relevant to a deployment seciton place plain jane in a settings dialog. 
Padding will be already set by dialog */
.deploymentSection[showTitlePane="false"] .columnedPage{
    padding: 0px
}

.deploymentSection{
    border-spacing: 5px;
    break-inside: avoid-column;
    /* display: inline-block; */
    /* width: 100%; */
}

.deploymentSection + .deploymentSection{
    margin-top: 15px ;
}

.uiSection > .dijitFieldsetContentOuter{
    padding: 15px;
}

.deploymentSection[advanceViewIsShowing="false"],
.deploymentSection [advanceViewIsShowing="false"] {
    height: 0% !important;
    display: none;
    visibility: hidden;
}

.uiSection[collapsible="false"] .deploymentSectionToggle{
    display: none;
}

.deploymentTitleSection .uiSection{
    transition: height .5s linear;
}

.deploymentTitleSection[collapsible="true"][collapsed="true"] .uiSection{
    height: 0px;
    border: none;
    margin: 0%;
    display: none;
}

.deploymentTitleSection[collapsible="false"] .deploymentSectionToggleButton{
    display: none;
}

.deploymentTitleSection[collapsed="false"] .deploymentSectionCollapseButton{
    display: none;
}

.deploymentTitleSection[collapsed="true"] .deploymentSectionExpandButton{
    display: none;
}

/**buttons in a button bar do not need to float right, as the container will--this preserves tab order with multiple buttons**/
.deploymentSectionButtonBar .deploymentSectionButton{
    float: none;
}


.deploymentSectionToggleArrow{
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 8px solid var(--mw-color-primary);
    transition: 200ms linear transform;
    margin: 3px;
    margin-right:5px;
    float: left
}

.deploymentTitleSection[collapsed="false"] .deploymentSectionToggleArrow{
    transform: rotate(90deg);
    transition: 200ms linear transform;
}


.sectionLegend{
    background-color: var(--mw-backgroundColor-tab);
    margin: 0px;
    overflow: hidden;
    border: solid var(--mw-borderColor-primary) 1px;
    /* border: var(--mw-borderColor-primary) solid 1px;   */
}

.sectionLegend:hover{
    background-color: var(--mw-backgroundColor-hover);
    border: solid var(--mw-borderColor-hover) 1px;
}

/* .deploymentSection[collapsible="true"] .sectionLegend:hover .sectionLegendTitle{
    color: var(--mw-color-hyperlink-hover);
} */

.sectionLegendTitle[state = 'default']{
    padding: 5px 8px;
    color: var(--mw-color-primary);
}


.sectionLegend:focus{
    border: var(--mw-borderColor-focus) solid 1px;  
}

.deploymentSectionHelp:focus{
    outline: var(--mw-borderColor-focus) solid 1px;  
}


.sectionLegendTitle{}

/**todo what is this, fix this
**/
.sectionLegendTitle[state = 'help']{
    padding: 5px 8px;
    color: var(--mw-color-primary);
    width: 75%;
    display: inline-block;
}

.help-icon[state = 'default'] {
    display: none;
}
.help-icon[state = 'help'] {
    width: 16px;
    height: 16px;
    padding: 5px;
    float: right;
}

.columnedPage{
    /* width: 100%; */
    /* table-layout: fixed;
    border-collapse: separate; */
    padding: 10px 20px;
    column-width: 500px;
    column-count: 2;
    border-collapse: collapse;
}

p + p { margin-top: 10px; }

.subSectionTitle{
    margin-bottom: 10px;
    color: var(--mw-color-primary);
}


/*IMAGE SELECTOR STYLING*/
.imageSection{
    /* text-align: center; */
    /* display: flex; */
}

.imageSelector .image{
    border: 1px solid var(--mw-borderColor-primary);
}

.imageSelector{
    display: inline-block;
    max-width: 100%;
    margin-right: 10px;
    /* flex-grow: 1; */
}

.splashScreenImage{
    /* 400px x 400px*/
    width: 200px;
    height: 200px;
}

.deploymentInfoImage{
    width: 110px;
    height: 110px;
}

.iconImage{
    /* aspect-ratio: 1 / 1; */
    height: 48px;
    width: 48px;
}

.sideBarImage{
   /* aspect-ratio: 112x290 */
   width: calc((200/290) * 112px);
   height: 200px;
}

.packageSplash{
    height: 138px;
    width: 138px;
}

.deploymentWebImage{
    width: 138px;
    height: calc((138/216) * 140px);
}

.deploymentImageMessage{
    position: absolute;                    /* The button is placed absolutely within the container */
    top: 50%;                              /* Ensures that the button is centered in the middle (top/button wise) of the component */
    left: 50%;                             /* Ensures that the button is centered in the middle (left/right wise) of the component */
    transform: translate(-50%, -50%);      /* Translation ensures that the middle of the button is placed (not the corners) */
    background-color: var(--mw-backgroundColor-primary);  /* background color with transparency */
    color: var(--mw-color-primary);                          /* Font color */
    font-size: 12px;                       /* Font size of the 'Browse' text */
    padding: 5px;                         /* Specifies the size of the button compared to the text */
    cursor: pointer;                       /* Changes the cursor format when the user hovers over the button */
    border-radius: 5px;                   /* The button has curved edges */
    text-align: center;                    /* The button text is centered in the middle of the button */
    z-index: 1;                         /* Specifies the order of the button div on the component.  It is specified on top. */
    border: var(--mw-borderColor-hover) solid 1px;
}

.imageSelector:not(:focus)[toggle='false'] .deploymentImageMessage{
    opacity: 0;
}

.imageSelector[toggle='true'] .deploymentImageMessage, .imageSelector:focus .deploymentImageMessage{
    opacity: 1;
}

.imageSelector[toggle='true'] .deploymentImage, .imageSelector:focus .deploymentImage{
    opacity: 0.5;
}

.deploymentImageMessage:hover{    
    background-color: var(--mw-backgroundColor-hover);
    border-color: var(--mw-borderColor-hover);
}

.imageSelector:focus .deploymentImageMessage{
    border: var(--mw-borderColor-focus) solid 1px;  
}

.deploymentImageNodeContainer{
    background-color: var(--mw-backgroundColor-secondary);
    display: block;
    border: solid var(--mw-borderColor-secondary) 1px;
    overflow: hidden;
    max-width: 100%;
    position: relative
    
}

.deploymentImageNodeContainer[layout= 'default']{
    height:200px;
    width:200px;
}

.deploymentImageNodeContainer[layout= 'custom']{
}

.deploymentImageMessage[state='error']{
    background-color:var(--mw-backgroundColor-secondary-error);
    opacity: 1 !important;
}

.deploymentImageMessage[state='warning'] {
    background-color:var(--mw-backgroundColor-secondary-warning);
    opacity: 1 !important;
}

.deploymentImage{
    object-fit: fill;
}

.deploymentImageSizeNode{
    overflow: hidden;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.imageContainer{
    position: relative;
    text-align: center;
    /* padding: 3px; */
    display: block;
    max-width: 100%;
}

/* todo consider using label class that can be styled similarly across widgets */
.imageTypeDescription{
    border-radius: 53px;
    padding: 1px 4px;
    color: var(--mw-color-secondary);
}

/* CODE VIEW*/
.codeViewEditor {
    /* height: see CodeViewEditor.Resize func */
    width: 96%;
    overflow: hidden;
    overflow-x: hidden;
    padding: 10px 20px;
}

.codeViewBusySpinner {
    margin-top: 1px;
    margin-left: 3px;
}

.codeViewBusySpinner, .codeViewBusySpinnerBackground {
    z-index: 1 !important;
}


/* Section buttons */

.deploymentLinkButton[toggle='false']{
    display: none;
}


/* FILE SELECTION*/

.fileEntryWidget{
    background-color: var(--mw-backgroundColor-primary);
    border-radius:5px;    
    padding: 1px 4px 0px 4px;
    margin-top: 3px;
    margin-right: 5px;
    max-width: 100%;
    text-overflow: ellipsis;
    display: inline-block;
    border: var(--mw-borderColor-primary) 1px solid;
}

.fileEntryWidget:hover{
    border-color: var(--mw-borderColor-hover);
    background-color: var(--mw-backgroundColor-hover);
}

.fileEntryWidget:focus{
    border-color: var(--mw-borderColor-focus);
}

.fileEntryWidget[state='warning']{
    background-color: var(--mw-backgroundColor-secondary-warning);
}

.fileEntryWidget[state='error']{
    background-color: var(--mw-backgroundColor-secondary-error);
}

.fileEntryWidgetTable{
    /* display: inline-table; */
    max-width: 100%;
    table-layout: fixed;
    text-overflow: ellipsis;
    /* width: fit-content; */
    /* block-size: fit-content; */
}

.fileEntryWidgetTable td{
    /* vertical-align: baseline; */
    text-overflow: ellipsis;
    max-width: 100%;
    word-wrap: break-word;
    white-space: nowrap;
}

.fileEntryWidgetLabel, .fileEntryWidgetLabel .mwTextLine {
    text-overflow: ellipsis;
    max-width: 100%;
    word-wrap: break-word;
    white-space: nowrap;
}

.fileEntryWidgetLabel, .fileEntryWidgetButtonColumn .mwLabel {
    vertical-align: middle;
}

.fileEntryWidgetLabelColumn{
    text-overflow: ellipsis;
    max-width: 100%;
    width: auto;
    padding-bottom:2px; /*This keeps bottom spacing even when the remove X button is not present--the button insists on more height*/
}
.fileEntryWidgetButtomColumn{
    width: 12px;
}

.deploymentLinkButton .mwButton{
    font-size: 12px !important;
}

.supplementaryDeploymentSectionButton{
    margin-right: 5px;
}

/** gives a slight separation between file list and adjacent link buttons, or other elements**/
.fileListWidget{
    align-content: center;
    padding-right: 15px;
    margin-bottom: 5px;
}

.fileListWidget[toggle='false'], .deploymentSubSection[toggle='false'], .deploymentSectionSpace[toggle='false']{
    display: none;
}

.deploymentSectionSpace{
    height: 20px;
}

.removeDeploymentEntryButton{
    cursor: pointer;
}

.removeDeploymentEntryButton:focus{
    outline-width: thin !important;
    outline-style: solid !important;
    outline-color: var(--mw-borderColor-focus) !important;
}

/*DEPLOYMENT SECTION BUTTONS*/

.deploymentSectionButtonBar{
    float: right;
}

.deploymentSectionButtonBar[toggle='false']{
    display: none;
}

.deploymentSectionButton{
    float: right;
}


/*FILE SELECTION WIDGETS*/
.fileListPlaceHolder{
    color: var(--mw-color-secondary);
}

.hideFileListMessage{
    display:none
}

.showFileListMessage{
    display:block;
}

.deploymentFileListCustomMessage[status='warn']{
    margin-bottom: 10px;
}

.folderSelectionWidget{
    margin-top: 5px;
    width: 100%;
}

.folderSelectionButton{
    padding-left: 5px;
    width: 45px;
}

/* INFORMATION EDITOR*/
.basicInfoField{
    width: 100%;
    margin-right: 5px;
    margin-bottom: 5px;
}

::placeholder {
    color: var(--mw-color-secondary)
}

.basicInfoTable{
    width: 100%;
}

.basicInfoTable textarea {
    resize: vertical;
}

.descriptionField{
    min-height: 50px;
}

.versionColumn{
    width: 50px;
    padding-left: 5px;
}

/** -----------------------SupportPackage widget----------------------------**/
/**If no header, then show no table either**/
.deploymentSupportPackagesWidget[hasEntries = "0"]  .deploymentSupportPackagesList{
    display:none;
}

.deploymentSupportPackagesDescription{
    margin-bottom: 5px;
    color: var(--mw-color-secondary);
}

.deploymentSupportPackagesWidget{
    margin-bottom: 10px;
}

.deploymentAddonRangeConnection{
    /* !TODO */
    vertical-align: super;
    color: var(--mw-color-secondary);
}

.deploymentSupportPackageInclusionCell{
    text-align: center;
    vertical-align: middle;
    padding: 15px;
    /* best to keep checkbox cells a uniform width*/
    width: 20px;
}

.toolboxAdditionalSoftwareList{
    /* !TODO */
    /* border: 1px solid var(--mw-borderColor-primary); */
    background-color: var(tertiary);
}


.supportPackagesEntryWidget:nth-child(even) {
    background-color: var(--mw-backgroundColor-primary);
}


.supportPackagesEntryWidget {
/*     border: 1px solid var(--mw-borderColor-primary); */
    width: 100%;
/*     background-color: var(--mw-backgroundColor-secondary); */
}

.supportPackagesEntryWidget + .supportPackagesEntryWidget{
/*     border-top: 0px; */
  margin-top:5px;
}

/**internal data table should take full width of containing cell**/
.deploymentSupportPackageDataTable{
    width: 100%;
}

.deploymentSupportPackageTitle{
    color: var(--mw-color-primary);
    font-weight: bold;
}

.deploymentSupportPackageProduct{
    color: var(--mw-color-secondary);
    font-weight: bold;
}

.deploymentSupportPackageInfoLine{
    padding-top: 5px;
}

.deploymentAddonAuthor{
    /* !TODO */
    color: var(--mw-color-secondary);
}

/**Addon details to the right of the image, includes name, ver, author, url, range**/
.deploymentSupportPackageDataCell{
    padding: 5px;
    padding-left: 10px;
    width: 100%;
}

.deploymentSupportPackageImageCell{
    vertical-align: middle;
    width: 60px;
}

.deploymentSupportPackageImage{
    width: 50px;
    height: 50px;
    background-color: var(--mw-backgroundColor-secondary);
    border: 1px solid var(--mw-borderColor-primary);
    object-fit: contain;
}

.deploymentSupportPackagesDetailsCell{
    text-align: center;
    vertical-align: middle;
    padding: 15px;
    max-width: 80px;
}

.deploymentSupportPackagesList{
    border: solid var(--mw-borderColor-primary) 1px;
    background-color: var(--mw-backgroundColor-tertiary);
  
}

/* .deploymentSupportPackageThirdPartyUrl {
    cursor:pointer;
    color: var(--mw-color-hyperlink);
    text-decoration:underline;
}

deploymentSupportPackageThirdPartyUrl:hover {
    color: var(--mw-color-hyperlink-hover);
} */


/* WEB APP INFO CARD */

.previewContainer{
    margin-top: 5px;
}

.CardContainer {
    display: inline-block;
    vertical-align: top;
    width: 218px;
    height: 302px;
    background-color: var(--mw-backgroundColor-secondary-hover);
    margin-bottom: 10px;
}

/*
 Generic section of a card
 Upper section contains image
 Lower section contains the remaining properties
*/
div.CardSection {
    overflow-wrap: normal;
    border-style: solid;
    overflow: hidden;
}

div.appCardImage {
    background: center / contain no-repeat;
}

div.appCardImageSection{
    overflow: hidden;
    border-width: 1px;
    height: 140px;
    width: 216px;
    background-color: var(--mw-backgroundColor-input);
    border-color: var(--mw-borderColor-secondary)
}

div.formattedAppText {
    margin: 8px 10px 30px;
    font-family: 'Arial', sans-serif;
}

div.appCardProperties {
    border-width: 0 1px 1px 1px;
    height: 160px;
    width: 216px;
    word-wrap: break-word;
    text-align: left;
    border-color: var(--mw-borderColor-secondary)
}

.appTitle {
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-variant: normal;
    font-weight: bold;
    margin-right: 5px;
    line-height: 1.30;
    word-wrap: break-word;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0;
    margin-bottom: 0;
    color: var(--mw-color-primary);
}

span.appVersion {
    white-space: nowrap;
    float: left;
    font-size: 11px;
    font-family: Arial, sans-serif;
    color: var(--mw-color-secondary);
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}

p.appAuthor {
    font-size: 11px;
    font-family: Arial, sans-serif;
    color: var(--mw-color-secondary);
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0px;
}

div.appHeaderPanel {
    height: 55px;     
    margin-bottom: 5px;
}

div.appBodyPanel {
    height: 55px;
}

img.webAppImageContainer, img.webAppDefaultImageContainer {
    max-width: 220px;
    max-height: 140px;
    object-fit: cover;
    background-size: 100%;
    width: 100%;
}

.webAppCardShowableLine[toggle="true"]{
    display: block;
}

.webAppCardShowableLine[toggle="false"]{
    display: none;
}
/*
 Contains spacing for a single line of app properties
 (e.g. title, author, or the entire footer line)
 */
.CardPropertyLine {
    line-height: 1.5;
    margin-top: 2px;
    margin-bottom: 5px;
}

p.appSummary {
    font-size: 12px;
    font-family: Arial, sans-serif;
    word-wrap: break-word;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--mw-color-primary);
}

div.appFooter {
    margin: 0;
}
