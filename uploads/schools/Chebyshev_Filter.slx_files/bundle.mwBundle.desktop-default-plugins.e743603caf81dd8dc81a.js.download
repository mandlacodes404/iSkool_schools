mw-git-branchmanager-sharetogithub .layoutContainer {
    display: flex;
    flex-direction: column;
    gap: 15px;
    height: 100%;
}

mw-git-branchmanager-sharetogithub .gridContainer {
    display: grid;
    row-gap: 10px;
    column-gap: 10px;
    grid-template-columns: max-content auto;
    align-items: center;
}

mw-git-branchmanager-sharetogithub .col1 {
    grid-column: 1;
    user-select: none;
}

mw-git-branchmanager-sharetogithub .col2 {
    grid-column: 2;
    align-self: center;
    min-width: 250px;
}

mw-git-branchmanager-sharetogithubtokenwidget .layoutContainer {
    display: grid;
    gap: 10px;
    grid-template-columns: auto 1fr;
    align-items: center;
}

