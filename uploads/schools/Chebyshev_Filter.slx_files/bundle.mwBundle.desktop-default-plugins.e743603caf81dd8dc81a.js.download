                '---------------'

                DESCRIPTION:

                    SidebarBadge is a container element which hosts the tabs
                    and badges used for the navigation experience of panels.

                    SidebarButton will manage the creation of a SidebarBadge, but one can be manually created if desired.

                    SidebarBadge can be instantiated in one of three ways:

                        1. Using the SidebarBadge constructor

                            let container = document.getElementById('container');
                            const properties = {
                                placeholder: 'Dummy Text'
                            };
                            const sidebarBadge = SidebarBadge(properties);
                            container.appendChild(sidebarBadge);

                        2. Using the createElement API

                            const container = document.querySelector('#container');
                            let sidebarBadge = document.createElement('mw-sidebar-badge');

                            sidebarBadge.placeholder = 'Dummy Text';

                            container.appendChild(sidebarBadge);

                        3. Using HTML

                            <div id="container" style="width:400px;height:30px;background-color:blue">
                                <mw-sidebar-badge></mw-sidebar-badge>
                            </div>

                PROPERTIES:

                    state - (default: 'default') sets the color and behavior of the badge ['default', 'info', 'warning', 'error', 'success', 'progress', 'busy']
                    value - (default: 0) sets the size and content of the badge [0-10]
                            - Ignored for 'default' and 'busy' state
                            - Indicates the numeric character shown by the badge for 'info', 'warning', & 'error' state
                            - Acts as a boolean switch for a checkmark for 'success' state.  0 === 'No checkmark'; !0 === 'Checkmark'
                            - Sets the percent completion for 'progress' state
                    message - (default: '') sets the notification message for the badge, which provides context around the meaning of the state and value of the badge

                EVENTS:

                    None
            `}static get styles(){return[super.styles,c``]}static get attributes(){return{role:"status"}}static get properties(){return{state:{type:String,reflect:!0,default:"default",validator:a=>["default","info","success","warning","error","progress","busy"].includes(a)},value:{type:Number,reflect:!0,default:0,validator:a=>a>=0&&a<=10},message:{type:String,reflect:!0,default:""}}}render(){return f``}async postUpdate(){await this.updateComplete}}return g.define("mw-sidebar-badge",d)},h,M),h.exports=p},"sidebar/SidebarButton":(h,M,t)=>{"use strict";var m,p;m=[t(t.dj.r.absMids["element_core/ElementBase"]),t(t.dj.r.absMids["ui_core_utils/TypeCheck"]),t(t.dj.r.absMids["ui_core_utils/UIScope"]),t(t.dj.r.absMids["sidebar/dnd/SidebarButtonDnDController"]),t(t.dj.r.absMids["sidebar/SidebarConstants"]),t(t.dj.r.absMids["element_core/IconElement"]),t(t.dj.r.absMids["sidebar/SidebarBadge"])],p=t.dj.d(m,({ElementBase:g,html:f,css:c},d,l,a,i)=>{function e(o){return/[\u0020-\u00ff]/.test(o)&&o.length===1||/[^\u0020-\u00ff]/.test(o)&&o.length===2}const n="X";class s extends g{static get doc(){return`

                []
                []*
                
                []
                
                []*
    
                []
    
    
                ._______________.
                | // |          |
                | //*|          |
                | -- |          |
                | // |          |
                | -- |          |
                | //*|          |
                | -- |          |
                | // |          |
                |    |          |
                |    |          |
                '---------------'
        
        
                DESCRIPTION:
            
                    SidebarButton is a container element which hosts the tabs
                    and buttons used for the navigation experience of panels.
        
                    Sidebar will manage the creation/destruction of SidebarButtons, but they can be manually created if desired.
            
                    SidebarButton can be instantiated in one of three ways:
            
                        1. Using the SidebarButton constructor
            
                            let container = document.getElementById('container');
                            const properties = {
                                placeholder: 'Dummy Text'
                            };
                            const sidebarButton = SidebarButton(properties);
                            container.appendChild(sidebarButton);
            
                        2. Using the createElement API
            
                            const container = document.querySelector('#container');
                            let sidebarButton = document.createElement('mw-sidebar-button');
            
                            sidebarButton.placeholder = 'Dummy Text';
            
                            container.appendChild(sidebarButton);
            
                        3. Using HTML
            
                            <div id="container" style="width:400px;height:30px;background-color:blue">
                                <mw-sidebar-button></mw-sidebar-button>
                            </div>
            
                PROPERTIES:
            
                    orientation - (default: 'vertical') sets the fixed and free dimensions of the button [ 'vertical' | 'horizontal' ] - Positions the label
                    active - (default: false) indicates whether this button is active within its host
                    selected - (default: false) indicates whether this button is selected within its host
                    type - (default: 'global') indicates the context set id of the container child this button controls [ 'global' | 'contextual' ]
                    controls - (default: undefined) reference id for the container child controlled by this button
                    icon - (default: undefined) "mw-svg-icon" indentification value
                    text - (default: '') string or catelog reference of tooltip text
                    notification - (default: undefined) sets the color, behavior, size and content of the badge
                        Format:
