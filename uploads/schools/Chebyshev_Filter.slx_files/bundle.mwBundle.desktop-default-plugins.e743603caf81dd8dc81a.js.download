.modal-installer-dialog .mwDialogTitleBar {
    border-bottom: 0px;
}

.modal-installer-dialog .mwDialogBody {
    overflow-x: hidden !important;
    overflow-y: hidden !important;
    padding: 0px !important;   /* Override since Installer dialog should not have a scroll-bar*/
