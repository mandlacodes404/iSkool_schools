	><span class="dijitReset dijitInline dijitButtonNode"
		data-dojo-attach-event="ondijitclick:__onClick" role="presentation"
		><span class="dijitReset dijitStretch dijitButtonContents"
			data-dojo-attach-point="titleNode,focusNode"
			role="button" aria-labelledby="\${id}_label"
			><span class="dijitReset dijitInline dijitIcon" data-dojo-attach-point="iconNode"></span
			><span class="dijitReset dijitToggleButtonIconChar">&#x25CF;</span
			><span class="dijitReset dijitInline dijitButtonText"
				id="\${id}_label"
				data-dojo-attach-point="containerNode"
			></span
		></span
	></span
	><input \${!nameAttrSetting} type="\${type}" value="\${value}" class="dijitOffScreen"
		data-dojo-attach-event="onclick:_onClick"
		tabIndex="-1" aria-hidden="true" data-dojo-attach-point="valueNode"
/></span>
`},"dojo/text!dijit/form/templates/TextBox.html":h=>{h.exports=`<div class="dijit dijitReset dijitInline dijitLeft" id="widget_\${id}" role="presentation"
	><div class="dijitReset dijitInputField dijitInputContainer"
		><input class="dijitReset dijitInputInner" data-dojo-attach-point='textbox,focusNode' autocomplete="off"
			\${!nameAttrSetting} type='\${type}'
	/></div
></div>
`},"dojo/text!dijit/layout/templates/ScrollingTabController.html":h=>{h.exports=`<div class="dijitTabListContainer-\${tabPosition}" style="visibility:hidden">
	<div data-dojo-type="dijit.layout._ScrollingTabControllerMenuButton"
		 class="tabStripButton-\${tabPosition}"
		 id="\${id}_menuBtn"
		 data-dojo-props="containerId: '\${containerId}', iconClass: 'dijitTabStripMenuIcon',
					dropDownPosition: ['below-alt', 'above-alt']"
		 data-dojo-attach-point="_menuBtn" showLabel="false" title="">&#9660;</div>
	<div data-dojo-type="dijit.layout._ScrollingTabControllerButton"
		 class="tabStripButton-\${tabPosition}"
		 id="\${id}_leftBtn"
		 data-dojo-props="iconClass:'dijitTabStripSlideLeftIcon', showLabel:false, title:''"
		 data-dojo-attach-point="_leftBtn" data-dojo-attach-event="onClick: doSlideLeft">&#9664;</div>
	<div data-dojo-type="dijit.layout._ScrollingTabControllerButton"
		 class="tabStripButton-\${tabPosition}"
		 id="\${id}_rightBtn"
		 data-dojo-props="iconClass:'dijitTabStripSlideRightIcon', showLabel:false, title:''"
		 data-dojo-attach-point="_rightBtn" data-dojo-attach-event="onClick: doSlideRight">&#9654;</div>
	<div class='dijitTabListWrapper' data-dojo-attach-point='tablistWrapper'>
		<div role='tablist' data-dojo-attach-event='onkeydown:onkeydown'
			 data-dojo-attach-point='containerNode' class='nowrapTabStrip'></div>
	</div>
</div>`},"dojo/text!dijit/layout/templates/TabContainer.html":h=>{h.exports=`<div class="dijitTabContainer">
	<div class="dijitTabListWrapper" data-dojo-attach-point="tablistNode"></div>
	<div data-dojo-attach-point="tablistSpacer" class="dijitTabSpacer \${baseClass}-spacer"></div>
	<div class="dijitTabPaneWrapper \${baseClass}-container" data-dojo-attach-point="containerNode"></div>
</div>
`},"dojo/text!dijit/layout/templates/_ScrollingTabControllerButton.html":h=>{h.exports=`<div data-dojo-attach-event="ondijitclick:_onClick" class="dijitTabInnerDiv dijitTabContent dijitButtonContents"  data-dojo-attach-point="focusNode" role="button">
	<span role="presentation" class="dijitInline dijitTabStripIcon" data-dojo-attach-point="iconNode"></span>
	<span data-dojo-attach-point="containerNode,titleNode" class="dijitButtonText"></span>
</div>`},"dojo/text!dijit/layout/templates/_TabButton.html":h=>{h.exports=`<div role="presentation" data-dojo-attach-point="titleNode,innerDiv,tabContent" class="dijitTabInner dijitTabContent">
	<span role="presentation" class="dijitInline dijitIcon dijitTabButtonIcon" data-dojo-attach-point="iconNode"></span>
	<span data-dojo-attach-point='containerNode,focusNode' class='tabLabel'></span>
	<span class="dijitInline dijitTabCloseButton dijitTabCloseIcon" data-dojo-attach-point='closeNode'
		  role="presentation">
		<span data-dojo-attach-point='closeText' class='dijitTabCloseText'>[x]</span
				></span>
</div>
`},"dojo/text!dijit/templates/Dialog.html":h=>{h.exports=`<div class="dijitDialog" role="dialog" aria-labelledby="\${id}_title">
	<div data-dojo-attach-point="titleBar" class="dijitDialogTitleBar">
		<span data-dojo-attach-point="titleNode" class="dijitDialogTitle" id="\${id}_title"
				role="heading" level="1"></span>
		<span data-dojo-attach-point="closeButtonNode" class="dijitDialogCloseIcon" data-dojo-attach-event="ondijitclick: onCancel" title="\${buttonCancel}" role="button" tabindex="-1">
			<span data-dojo-attach-point="closeText" class="closeText" title="\${buttonCancel}">x</span>
		</span>
	</div>
	<div data-dojo-attach-point="containerNode" class="dijitDialogPaneContent"></div>
	\${!actionBarTemplate}
</div>

`},"dojo/text!dijit/templates/InlineEditBox.html":h=>{h.exports=`<span data-dojo-attach-point="editNode" role="presentation" class="dijitReset dijitInline dijitOffScreen"
	><span data-dojo-attach-point="editorPlaceholder"></span
	><span data-dojo-attach-point="buttonContainer"
		><button data-dojo-type="./form/Button" data-dojo-props="label: '\${buttonSave}', 'class': 'saveButton'"
			data-dojo-attach-point="saveButton" data-dojo-attach-event="onClick:save"></button
		><button data-dojo-type="./form/Button"  data-dojo-props="label: '\${buttonCancel}', 'class': 'cancelButton'"
			data-dojo-attach-point="cancelButton" data-dojo-attach-event="onClick:cancel"></button
	></span
></span>
`},"dojo/text!dijit/templates/Menu.html":h=>{h.exports=`<table class="dijit dijitMenu dijitMenuPassive dijitReset dijitMenuTable" role="menu" tabIndex="\${tabIndex}"
	   cellspacing="0">
	<tbody class="dijitReset" data-dojo-attach-point="containerNode"></tbody>
</table>
`},"dojo/text!dijit/templates/MenuItem.html":h=>{h.exports=`<tr class="dijitReset" data-dojo-attach-point="focusNode" role="menuitem" tabIndex="-1">
	<td class="dijitReset dijitMenuItemIconCell" role="presentation">
		<span role="presentation" class="dijitInline dijitIcon dijitMenuItemIcon" data-dojo-attach-point="iconNode"></span>
	</td>
	<td class="dijitReset dijitMenuItemLabel" colspan="2" data-dojo-attach-point="containerNode,textDirNode"
		role="presentation"></td>
	<td class="dijitReset dijitMenuItemAccelKey" style="display: none" data-dojo-attach-point="accelKeyNode"></td>
	<td class="dijitReset dijitMenuArrowCell" role="presentation">
		<span data-dojo-attach-point="arrowWrapper" style="visibility: hidden">
			<span class="dijitInline dijitIcon dijitMenuExpand"></span>
			<span class="dijitMenuExpandA11y">+</span>
		</span>
	</td>
</tr>
`},"dojo/text!dijit/templates/TitlePane.html":h=>{h.exports=`<div>
	<div data-dojo-attach-event="ondijitclick:_onTitleClick, onkeydown:_onTitleKey"
			class="dijitTitlePaneTitle" data-dojo-attach-point="titleBarNode" id="\${id}_titleBarNode">
		<div class="dijitTitlePaneTitleFocus" data-dojo-attach-point="focusNode">
			<span data-dojo-attach-point="arrowNode" class="dijitInline dijitArrowNode" role="presentation"></span
			><span data-dojo-attach-point="arrowNodeInner" class="dijitArrowNodeInner"></span
			><span data-dojo-attach-point="titleNode" class="dijitTitlePaneTextNode"></span>
		</div>
	</div>
	<div class="dijitTitlePaneContentOuter" data-dojo-attach-point="hideNode" role="presentation">
		<div class="dijitReset" data-dojo-attach-point="wipeNode" role="presentation">
			<div class="dijitTitlePaneContentInner" data-dojo-attach-point="containerNode" role="region" id="\${id}_pane" aria-labelledby="\${id}_titleBarNode">
				<!-- nested divs because wipeIn()/wipeOut() doesn't work right on node w/padding etc.  Put padding on inner div. -->
			</div>
		</div>
	</div>
</div>
`},"dojo/text!dijit/templates/Tooltip.html":h=>{h.exports=`<div class="dijitTooltip dijitTooltipLeft" id="dojoTooltip" data-dojo-attach-event="mouseenter:onMouseEnter,mouseleave:onMouseLeave"
	><div class="dijitTooltipConnector" data-dojo-attach-point="connectorNode"></div
	><div class="dijitTooltipContainer dijitTooltipContents" data-dojo-attach-point="containerNode" role='alert'></div
></div>
`},"dojo/text!dijit/templates/TooltipDialog.html":h=>{h.exports=`<div role="alertdialog" tabIndex="-1">
	<div class="dijitTooltipContainer" role="presentation">
		<div data-dojo-attach-point="contentsNode" class="dijitTooltipContents dijitTooltipFocusNode">
			<div data-dojo-attach-point="containerNode"></div>
			\${!actionBarTemplate}
		</div>
	</div>
	<div class="dijitTooltipConnector" role="presentation" data-dojo-attach-point="connectorNode"></div>
</div>
`},"dojo/text!dojox/layout/resources/FloatingPane.html":h=>{h.exports=`<div class="dojoxFloatingPane" id="\${id}">
	<div tabindex="0" role="button" class="dojoxFloatingPaneTitle" dojoAttachPoint="focusNode">
		<span dojoAttachPoint="closeNode" dojoAttachEvent="onclick: close" class="dojoxFloatingCloseIcon"></span>
		<span dojoAttachPoint="maxNode" dojoAttachEvent="onclick: maximize" class="dojoxFloatingMaximizeIcon">&thinsp;</span>
		<span dojoAttachPoint="restoreNode" dojoAttachEvent="onclick: _restore" class="dojoxFloatingRestoreIcon">&thinsp;</span>	
		<span dojoAttachPoint="dockNode" dojoAttachEvent="onclick: minimize" class="dojoxFloatingMinimizeIcon">&thinsp;</span>
		<span dojoAttachPoint="titleNode" class="dijitInline dijitTitleNode"></span>
	</div>
	<div dojoAttachPoint="canvas" class="dojoxFloatingPaneCanvas">
		<div dojoAttachPoint="containerNode" role="region" tabindex="-1" class="\${contentClass}">
		</div>
		<span dojoAttachPoint="resizeHandle" class="dojoxFloatingResizeHandle"></span>
	</div>
</div>
`},"dojo/text!mw-colorpicker/templates/ColorGradient.html":h=>{h.exports=`<div class="mwDisableSelection"
	><div data-dojo-attach-point='gradientNode' class="\${baseClass}SatVal"
        ><div id="gradientMarker" tabindex="0" data-dojo-attach-point='gradientMarkerNode' class="\${baseClass}Marker"
        ></div
    ></div

    ><div data-dojo-attach-point='hueNode' class="\${baseClass}Hue"
        ><div id="hueMarker" tabindex="0" data-dojo-attach-point='hueMarkerNode' class="\${baseClass}HueMarker"
        ></div
    ></div
></div>
`},"dojo/text!mw-colorpicker/templates/ColorPalette.html":h=>{h.exports=`<div class="dijitInline mwDisableSelection"
    ><span data-dojo-attach-point="titleNode" class="\${baseClass}Title">\${!title}</span
    ><table dojoAttachPoint="paletteTableNode" class="dijitPaletteTable" cellSpacing="0" cellPadding="0"
        ><tbody data-dojo-attach-point="gridNode"></tbody
    ></table
></div>`},"dojo/text!mw-colorpicker/templates/ColorPaletteSwatch.html":h=>{h.exports='<div class="dijitInline mwPaletteDiv"\n    ><div title="${title}" class="mwColorPaletteSwatch" style="background-color: ${color}" data-test-id="${color}"></div\n></div>\n'},"dojo/text!mw-colorpicker/templates/ColorPicker.html":h=>{h.exports=`<div class="mwDisableSelection" data-test-id="mwColorPicker"
	><table
		><tr
			><td
				><div class="\${baseClass}HeaderContainer"
					><span data-dojo-attach-point="titleNode" class="\${baseClass}Title"
					></span
					><div class="\${baseClass}ToggleButtonContainer"
						><div class="\${baseClass}ToggleButton" data-dojo-attach-point="standardButtonNode"
						></div
						><div class="\${baseClass}ToggleButton" data-dojo-attach-point="customButtonNode"
						></div
					></div
				></div
			></td
		></tr

		><tr
            ><td
            	><div data-dojo-attach-point="standardPickerRow"
	            	><div data-dojo-attach-point="paletteContainerNode" 
	            	><div class="\${baseClass}Palette" data-dojo-type="mw-colorpicker/ColorPalette" 
	            	data-dojo-attach-point="paletteNode" data-test-id="palette" data-dojo-props="palette: \${_parsedStandardColors}"
	            	></div
	            	></div
					><div class="\${baseClass}StylesContainer" data-dojo-attach-point="stylesContainerNode"></div
	    			><table class="\${baseClass}Middle"
	       				><tr
	            			><div class="\${baseClass}Recent" data-dojo-attach-point="recentColorsNode"
	            			data-test-id="recentColors"></div
	        			></tr
	    			></table
	    		></div
	    		><div class="\${baseClass}ViewHidden" data-dojo-attach-point="customPickerRow"
	    			><div class="\${baseClass}GradientContainer" data-dojo-attach-point="gradientContainerNode"></div
            		><div data-dojo-attach-point="spinnerContainerNode"></div
            	></div
			></td
		></tr

		><tr
			><td
				><div class="\${baseClass}Preview"
                    ><span data-dojo-attach-point="previewContainerNode"></span
                    ><div class="\${baseClass}PreviewColor" data-dojo-attach-point="previewColorNode"></div
            	></div 
            ></td
		></tr
	></table
></div>`},"dojo/text!mw-colorpicker/templates/ColorSpinner.html":h=>{h.exports=`<div class="mwDisableSelection"
    ><div
        ><div class="\${baseClass}ComboBox" data-dojo-type="mw-form/ComboBox" data-dojo-attach-point="comboBox"></div
    ></div
    ><div
        ><table
            ><tr data-dojo-attach-point="spinnersNode"
                ><td class="\${baseClass}Column"
                    ><div data-dojo-type="mw-form/Label" data-dojo-attach-point="titleNode1"
                    ></div
                    ><div class="\${baseClass}Spinner" data-dojo-type="mw-form/Spinner" data-test-id="ColorSpinner1" data-dojo-attach-point="spinnerNode1"
                    ></div
                ></td
                ><td class="\${baseClass}Column"
                    ><div data-dojo-type="mw-form/Label" data-dojo-attach-point="titleNode2"
                    ></div
                    ><div class="\${baseClass}Spinner" data-dojo-type="mw-form/Spinner" data-test-id="ColorSpinner2" data-dojo-attach-point="spinnerNode2" 
                    ></div
                ></td
                ><td class="\${baseClass}Column"
                    ><div data-dojo-type="mw-form/Label" data-dojo-attach-point="titleNode3"
                    ></div
                    ><div class="\${baseClass}Spinner" data-dojo-type="mw-form/Spinner" data-test-id="ColorSpinner3" data-dojo-attach-point="spinnerNode3" 
                    ></div>
                </td
            ></tr

            ><tr data-dojo-attach-point="hexNode" style="display: none"
                ><td class="\${baseClass}Column" colspan="3">\${_hexTitle}
                <div class="\${baseClass}TextField" data-dojo-type="mw-form/TextField" data-test-id="HexTextField" data-dojo-attach-point="hexTextField"></div
                ></td
            ></tr
        ></table
    ></div
></div>`},"dojo/text!mw-colorpicker/templates/ColorStyle.html":h=>{h.exports='<div tabindex="0" class="${baseClass}" data-dojo-attach-point="colorStyleButton" data-test-id="${value}ColorStyle"\n	><div class="${baseClass}Swatch" data-dojo-attach-point="colorStyleSwatch"></div\n	><span class="${baseClass}Label" data-dojo-attach-point="colorStyleLabel"></span\n></div>'},"dojo/text!mw-dialog-utils/floatingPaneTemplate.html":h=>{h.exports=`<div tabindex="0" class="mwNonModalDialog dojoxFloatingPane" id="\${id}">
	<div role="button" class="dojoxFloatingPaneTitle dijitDialogTitleBar" dojoAttachPoint="focusNode">
        <!--
         This template is required because the dojox Floating pane template uses onClick Event instead of ondijitclick,
         which causes some issues with Ipad. Dojo ticket for dialogs not closing on touch devices: http://bugs.dojotoolkit.org/ticket/13488
         the fix was implemented in _onDijitClickMixin() so using ondijitclick solves the problem.

         This template also groups the icons into a div so that it can be absolute positioned which
         allows it to be stacked on top of the title node. Previously long titles were overlapping
         the icons making them unclickable, z-index does not work because the buttons are floats.
         g985154
        -->
		<span style="float:left" dojoAttachPoint="titleNode" class="dijitInline dijitTitleNode dijitDialogTitle"></span>

        <div class="dojoxFloatingIconContainer">
            <span dojoAttachPoint="closeNode" dojoAttachEvent="ondijitclick: close" class="dojoxFloatingCloseIcon"></span>
            <span dojoAttachPoint="maxNode" dojoAttachEvent="ondijitclick: maximize" class="dojoxFloatingMaximizeIcon">&thinsp;</span>
            <span dojoAttachPoint="restoreNode" dojoAttachEvent="ondijitclick: _restore" class="dojoxFloatingRestoreIcon">&thinsp;</span>
            <span dojoAttachPoint="dockNode" dojoAttachEvent="ondijitclick: minimize" class="dojoxFloatingMinimizeIcon">&thinsp;</span>
        </div>
	</div>
	<div dojoAttachPoint="canvas" class="dojoxFloatingPaneCanvas">
		<div dojoAttachPoint="containerNode" role="region" tabindex="-1" class="\${contentClass}">
		</div>
		<span dojoAttachPoint="resizeHandle" class="dojoxFloatingResizeHandle"></span>
	</div>
</div>
`},"dojo/text!mw-form/templates/CheckBox.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" role="checkbox" aria-checked="false"
    ><div data-dojo-attach-point="checkBoxRadioIconNode" class="mwCheckBoxRadioIconNode"
        ><div class="mwCheckBoxRadioIconInner"></div></div
    ><div data-dojo-attach-point="textNode" class="mwTextNode"></div
></div>`},"dojo/text!mw-form/templates/CheckBoxRadioButtonMenuItem.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" aria-checked="false"
    ><div class="mwTextAndDescriptionContainerNode" data-dojo-attach-point="textAndDescriptionContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
        ><div data-dojo-attach-point="descriptionNode" class='mwDescriptionNode'></div
    ></div
    ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
    ><div class="mwOverlayNode"></div
></div>
`},"dojo/text!mw-form/templates/ComboBox.html":h=>{h.exports=`<div>
    <div class="mwComboBoxInnerContainer"><div class="mwTextFieldContainerNode" data-dojo-attach-point="textFieldContainerNode"></div><div class="mwArrowContainerNode" data-dojo-attach-point="arrowNode"><div class="mwArrowNode"></div></div></div>
</div>`},"dojo/text!mw-form/templates/DropDownButton.html":h=>{h.exports=`<div data-dojo-attach-point="contentWrapperNode" class="mwContentWrapperNode"
    ><div data-dojo-attach-point="focusNode" class="mwFocusNode"  role="button" aria-haspopup="true"
          aria-expanded="false"
        ><div data-dojo-attach-point="buttonNode" class="mwButtonNode"
            ><div data-dojo-attach-point="buttonAlignmentNode" class="mwButtonAlignmentNode"></div
            ><div data-dojo-attach-point="buttonContainerNode" class="mwButtonContainerNode"
                ><div data-dojo-attach-point="iconNode" class="mwIconNode"></div
                ><div data-dojo-attach-point="textNode" class="mwTextNode mwBlockTextNode"
                    ><div data-dojo-attach-point="textLine" class="mwTextContentNode"></div
                ></div
            ></div
        ></div
        ><div data-dojo-attach-point="dropDownNode" class="mwDropDownNode"
            ><div data-dojo-attach-point="dropDownAlignmentNode" class="mwDropDownAlignmentNode"></div
            ><div data-dojo-attach-point="dropDownContainerNode" class="mwDropDownContainerNode"
                ><div data-dojo-attach-point="inlineTextNode" class="mwTextNode mwInlineTextNode"
                    ><div data-dojo-attach-point="inlineTextLine" class="mwTextContentNode"></div
                ></div
                ><div data-dojo-attach-point="arrowNode" class="mwArrowNode"
                    ><div data-dojo-attach-point="lastTextLineNode" class="mwLastTextLineNode"
                        ><div data-dojo-attach-point="lastTextLine" class="mwTextContentNode"></div
                    ></div
                    ><div data-dojo-attach-point="arrowIconNode" class="mwArrowIconNode"></div
                ></div
            ></div
        ></div
    ></div
></div>`},"dojo/text!mw-form/templates/Label.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode"
    ><div data-dojo-attach-point="contentWrapperNode" class="mwContentWrapperNode"
        ><div data-dojo-attach-point="iconAndTextContainerNode" class="mwIconAndTextContainerNode mwAlignmentNode"
            ><div data-dojo-attach-point="iconNode" class="mwIconNode"></div
            ><div data-dojo-attach-point="textNode" class="mwTextNode"></div
        ></div
    ></div
></div>`},"dojo/text!mw-form/templates/ListBox.html":h=>{h.exports='<div data-dojo-attach-point="focusNode"><ul data-dojo-attach-point="containerNode"></ul></div>'},"dojo/text!mw-form/templates/Menu.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" tabindex="0" role="menu" data-focus="temporary"></div>
`},"dojo/text!mw-form/templates/MenuHeader.html":h=>{h.exports=`<div data-dojo-attach-point="textNode" data-refuse-key-nav="true"></div>
`},"dojo/text!mw-form/templates/MenuItem.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" role="menuitem"
        ><div class="mwIconNode" data-dojo-attach-point="iconNode"></div
        ><div class="mwTextAndDescriptionContainerNode" data-dojo-attach-point="textAndDescriptionContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
        ><div data-dojo-attach-point="descriptionNode" class='mwDescriptionNode'></div
    ></div
    ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
></div>`},"dojo/text!mw-form/templates/MenuPanel.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" tabindex="0"></div>
`},"dojo/text!mw-form/templates/MenuSeparator.html":h=>{h.exports=`<div data-refuse-key-nav="true"></div>
`},"dojo/text!mw-form/templates/PopupMenuItem.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" class="mwFocusNode" role="menuitem" aria-haspopup="true" aria-expanded="false"
    ><div class="mwIconNode" data-dojo-attach-point="iconNode"></div
    ><div class="mwTextAndDescriptionContainerNode" data-dojo-attach-point="textAndDescriptionContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
        ><div data-dojo-attach-point="descriptionNode" class='mwDescriptionNode'></div
    ></div
    ><div class="mwShortcutAndArrowWrapperNode"
        ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
        ><div class="mwMenuArrowNode"  data-dojo-attach-point="menuArrowNode"></div
    ></div
></div>
`},"dojo/text!mw-form/templates/PushButton.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" role="button"
    ><div data-dojo-attach-point="contentWrapperNode" class="mwContentWrapperNode"
        ><div data-dojo-attach-point="iconAndTextContainerNode" class="mwIconAndTextContainerNode mwAlignmentNode"
            ><div data-dojo-attach-point="iconNode" class="mwIconNode"></div
            ><div data-dojo-attach-point="textNode" class="mwTextNode"></div
        ></div
    ></div
></div>`},"dojo/text!mw-form/templates/RadioButton.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" role="radio" aria-checked="false"
    ><div data-dojo-attach-point="checkBoxRadioIconNode" class="mwCheckBoxRadioIconNode"
        ><div class="mwCheckBoxRadioIconInner"></div></div
    ><div data-dojo-attach-point="textNode" class="mwTextNode"></div
></div>`},"dojo/text!mw-form/templates/Spinner.html":h=>{h.exports=`<div
    ><div class = "mwContainerNode" data-dojo-attach-point="containerNode"></div
    ><div class = "mwButtonsContainer" data-dojo-attach-point="buttonsContainerNode"
        ><div class = "mwIncrementButtonWrapper" data-dojo-attach-point="incrementButtonNodeWrapper"
            ><div class = "mwIncrementButtonNode" data-dojo-attach-point="incrementButtonNode"
            ></div
        ></div
        ><div class = "mwDecrementButtonWrapper" data-dojo-attach-point="decrementButtonNodeWrapper"
            ><div class = "mwDecrementButtonNode" data-dojo-attach-point="decrementButtonNode"
            ></div
        ></div
    ></div
></div>`},"dojo/text!mw-form/templates/TextArea.html":h=>{h.exports='<div><textarea class="mwInputNode mwAlignmentNode" data-dojo-attach-point="inputNode,focusNode" spellcheck="false"></textarea></div>'},"dojo/text!mw-form/templates/TextField.html":h=>{h.exports='<div><input class= "mwInputNode mwAlignmentNode" spellcheck="false" type="text" data-dojo-attach-point="inputNode,focusNode"></div>'},"dojo/text!mw-form/templates/TextFieldMenuItem.html":h=>{h.exports=`<div data-dojo-attach-point="focusNode" role="menuitem"
    ><div class="mwTextContainer" data-dojo-attach-point="textContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
    ></div
    ><div class="mwTextFieldWrapperNode" data-dojo-attach-point="textFieldWrapperNode"></div
    ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
></div>
