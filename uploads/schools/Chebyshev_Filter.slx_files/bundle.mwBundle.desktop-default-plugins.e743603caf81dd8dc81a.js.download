@import "./AddOnWidget.css";

@import "./sidepanel.css";

@import "./ApplicationContainer.css";

@import "./InstallerDialog.css";

@import "./LicenseAgreementDialog.css";

@import "./NewGRBanner.css";

@import "./CheckForUpdatesBanner.css";

@import "./WelcomePopout.css";`],sourceRoot:""}]),h.exports=n},a859cb0b324e1159cd2f4e891da37958167e2767:(h,M,t)=>{var m=t("mwBundle.desktop-default-plugins|ed696428f59273ff5a3b9e7284cefe5b63dd4d1d"),p=t("mwBundle.desktop-default-plugins|cb47172937e548a863ab648aecddd4b09386a96d"),g=p(m);g.push([h.id,`/* Copyright 2022-2025 The MathWorks, Inc. */

#addOnsPanel {
    overflow: hidden;
}

#addOnsPanel mw-fsui-subpanel {
    overflow: hidden;
}

#addOnsPanel .mw-treeNode-renderer-container {
    width: 100%;
}

#addOnsPanel .hideDomNode {
    display: none !important;
}

#addOnsPanel .addOnsSearch {
    display: flex;
    align-items: center;
}

#addOnsPanel .addOnsSearchTextField {
    height: 24px;
    display: flex;
    padding: 5px;
    flex-grow: 1;
}

#addOnsPanel .addOnsSearch mw-button {
    padding: 2px;
}

#addOnsPanel .addOnsSearch mw-button button {
    padding: 2px 2px 0 2px;
}

#addOnsPanel .addOnsView {
    height: 100%;
    display: flex;
    align-items: stretch;
    flex-direction: column;
}

#addOnsPanel .tree {
    max-width: 100%;
}

#addOnsPanel .mwSearchTextField {
    width: 100%;
}

#addOnsPanel .MLUpdateIcon {
    padding: 0px 1px;
}

#addOnsPanel .parentNode {
    margin-left: 0px !important;
}

#addOnsPanel .parentNode .treeNodeData {
    margin-left: 10px !important;
}

#addOnsPanel mw-addons-installedsection,
#addOnsPanel mw-addons-customrepositorysection,
#addOnsPanel mw-addons-recommendedsection,
#addOnsPanel mw-addons-searchresultssection,
#addOnsPanel .dijitTitlePaneContentOuter,
#addOnsPanel .dijitReset,
#addOnsPanel .dijitTitlePaneContentInner,
#addOnsPanel mw-addons-installedsection .mw-tree.treeContainer,
#addOnsPanel mw-addons-customrepositorysection .mw-tree.treeContainer,
#addOnsPanel mw-addons-recommendedsection .mw-tree.treeContainer,
#addOnsPanel mw-addons-searchresultssection .mw-tree.treeContainer  {
    height: 100%;
    overflow-y: hidden;
}

#addOnsPanel mw-addons-searchresultssection,
#addOnsPanel mw-addons-installedsection {
    /* Take up all available space */
    flex: 1;
}

#addOnsPanel .addOnsTextMessage{
    color: var(--mw-color-secondary);
}

#addOnsPanel mw-addons-recommendedsection,
#addOnsPanel mw-addons-installedsection,
#addOnsPanel mw-addons-customrepositorysection,
#addOnsPanel mw-addons-searchresultssection {
    display: flex;
    flex-direction: column;
    position: relative;
}

#addOnsPanel .addons-treeContainer{
    display: flex;
    flex-direction: column;
    flex: 1;
    height: 100%;
    overflow-y: hidden;
}

#addOnsPanel .viewMoreNode {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    background: var(--mw-backgroundColor-primary);
    margin: 4px;
}

#addOnsPanel .viewMoreExternalLink {
    cursor: pointer;
    color: var(--mw-color-hyperlink);
    font-size: 12px;
    user-select: none;
}
#addOnsPanel .viewMoreNode .viewMoreExternalLink:hover,
#addOnsPanel .viewMoreNode .viewMoreExternalLink:focus {
    text-decoration: underline;
}

#addOnsPanel .mw-tree-scroll-component{
    overflow-x:hidden;
}

#addOnsPanel .dijitTitlePaneFocused .dijitTitlePaneTitleFocus:focus .dijitTitlePaneTextNode {
    text-decoration: underline;
}

/* Filter Panel*/

.addOnsSidePanelFilterContent{
    display: flex;
    flex-direction: column;
    overflow:auto;
}

.addOnsSidePanelFilterContent .filterSubsection{
    display: flex;
    flex-direction: column;
    overflow: auto;
    margin: 2px;
}
.addOnsSidePanelFilterContent .filterSubsection mw-label {
    margin-left: 3px;
}

.addOnsSidePanelFilterContent .filterSubsection mw-checkbox {
    margin-top: 4px;
    margin-left: 10px;
}

.addons-section-message-container {
    display: flex;
    flex-direction: column;
    text-align: center;
    flex: 1; /* We want this to take up all available space so that viewModeNode is forced to the bottom of the section */
    margin: 2px 0;
}

.search-results-message-container #addons-search-section-inline-viewmore {
    position: unset;
    bottom: unset;
    border: 0;
}

#addOnsPanel .hyperlink {
    color: var(--mw-color-hyperlink);
    cursor: pointer;
}

#addOnsPanel .addOnsSearchFilterButton {
    --mw-borderBottomWidth-button: 1px;
    --mw-borderTopWidth-button: 1px;
    --mw-borderRightWidth-button: 1px;
    --mw-borderLeftWidth-button: 1px;
    --mw-borderColor-button: transparent;
    --mw-cursor-button: pointer;
    --mw-focussedBorderColor-button: var(--mw-borderColor-focus);
    --mw-hoverBorderColor-button: var(--mw-borderColor-hover);
}

/* Do not display sub-panel header for search results section*/
#addOnsPanel #search-results .dijitTitlePaneTitle {
    display: none !important;
}
`,"",{version:3,sources:["webpack://./../../toolbox/matlab/addons_sidepanel/addonssidepanel-ui/css/sidepanel.css"],names:[],mappings:"AAAA,4CAA4C;;AAE5C;IACI,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,WAAW;AACf;;AAEA;IACI,wBAAwB;AAC5B;;AAEA;IACI,aAAa;IACb,mBAAmB;AACvB;;AAEA;IACI,YAAY;IACZ,aAAa;IACb,YAAY;IACZ,YAAY;AAChB;;AAEA;IACI,YAAY;AAChB;;AAEA;IACI,sBAAsB;AAC1B;;AAEA;IACI,YAAY;IACZ,aAAa;IACb,oBAAoB;IACpB,sBAAsB;AAC1B;;AAEA;IACI,eAAe;AACnB;;AAEA;IACI,WAAW;AACf;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,2BAA2B;AAC/B;;AAEA;IACI,4BAA4B;AAChC;;AAEA;;;;;;;;;;;IAWI,YAAY;IACZ,kBAAkB;AACtB;;AAEA;;IAEI,gCAAgC;IAChC,OAAO;AACX;;AAEA;IACI,gCAAgC;AACpC;;AAEA;;;;IAII,aAAa;IACb,sBAAsB;IACtB,kBAAkB;AACtB;;AAEA;IACI,aAAa;IACb,sBAAsB;IACtB,OAAO;IACP,YAAY;IACZ,kBAAkB;AACtB;;AAEA;IACI,aAAa;IACb,mBAAmB;IACnB,yBAAyB;IACzB,6CAA6C;IAC7C,WAAW;AACf;;AAEA;IACI,eAAe;IACf,gCAAgC;IAChC,eAAe;IACf,iBAAiB;AACrB;AACA;;IAEI,0BAA0B;AAC9B;;AAEA;IACI,iBAAiB;AACrB;;AAEA;IACI,0BAA0B;AAC9B;;AAEA,gBAAgB;;AAEhB;IACI,aAAa;IACb,sBAAsB;IACtB,aAAa;AACjB;;AAEA;IACI,aAAa;IACb,sBAAsB;IACtB,cAAc;IACd,WAAW;AACf;AACA;IACI,gBAAgB;AACpB;;AAEA;IACI,eAAe;IACf,iBAAiB;AACrB;;AAEA;IACI,aAAa;IACb,sBAAsB;IACtB,kBAAkB;IAClB,OAAO,EAAE,4GAA4G;IACrH,aAAa;AACjB;;AAEA;IACI,eAAe;IACf,aAAa;IACb,SAAS;AACb;;AAEA;IACI,gCAAgC;IAChC,eAAe;AACnB;;AAEA;IACI,kCAAkC;IAClC,+BAA+B;IAC/B,iCAAiC;IACjC,gCAAgC;IAChC,oCAAoC;IACpC,2BAA2B;IAC3B,4DAA4D;IAC5D,yDAAyD;AAC7D;;AAEA,8DAA8D;AAC9D;IACI,wBAAwB;AAC5B",sourcesContent:[`/* Copyright 2022-2025 The MathWorks, Inc. */

