.git-branchmanager {
    /* Provide default fonts.
     * There are currently no semantic variables for fonts.
     */
    font-family: Helvetica, Arial, sans-serif;
    font-size: 12px;
    color: var(--mw-color-primary);
}

.git-branchmanager a {
    cursor: pointer;
    color: var(--mw-color-hyperlink);
}

.git-branchmanager a:hover {
    color: var(--mw-color-hyperlink-hover);
    text-decoration: underline;
}

.git-branchmanager .emptyList {
    margin: 10px;
    text-align: center;
}`,"",{version:3,sources:["webpack://./../../toolbox/shared/cmlink/view/git_web/cmlink-git-lib/css/branchManager.css"],names:[],mappings:"AAAA,4CAA4C;;;AAuB5C;IACI;;MAEE;IACF,yCAAyC;IACzC,eAAe;IACf,8BAA8B;AAClC;;AAEA;IACI,eAAe;IACf,gCAAgC;AACpC;;AAEA;IACI,sCAAsC;IACtC,0BAA0B;AAC9B;;AAEA;IACI,YAAY;IACZ,kBAAkB;AACtB",sourcesContent:[`/* Copyright 2022-2024 The MathWorks, Inc. */

