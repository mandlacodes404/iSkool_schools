mw-git-branchmanager-committree .mw-table-component .mw-table-inner-wrapper,
mw-git-branchmanager-committree .mw-table-component .mw-table-cell-background {
    background: var(--mw-backgroundColor-primary);
}

mw-git-branchmanager-committree .mw-table-component .mw-table-outer-wrapper,
mw-git-branchmanager-committree .mw-table-component .mw-table-outer-wrapper-blurred {
    /* Override the border of mw-table, as it makes the commit graph border look thicker
     * than all the borders of the other panes. */
    border: 0;
}

mw-git-branchmanager-committree .git-committree-renderer {
    display: flex;
    gap: 5px;
    align-items: flex-start;
}
