uC81D\uD2B8 \uC0AC\uC6A9\uC790\uC640 \uACF5\uC720\uD558\uB824\uB294 \uC815\uBCF4\uB97C \uD3EC\uD568\uC2DC\uD0B5\uB2C8\uB2E4.",SetupProjectPathDescription:`\uACBD\uB85C\uC5D0 \uD504\uB85C\uC81D\uD2B8 \uD3F4\uB354\uB97C \uCD94\uAC00\uD558\uBA74 \uD30C\uC77C\uACFC \uC791\uC5C5\uC744 \uC2E4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.

[\uD3F4\uB354 \uCD94\uAC00]\uB97C \uD074\uB9AD\uD569\uB2C8\uB2E4. \uADF8\uB7F0 \uB2E4\uC74C, \uACBD\uB85C\uC5D0 \uCD94\uAC00\uD560 \uD3F4\uB354\uB97C \uCC3E\uC544 \uC120\uD0DD\uD569\uB2C8\uB2E4.`,SetupSkipButton:"\uAC74\uB108\uB6F0\uAE30",SetupStartupShutdownDescription:`\uC2DC\uC791 \uD30C\uC77C\uACFC \uC885\uB8CC \uD30C\uC77C\uC744 \uCD94\uAC00\uD558\uBA74 \uD504\uB85C\uC81D\uD2B8 \uC124\uC815 \uBC0F \uD574\uC81C\uB97C \uC790\uB3D9\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC2DC\uC791 \uD30C\uC77C\uC740 \uD504\uB85C\uC81D\uD2B8\uAC00 \uC5F4\uB9B4 \uB54C \uC2E4\uD589\uB429\uB2C8\uB2E4. \uC885\uB8CC \uD30C\uC77C\uC740 \uD504\uB85C\uC81D\uD2B8\uAC00 \uB2EB\uD790 \uB54C \uC2E4\uD589\uB429\uB2C8\uB2E4.

[\uCD94\uAC00]\uB97C \uD074\uB9AD\uD569\uB2C8\uB2E4. \uADF8\uB7F0 \uB2E4\uC74C, \uC2DC\uC791 \uBC0F \uC885\uB8CC \uC2DC \uC2E4\uD589\uD560 \uD30C\uC77C\uC744 \uCC3E\uC544 \uC120\uD0DD\uD569\uB2C8\uB2E4.

[\uC704\uB85C \uC774\uB3D9] \uBC84\uD2BC\uACFC [\uC544\uB798\uB85C \uC774\uB3D9] \uBC84\uD2BC\uC744 \uC0AC\uC6A9\uD558\uC5EC \uC791\uC5C5\uC774 \uC2E4\uD589\uB418\uB294 \uC21C\uC11C\uB97C \uC9C0\uC815\uD569\uB2C8\uB2E4.`,SetupTitle:"${0}/${1}\uB2E8\uACC4",ShortcutAlertDialogTitle:"MATLAB \uD504\uB85C\uC81D\uD2B8",ShortcutAllFilesDescription:"\uBAA8\uB4E0 \uD30C\uC77C",ShortcutChangeIconButton:"\uBCC0\uACBD",ShortcutFailure:"\uB2E4\uC74C \uC624\uB958\uB85C \uC778\uD574 \uBC14\uB85C \uAC00\uAE30 ${0}\uC744(\uB97C) \uC2E4\uD589\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4:\n\n${1}",ShortcutFile:"\uD30C\uC77C",ShortcutFileSelectionTitle:"\uD30C\uC77C \uC120\uD0DD",ShortcutGroup:"\uADF8\uB8F9",ShortcutGroupNameWithProject:"${0}: ${1}",ShortcutIcon:"\uC544\uC774\uCF58",ShortcutIconFilesDescription:"\uC544\uC774\uCF58 \uD30C\uC77C",ShortcutIconSelectionTitle:"\uC544\uC774\uCF58 \uC120\uD0DD",ShortcutInvalidFile:"\uC9C0\uC815\uD55C \uD30C\uC77C\uC740 \uD504\uB85C\uC81D\uD2B8 \uD30C\uC77C\uC774 \uC544\uB2D9\uB2C8\uB2E4.",ShortcutInvalidIcon:"No image found in the file ${0}.",ShortcutName:"\uC774\uB984",ShortcutNoFileSelected:"\uC120\uD0DD\uD55C \uD30C\uC77C \uC5C6\uC74C",ShortcutProject:"\uD504\uB85C\uC81D\uD2B8",ShortcutSelectFileButton:"\uCC3E\uC544\uBCF4\uAE30",ShortcutTitleEdit:"\uBC14\uB85C \uAC00\uAE30 \uD3B8\uC9D1",ShortcutTitleNew:"\uBC14\uB85C \uAC00\uAE30 \uB9CC\uB4E4\uAE30",ShortcutTooltip:"\uD504\uB85C\uC81D\uD2B8 \uBC14\uB85C \uAC00\uAE30",ShortcutUseDefaultIcon:"\uB514\uD3F4\uD2B8 \uAC12 \uC0AC\uC6A9",ShutdownFiles:"\uC885\uB8CC \uD30C\uC77C:",ShutdownTooltip:"\uC885\uB8CC \uC2DC \uC2E4\uD589",StartupFiles:"\uC2DC\uC791 \uD30C\uC77C:",StartupShutdownAddButton:"\uCD94\uAC00",StartupShutdownDescription:"\uB2E4\uC74C \uD504\uB85C\uC81D\uD2B8 \uD30C\uC77C\uC740 \uD504\uB85C\uC81D\uD2B8 \uC2DC\uC791 \uBC0F \uC885\uB8CC \uC2DC\uC5D0 \uC2E4\uD589\uB429\uB2C8\uB2E4. MATLAB \uC2A4\uD06C\uB9BD\uD2B8\uB97C \uC2E4\uD589\uD558\uAC70\uB098 Simulink \uBAA8\uB378\uC744 \uC5F4\uAC70\uB098 MAT \uD30C\uC77C\uC744 \uBD88\uB7EC\uC624\uAE30 \uC704\uD55C \uC2DC\uC791 \uBC0F \uC885\uB8CC \uC791\uC5C5\uC744 \uCD94\uAC00\uD569\uB2C8\uB2E4.",StartupShutdownDownButton:"\uC544\uB798\uB85C \uC774\uB3D9",StartupShutdownMissingFileError:"\uC2DC\uC791 \uD30C\uC77C\uACFC \uC885\uB8CC \uD30C\uC77C\uC740 \uC874\uC7AC\uD558\uC9C0 \uC54A\uAE30 \uB54C\uBB38\uC5D0 \uC5C5\uB370\uC774\uD2B8\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4:\n${0}",StartupShutdownName:"\uC791\uC5C5 \uC790\uB3D9\uD654",StartupShutdownRemoveButton:"\uC81C\uAC70",StartupShutdownUpButton:"\uC704\uB85C \uC774\uB3D9",StartupTooltip:"\uC2DC\uC791 \uC2DC \uC2E4\uD589",UnableToWatchProject:"\uD504\uB85C\uC81D\uD2B8 \uD30C\uC77C\uC744 \uAD00\uCC30\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD30C\uC77C \uBCC0\uACBD \uB0B4\uC6A9\uC774 \uD504\uB85C\uC81D\uD2B8 \uD328\uB110\uC5D0 \uBC18\uC601\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.",VirtualEnvironmentCheckBoxLabel:"\uAC00\uC0C1 \uD658\uACBD \uD65C\uC131\uD654",VirtualEnvironmentDescription:`\uD504\uB85C\uC81D\uD2B8 \uC2DC\uC791 \uC2DC \uC885\uC18D \uD56D\uBAA9\uC73C\uB85C \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC740 \uD328\uD0A4\uC9C0\uB97C \uC81C\uAC70\uD558\uACE0 \uD504\uB85C\uC81D\uD2B8 \uC885\uB8CC \uC2DC \uD328\uD0A4\uC9C0\uB97C \uBCF5\uC6D0\uD569\uB2C8\uB2E4.
