mw-addons-welcome-popout {
    overflow-x: hidden;
    overflow-y: auto;
    background: var(--mw-backgroundColor-primary);
}
mw-addons-welcome-popout .mw-popout-container {
    display: flex;
    flex-direction: column;
    overflow: visible;
    max-height: 100%;
}


mw-addons-welcome-popout .tippy-box {
    overflow: visible;
    max-width: 100%;
    max-height: 100%;
}

mw-addons-welcome-popout .welcomePopoutContent {
    display: flex;
    align-items: center;
    padding: 5px;
}

mw-addons-welcome-popout .welcomePopoutContent mw-icon {
    padding: 3px;
    margin-right: 10px;
}

mw-addons-welcome-popout .welcomePopoutContent #welcome-popout-label {
    display: flex;
    flex-direction: column;
}

mw-addons-welcome-popout .welcomePopoutContent #welcome-popout-label .header-text {
    cursor: text;
    margin-bottom: 10px !important;
    display: block;
}

mw-addons-welcome-popout .welcomePopoutContent #welcome-popout-label .no-show-text {
    display: flex;
    align-items: center;
}`,"",{version:3,sources:["webpack://./../../toolbox/matlab/addons_sidepanel/addonssidepanel-ui/css/WelcomePopout.css"],names:[],mappings:"AAAA,uCAAuC;;AAEvC;IACI,kBAAkB;IAClB,gBAAgB;IAChB,6CAA6C;AACjD;AACA;IACI,aAAa;IACb,sBAAsB;IACtB,iBAAiB;IACjB,gBAAgB;AACpB;;;AAGA;IACI,iBAAiB;IACjB,eAAe;IACf,gBAAgB;AACpB;;AAEA;IACI,aAAa;IACb,mBAAmB;IACnB,YAAY;AAChB;;AAEA;IACI,YAAY;IACZ,kBAAkB;AACtB;;AAEA;IACI,aAAa;IACb,sBAAsB;AAC1B;;AAEA;IACI,YAAY;IACZ,8BAA8B;IAC9B,cAAc;AAClB;;AAEA;IACI,aAAa;IACb,mBAAmB;AACvB",sourcesContent:[`/* Copyright 2024 The MathWorks, Inc. */

