* All images in the RTC HTML representation of the description have the class "imageNode".
* When placed in a container that is less wide than the image itself, the image gets cut off
* instead of resizing to equal the width of the container. This causes issues when displaying images
* in the problem description in the Grader side panel, which tends to be fairly narrow.
* Setting max-width to 100% of the container, this will shrink the width of the image to equal the
* width of the parent container IF the container is less wide than the image. If the parent container
* is wider than the image, then the image retains its default width. Setting height to auto enables
* the image to keep its proportions when the width shrinks (otherwise the image gets shrunk width
* wise but it keeps its height constant). We need to use important for height since RTC sets the
* height in pixels directly in the markup.
*/
.graderPanel-richTextContent img {
    max-width: 100%;
    height: auto !important;
    cursor: zoom-in;
}

/**
* Temporary fix: LaTeX equations are exported out of the RTC editor as images with black text. In
* dark mode, we need these LaTeX equations to show up as having white text. We can't apply CSS to
* change the font color since the equations are images and not text. We instead need to use an image
* filter to invert the colors completely (i.e change black -> white and vice versa).
* note: we're targeting all images without the .imageNode class since actual images which are
* included in the rich text content have this class, and we don't want to invert actual images.
* note: we've noticed with the RTC upgrade that even the LaTeX equation images were getting the
* imageNode class, so we need a fallback to look for images with height=18 (how tall all the
* equations are) and adding this same filter.
*/
body.mw-theme-dark .graderPanel-richTextContent img:not(.imageNode) {
    filter: invert(1) hue-rotate(180deg);
}
body.mw-theme-dark .graderPanel-richTextContent img[height="18"] {
    filter: invert(1) hue-rotate(180deg);
}
body.mw-theme-dark .graderPanel-invertedImage img {
    filter: invert(1) hue-rotate(180deg);
}

/**
    Fix the overlapping lines when the problem description html is viewed on smaller screens.
    Override the hard-coded block size on each line/paragraph in the description to allow for the
    block to expand when the content overflows instead of keeping the height of the block static and
    forcing the overflowing content to render on top of the next block below.
    Set min-height so that blocks without content get a min-height instead of going to 0px.
*/
.graderPanel-richTextContent * {
    block-size: auto !important;
    min-height: 21px !important;
}

/*
    Add overflow-wrap so that long lines of text without any white space breaks will eventually be
    forced to break to the next line. Without this, the long lines will cause a horizontal scroll
    for the side panel (g3278924 and g3348577).
    Add white-space: pre-wrap to prevent white spaces from being collapsed, except for when lines
    need to be broken to preserve the parent container's width. This is needed to fix g3185622, 
    where the indenting of code sections in problem descriptions was being collapsed/removed.
*/
.graderPanel-richTextContent * {
    overflow-wrap: break-word;
    white-space: pre-wrap;
}


/**
* The default web widgets style sheet adds extra margins to the left of ol's and ul's.
* This causes the lists inside the problem descriptions to look extra indented in comparison to how
* the lists look in MATLAB Grader webapp. Adding styling to override the extra indenting.
*/
.graderPanel-richTextContent ol  {
    margin-left: 0px;
}
.graderPanel-richTextContent ul  {
    margin-left: 0px;
}`,""]),y.exports=S},function(y,S,T){(S=T(7)(!1)).push([y.i,`
.graderPanel-assessments {
  padding: 10px;
}

.graderPanel-assessments ul {
  list-style: none;
  margin: 0px;
}

.graderPanel-assessments li.graderPanel-assessmentItem {
  padding: 15px;
  margin-bottom: 10px;
  background-color: var(--mw-backgroundColor-primary);
}

.graderPanel-ungradedAssessment {
  border: 2px solid var(--mw-borderColor-primary);
}

.graderPanel-passedAssessment {
  border: 2px solid var(--mw-borderColor-success);
}

.graderPanel-failedAssessment {
  border: 2px solid var(--mw-borderColor-error);
}

.graderPanel-icon {
  display: inline-block;
  padding-right: 10px;
  margin-bottom: -5px;
}

.graderPanel-pretestExpandIconPlaceholder {
  width: 22px;
}

.graderPanel-assessmentTitle {
  display: inline-block;
  font-weight: bold;
}

.graderPanel-resultsSummary {
  font-weight: bold;
  padding-bottom: 12px;
  padding-top: 10px;
  font-size: 14px;
  line-height: 20px;
}

.graderPanel-resultsSummary-passed {
  color: var(--mw-color-success);
}

.graderPanel-resultsSummary-failed {
  color: var(--mw-color-error);
}

.graderPanel-assessmentFeedbackSummary {
  color: var(--mw-color-error);
  padding-top: 10px;
  padding-bottom: 20px;
}

.graderPanel-showFeedbackButton {
  margin-bottom: -5px;
}

.graderPanel-feedbackHiddenMessageWrapper {
  padding-top: 30px;
  padding-bottom: 12px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.graderPanel-feedbackHiddenMessage {
  display: inline;
  margin-right: 5px;
}

.graderPanel-feedbackHiddenMessage-primaryText {
  font-weight: bold;
  margin-right: 2px;
}

/**
* Temporary fix: LaTeX equations are exported out of the RTC editor as images with black text. In
* dark mode, we need these LaTeX equations to show up as having white text. We can't apply CSS to
* change the font color since the equations are images and not text. We instead need to use an image
* filter to invert the colors completely (i.e change black -> white and vice versa).
* note: we're targeting all images without the .imageNode class since actual images which are
* included in the rich text content have this class, and we don't want to invert actual images.
* note: we've noticed with the RTC upgrade that even the LaTeX equation images were getting the
* imageNode class, so we need a fallback to look for images with height=18 (how tall all the
* equations are) and adding this same filter.
*/
body.mw-theme-dark .graderPanel-feedbackOnIncorrectWrapper img:not(.imageNode) {
  filter: invert(1) hue-rotate(180deg);
}
body.mw-theme-dark .graderPanel-description img[height="18"] {
  filter: invert(1) hue-rotate(180deg);
}

/**
    Fix the overlapping lines when the feedback on incorrect html is viewed on smaller screens.
    See similar fix in description.css for details.  
*/
.graderPanel-feedbackOnIncorrectWrapper * {
  block-size: auto !important;
  min-height: 21px !important;
}

/**
* See similar fix in description.css for details.
*/
.graderPanel-feedbackOnIncorrectWrapper ol  {
  margin-left: 0px;
}
.graderPanel-feedbackOnIncorrectWrapper ul  {
  margin-left: 0px;
}

.graderPanel-assessmentWeight {
  margin-left: auto;
  font-weight: bold;
}

.graderPanel-assessmentWeight-passed {
  color: var(--mw-color-success);
}

.graderPanel-totalScore {
  font-weight: bold;
  display: flex;
  justify-content: end;
  margin-right: 16px;
  margin-top: 18px;
}

.graderPanel-totalScore-label {
  margin-right: 2px;
}

.graderPanel-totalScore-valuePassed {
  color: var(--mw-color-success);
}

.graderPanel-pretestIndicator {
  font-weight: normal;
  margin-left: 10px;
}

.graderPanel-pretestInfoWrapper{
  margin-top: 10px;
}

.graderpanel-pretestTestHeader {
  font-weight: bold;
}

.graderPanel-pretestAssessmentInfo {
    margin-top: 10px;
    padding: 8px;
    background: var(--mw-backgroundColor-secondary);
    border: 1px solid var(--mw-borderColor-secondary);
}

.graderPanel-assessmentHeaderContentWrapper {
  display: flex;
}

.graderPanel-assessmentContentWrapper {
  padding-left: 27px;
}

.graderPanel-assessmentCodeEditorWrapper {
  margin-top: 10px;
}

.graderPanel-submitErrorAlertWrapper, .graderPanel-submitWarningAlertWrapper {
  margin-bottom: 25px;
}

.graderPanel-pretestExplanation {
  margin-bottom: 10px;
}

.graderPanel-assessmentExplanation {
  margin-bottom: 10px;
}`,""]),y.exports=S},function(y,S,T){(S=T(7)(!1)).push([y.i,`.graderPanel-codeOutputWrapper {
    padding: 10px;
}

.graderPanel-codeOutputBox {
    overflow: auto;
    padding: 10px;
    border: 2px solid var(--mw-borderColor-primary);
    white-space: pre;
    font-family: 'BitstreamVeraSansMonoRoman', monospace;
    color: var(--mw-color-code);
}

.graderPanel-codeOutputBox-error {
    color: var(--mw-color-error);
}

.graderPanel-outputExplanation {
    margin-bottom: 10px;
}

.graderPanel-outputSectionTitle, .graderPanel-figuresSectionTitle {
    font-weight: bold;
    font-size: 14px;
    line-height: 20px;
    margin-top: 20px;
    margin-bottom: 20px;
}

.graderPanel-outputSectionTitle {
    margin-top: 0px;
}

.graderPanel-outputFigure {
    margin-bottom: 10px;
}

.graderPanel-outputFigure img {
    max-width: 100%;
    height: auto !important;
    cursor: zoom-in;
}
`,""]),y.exports=S},function(y,S,T){(S=T(7)(!1)).push([y.i,`.graderPanel-wrapper {
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-flow: column;
    color: var(--mw-color-primary);
}

.graderPanel-header {
    padding: 0px 10px;
}

/**
* Matching the font-sizes for the Task # in MATLAB Academy (i.e MATLAB On-ramp)
*/
#graderPanel-header-problemTitle {
    color: var(--mw-color-primary);
    font-size: 16px;
    font-weight: bold;
    line-height: 25px;
    margin-bottom: -3px;
}

.graderPanel-titleWrapper {
    padding-bottom: 15px;
    padding-top: 5px;
    padding-left: 10px;
    display: flex;
    align-items: center;
    margin-right: -10px;
    margin-left: -10px;
    border-bottom: 1px solid;
    border-color: var(--mw-borderColor-secondary);
}

.graderPanel-controlsRow {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    margin-top: 5px;
}

.graderPanel-controlsWrapper {
    padding: 0px 5px 3px 5px;
    margin: 0px -10px 0px -10px;
    border-bottom: 1px solid;
    border-color: var(--mw-borderColor-secondary);
}

.graderPanel-submitControlsWrapper .graderPanel-button {
    margin-right: 0px;
}

.graderPanel-button {
    display: inline;
    margin-right: 7px;
}

#graderPanel-header-submitButton .mwPushButton {
    background-color: var(--mw-color-blue700);
    color: white;
}

.graderPanel-fallback {
    margin: 5px;
}

.graderPanel-body {
    flex: 1;
}

.graderPanel-tabContainer {
    width: 100%;
    height: 100%;
    position: relative;
}

#graderPanel-body-tabContainer-descriptionTab {
    padding: 10px;
}

.graderPanel-editorParent {
    height: 150px;
}

.graderPanel-unstyleButton {
    display: block;
    width: 100%;
    background-color: inherit;
    border: none;
    text-align: left;
    padding-top: 5px;
    padding-bottom: 5px;
}

.graderPanel-unstyleButton:focus,.graderPanel-unstyleButton:active,.graderPanel-unstyleButton:focus-visible {
    border: 1px solid var(--mw-borderColor-focus,#268cdd);
    outline: var(--mw-borderColor-focus,#268cdd);
}

.graderPanel-confirmationDialog-primaryMessage {
    font-weight: bold;
    margin-bottom: 10px;
}

.graderPanel-confirmationDialog-secondaryMessage {
    margin-bottom: 10px;
}

.graderPanel-confirmationDialog-checkboxLabel {
    margin-left: 3px;
}

.graderPanel-confirmationDialog-checkboxWrapper {
    display: flex;
    align-items: center;
}

.graderPanel-alertWrapper {
    padding: 5px;
}

.graderPanel-alertWrapper-error {
    border: 1px solid var(--mw-borderColor-error);
    background-color: var(--mw-backgroundColor-secondary-error );
    color: var(--mw-color-primary);
}

.graderPanel-alertWrapper-warning {
    border: 1px solid var(--mw-borderColor-warning);
    background-color: var(--mw-backgroundColor-secondary-warning);
    color: var(--mw-color-primary);
}

.graderPanel-alertWrapper-info {
    border: 1px solid var(--mw-borderColor-info);
    background-color: var(--mw-backgroundColor-secondary-info);
    color: var(--mw-color-primary);
}

.graderPanel-alertHeaderWrapper {
    display: flex;
    align-items: center;
}

.graderPanel-alertIcon {
    display: inline;
    margin-right: 10px;
}

.graderPanel-alertTitle {
    font-weight: bold;
}

.graderPanel-alertBody {
    margin-top: 10px;
    margin-left: 34px;
}

.graderPanel-saveStatusAlert {
    padding: 5px 0px;
}

.graderPanel-progressBar, .graderPanel-emptyProgressBarPlaceholder {
    margin-left: -10px;
    margin-right: -10px;
}

.graderPanel-emptyProgressBarPlaceholder {
    height: 5px;
