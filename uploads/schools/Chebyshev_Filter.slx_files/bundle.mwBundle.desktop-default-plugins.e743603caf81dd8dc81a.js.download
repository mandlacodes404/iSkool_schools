mw-git-branchmanager-submoduledetails {
    display: flex;
    flex-direction: column;

    margin: 10px;
}

mw-git-branchmanager-submoduledetails .git-submoduledetails-grid {
    display: grid;
    row-gap: 10px;
    column-gap: 10px;
    grid-template-columns: 1fr auto;
    align-items: center;
}

mw-git-branchmanager-submoduledetails .git-submoduledetails-col1 {
    grid-column: 1;
    font-weight: bold;
    margin-right: 2px;
    user-select: none;
    align-self: flex-start;
}

mw-git-branchmanager-submoduledetails .git-submoduledetails-col12 {
    grid-column: 1 / 2;
    align-self: center;
}

