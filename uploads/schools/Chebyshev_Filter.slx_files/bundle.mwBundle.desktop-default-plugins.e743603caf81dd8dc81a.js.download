            <div class="cancelButton fileChooserButtons" data-dojo-attach-point="cancelButtonNode"></div>
        </div>
    </div>
</div>`},"dojo/text!mldosharing-js/ui/shareDialogTemplate.html":h=>{h.exports=`<div class="shareDialogContainer" data-dojo-attach-point="shareDialogContainer" style="visibility: hidden; z-index: 950; width: 600px; top: calc(50vh - 200px); left: calc(50vw - 300px); position: absolute">
