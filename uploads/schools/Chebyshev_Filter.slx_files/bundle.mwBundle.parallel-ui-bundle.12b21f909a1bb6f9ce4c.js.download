        ><div class="mwCheckBoxRadioIconInner"></div></div
    ><div data-dojo-attach-point="textNode" class="mwTextNode"></div
></div>`},"dojo/text!mw-form/templates/Spinner.html":m=>{m.exports=`<div
    ><div class = "mwContainerNode" data-dojo-attach-point="containerNode"></div
    ><div class = "mwButtonsContainer" data-dojo-attach-point="buttonsContainerNode"
        ><div class = "mwIncrementButtonWrapper" data-dojo-attach-point="incrementButtonNodeWrapper"
            ><div class = "mwIncrementButtonNode" data-dojo-attach-point="incrementButtonNode"
            ></div
        ></div
        ><div class = "mwDecrementButtonWrapper" data-dojo-attach-point="decrementButtonNodeWrapper"
            ><div class = "mwDecrementButtonNode" data-dojo-attach-point="decrementButtonNode"
            ></div
        ></div
    ></div
></div>`},"dojo/text!mw-form/templates/TextArea.html":m=>{m.exports='<div><textarea class="mwInputNode mwAlignmentNode" data-dojo-attach-point="inputNode,focusNode" spellcheck="false"></textarea></div>'},"dojo/text!mw-form/templates/TextField.html":m=>{m.exports='<div><input class= "mwInputNode mwAlignmentNode" spellcheck="false" type="text" data-dojo-attach-point="inputNode,focusNode"></div>'},"dojo/text!mw-form/templates/TextFieldMenuItem.html":m=>{m.exports=`<div data-dojo-attach-point="focusNode" role="menuitem"
    ><div class="mwTextContainer" data-dojo-attach-point="textContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
    ></div
    ><div class="mwTextFieldWrapperNode" data-dojo-attach-point="textFieldWrapperNode"></div
    ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
></div>
`},"dojo/text!mw-form/templates/ToggleButton.html":m=>{m.exports=`<div data-dojo-attach-point="focusNode" role="button" aria-pressed="false"
    ><div data-dojo-attach-point="contentWrapperNode" class="mwContentWrapperNode"
