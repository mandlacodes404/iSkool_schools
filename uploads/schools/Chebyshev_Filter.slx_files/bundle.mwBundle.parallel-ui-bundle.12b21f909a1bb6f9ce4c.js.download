 * Copyright 2014-2024 The MathWorks, Inc.
 */

.mwWidget.mwDefaultVisualFamily.mwDropDownButton.parallelStatusIndicatorDropDown .mwArrowIconNode {
    border-width: 0 4px 4px 4px;
    border-color: transparent transparent var(--mw-backgroundColor-iconuiFill) transparent;
}

.poolClosed {
    filter: grayscale(100%);
}

.poolAnimating {
    animation: animate-grayscale 1s infinite;
}

@keyframes animate-grayscale {
    0% {
        filter: grayscale(100%);
    }
    50% {
        filter: grayscale(0);
    }
    100% {
        filter: grayscale(100%);
    }
}

.poolErrored {
    filter: hue-rotate(130deg);
}

.poolBusy {
    --pool-percent: 0%;
    filter: hue-rotate(-100deg);
    position: relative; /* Required to align the ::before and ::after pseudo-elements */
}

.poolBusy::after {
    position: absolute;
    height: 100%;
    content: '';
    backdrop-filter: grayscale(100%);
    left: var(--pool-percent);
    width: calc(100% - var(--pool-percent));
}

.parallelStatusIndicatorTooltipDialog {
    max-width: 300px;
}

.parallelStatusIndicatorTooltipContent div {
    cursor: default;
    -webkit-user-select: none;  /* Chrome all / Safari all */
    -moz-user-select: none;     /* Firefox all */
    -ms-user-select: none;      /* IE 10+ */
    user-select: none;          /* Non-prefixed version, currently not supported by any browser */
}

.parallelStatusIndicatorTooltipContent a {
    cursor: pointer;
    color: var(--mw-color-hyperlink);
}

.parallelStatusIndicatorTooltipContent a:hover {
    color: var(--mw-color-hyperlink-hover);
}

.parallelStatusIndicatorTooltipHeader {
    border-bottom: 1px solid var(--mw-borderColor-secondary);
    text-align: right;
    padding-bottom: 2px;
}

.parallelStatusIndicatorTooltipBody {
    margin: 4px;
}

.parallelStatusIndicatorTooltipNORMAL .indicatorTooltipDetails {
    display: none;
}

.parallelStatusIndicatorTooltipDetails {
    margin: 4px;
}
`,"",{version:3,sources:["webpack://./../content/pct/css/status.css"],names:[],mappings:"AAAA;;EAEE;;AAEF;IACI,2BAA2B;IAC3B,sFAAsF;AAC1F;;AAEA;IACI,uBAAuB;AAC3B;;AAEA;IACI,wCAAwC;AAC5C;;AAEA;IACI;QACI,uBAAuB;IAC3B;IACA;QACI,oBAAoB;IACxB;IACA;QACI,uBAAuB;IAC3B;AACJ;;AAEA;IACI,0BAA0B;AAC9B;;AAEA;IACI,kBAAkB;IAClB,2BAA2B;IAC3B,kBAAkB,EAAE,+DAA+D;AACvF;;AAEA;IACI,kBAAkB;IAClB,YAAY;IACZ,WAAW;IACX,gCAAgC;IAChC,yBAAyB;IACzB,uCAAuC;AAC3C;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,eAAe;IACf,yBAAyB,GAAG,4BAA4B;IACxD,sBAAsB,MAAM,gBAAgB;IAC5C,qBAAqB,OAAO,WAAW;IACvC,iBAAiB,WAAW,iEAAiE;AACjG;;AAEA;IACI,eAAe;IACf,gCAAgC;AACpC;;AAEA;IACI,sCAAsC;AAC1C;;AAEA;IACI,wDAAwD;IACxD,iBAAiB;IACjB,mBAAmB;AACvB;;AAEA;IACI,WAAW;AACf;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,WAAW;AACf",sourcesContent:[`/*
 * Copyright 2014-2024 The MathWorks, Inc.
 */

.mwWidget.mwDefaultVisualFamily.mwDropDownButton.parallelStatusIndicatorDropDown .mwArrowIconNode {
    border-width: 0 4px 4px 4px;
    border-color: transparent transparent var(--mw-backgroundColor-iconuiFill) transparent;
}

.poolClosed {
    filter: grayscale(100%);
}

.poolAnimating {
    animation: animate-grayscale 1s infinite;
}

@keyframes animate-grayscale {
    0% {
        filter: grayscale(100%);
    }
    50% {
        filter: grayscale(0);
    }
    100% {
        filter: grayscale(100%);
    }
}

.poolErrored {
    filter: hue-rotate(130deg);
}

.poolBusy {
    --pool-percent: 0%;
    filter: hue-rotate(-100deg);
    position: relative; /* Required to align the ::before and ::after pseudo-elements */
}

.poolBusy::after {
    position: absolute;
    height: 100%;
    content: '';
    backdrop-filter: grayscale(100%);
    left: var(--pool-percent);
    width: calc(100% - var(--pool-percent));
}

.parallelStatusIndicatorTooltipDialog {
    max-width: 300px;
}

.parallelStatusIndicatorTooltipContent div {
    cursor: default;
    -webkit-user-select: none;  /* Chrome all / Safari all */
    -moz-user-select: none;     /* Firefox all */
    -ms-user-select: none;      /* IE 10+ */
    user-select: none;          /* Non-prefixed version, currently not supported by any browser */
}

.parallelStatusIndicatorTooltipContent a {
    cursor: pointer;
    color: var(--mw-color-hyperlink);
}

.parallelStatusIndicatorTooltipContent a:hover {
    color: var(--mw-color-hyperlink-hover);
}

.parallelStatusIndicatorTooltipHeader {
    border-bottom: 1px solid var(--mw-borderColor-secondary);
    text-align: right;
    padding-bottom: 2px;
}

.parallelStatusIndicatorTooltipBody {
    margin: 4px;
}

.parallelStatusIndicatorTooltipNORMAL .indicatorTooltipDetails {
    display: none;
}

.parallelStatusIndicatorTooltipDetails {
    margin: 4px;
}
`],sourceRoot:""}]),m.exports=v},ab7595b1261e7b46edb7a8392ed6954ef873de1e:(m,T,t)=>{var C=t("mwBundle.parallel-ui-bundle|ed696428f59273ff5a3b9e7284cefe5b63dd4d1d"),y=t("mwBundle.parallel-ui-bundle|cb47172937e548a863ab648aecddd4b09386a96d"),v=y(C);v.push([m.id,`/*
 * Copyright 2014-2023 The MathWorks, Inc.
 */

.pctValidationViewBody {
    padding: 10px;
    display: flex;
    flex-direction: column;
}

.pctValidationViewTable .field-description {
    width: auto;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.pctValidationViewDetails {
    margin: 10px 0;
    border: 1px solid var(--mw-borderColor-secondary);
    flex: 1;
    display: flex;
    flex-direction: column;
}

.pctValidationViewDetailsHeader {
    padding: 2px 0;
    border-bottom: 1px solid var(--mw-borderColor-secondary);
    margin: 10px 15px 0 15px;
    font-size: 110%;
    font-weight: bold;
    align-self: flex-start;
}

.pctValidationViewDetailsContainer {
    flex: 1 1 40px; /* A minimum for the v-scroll to look ok */
    overflow: auto;
    margin: 8px 15px;
}

.pctValidationViewDetailsContainer > * {
    padding: 7px 0;
}

.pctValidationViewNumWorkers {
    padding: 0 10px;
}

.pctValidationViewNumWorkersContainer {
    display: flex;
    align-items: center;
    margin: 10px 0;
}

.pctValidationViewNumWorkersWarning {
}

.validationViewActionButton {
    margin-right: 5px;
}

.validationDetailsSectionLabel:not(:empty) {
    font-weight: bold;
    white-space: nowrap;
    padding-right: 4px;
}

.validationDetailsSectionValue,
.validationReportValue {
    white-space: pre-wrap;
}

.pctValidationReport {
    user-select: text;
    width: 100%;
    min-width: 400px;
    min-height: 600px;
}

.pctValidationReportStageError,
.pctValidationViewDetailsErrorSection {
    color: var(--mw-color-error);
}

.pctValidationReportHeader {
    text-transform: uppercase;
}

.pctValidationReportHeader,
.pctValidationReportStageHeader {
    font-weight: bold;
}

.pctValidationReportStage:not(:last-child) {
    margin-bottom: 1em;
}
