 * Copyright 2024 The MathWorks, Inc.
 */

/* TOOLBAR */

.panelToolbarContainer {
    width: 100%;
    height: 76px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    background-color: transparent;
    overflow: hidden;
}

/* TOOLBAR BUTTONS */

.environmentToolbarButton {
    height: 72px;
    max-width: 54px;
    --mw-backgroundColor-button: transparent;
    --mw-borderColor-button: transparent;
    margin-right: 0px;
    margin-left: 2px;
}

/* ENVIRONMENT PANES */

#pctClusterPane .dijitTitlePaneTitle,
#pctGpuPane     .dijitTitlePaneTitle {
    background: var(--mw-backgroundColor-secondary);
    border: 1px solid var(--mw-borderColor-secondary);
    color: var(--mw-color-primary);
}

#pctClusterPane .dijitTitlePaneContentOuter,
#pctClusterPane .dijitTitlePaneContentInner,
#pctGpuPane     .dijitTitlePaneContentOuter,
#pctGpuPane     .dijitTitlePaneContentInner {
    padding: 0;
    background: var(--mw-backgroundColor-primary);
    border: none !important;
    overflow: hidden;
}

/* CLUSTER PROFILE TABLE */

#pct_parallel_panel .mw-table-outer-wrapper,
#pct_parallel_panel .mw-table-outer-wrapper-blurred {
    border: none;
}

#pct_parallel_panel td.mw-table-cell {
    /* Ensures the mw-table cells are large enough to show the full cards */
    height: 100%;
}

#pct_parallel_panel td.mw-table-row {
    border-radius: 2px;
}

#pct_parallel_panel .mw-table-inner-wrapper {
    /* Prevents pointless vertical scrollbar appearing within table.
       The only scrollbar we want is that of the parallel panel itself. */
    overflow: hidden;
}

/* CLUSTER PROFILE AND GPU CARDS */

.pctPanelClusterProfileCardContainer {
    display: flex;
    overflow: hidden;
    justify-content: space-between;
    padding: 4px;
}

.pctPanelClusterProfileCardInfoContainer {
    flex-grow: 1;
    overflow: hidden;
}

.pctPanelClusterProfileCardDescription {
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 100%;
}

.pctPanelClusterProfileCardButtonContainer {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    padding: 2px;
    align-items: center;
    gap: 1px;
}

.pctPanelGpuCardContainer {
    padding: 4px;
}

/* Profile/GPU name */
.pctPanelClusterProfileCardTitle,
.pctPanelGpuCardName {
    font-size: 15;
    font-weight: bold;
}

/* Buttons on cluster profile cards */
.cardButton {
    height: 24px;
    width: 24px;
    background-color: transparent;
    border: transparent solid 1px;
    --mw-backgroundColor-button: transparent;
    --mw-borderColor-button: transparent;
}

/* Bottom of GPU section, offering help for if your GPU isn't shown */
.missingGpuCard {
    padding: 10px 4px;
    color: var(--mw-color-primary);
    background-color: transparent;
    justify-content: center;
    align-items: center;
    display: flex;
    overflow: hidden;
}
`],sourceRoot:""}]),m.exports=v},"1dd519ae1bb4faef7ca30f3af42d679579070e75":(m,T,t)=>{var C=t("mwBundle.parallel-ui-bundle|ed696428f59273ff5a3b9e7284cefe5b63dd4d1d"),y=t("mwBundle.parallel-ui-bundle|cb47172937e548a863ab648aecddd4b09386a96d"),v=y(C);v.push([m.id,`/*
 * Copyright 2014-2025 The MathWorks, Inc.
 */

/* Profile View */

.profileManagerDialog.mwDialog {
    width: 1000px;
    height: 600px;
    min-width: 600px;
    min-height: 400px;
}

.profileManagerDialog.mwDialog .mwDialogBody.mwNoButtons {
    height: calc(100% - 35px);
    padding: 0 !important;
}

.profileManagerView {
    position: relative;
    height: 100%;
}

.profileDetailsContainer {
    display: flex;
    align-items: center;
    padding: 0 10px;
    height: 100%;
}

.profileTabContainerBody {
    flex: 1;
    overflow: hidden auto;
}

.profileTabContainerFooter {
    border-top: 1px solid silver;
    min-height: 40px;
    height: 40px;
    display: flex;
    align-items: center;
}

.profileTabContainerFooter {
    justify-content: flex-end;
}

.pctPropertiesViewFooterWarning {
    flex: 1;
}
.profileTabContainerFooter > .pctTabViewActionButton {
    margin-right: 5px;
    min-width: 60px;
    width: 120%;
}

.profileTabContainer .dijitTabPane,
.tundra .profileTabContainer .dijitTabPaneWrapper {
    background-color: transparent;
}

.profileDetailsNameLabel {
    font-weight: bold;
    font-size: 125%;
    white-space: nowrap;
    width: 100%;
    padding-right: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.profileDetailsTypeLabel, .profileDetailsDocLink {
    white-space: nowrap;
}

.profileDetailsDocLink {
    padding-left: 5px;
}

.profileDetailsDocLink > a {
    cursor: pointer;
}

.pctPropertiesViewCorruptionInfo {
    text-align: center;
}

.corruptProfileContainer .pctPropertiesViewBody {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.corruptProfileContainer .profileViewSection {
    display: none;
}

.profileContainer:not(.corruptProfileContainer) .pctPropertiesViewCorruptionInfo {
    display: none;
}

.profileViewSection {
    margin: 10px 10px 15px 10px;
    border: 1px solid var(--mw-borderColor-secondary);
}

.profileViewSectionTitle {
    padding: 2px 0;
    border-bottom: 1px solid var(--mw-borderColor-secondary);
    margin: 10px 15px 0 15px;
    font-size: 110%;
    font-weight: bold;
    display: inline-block;
}

#pctProfileManagerViewTable .mw-table-component .mw-table-cell-background {
    /* mw-table will shade readonly cells grey to identify them as non-editable.
     * This looks out of place in the profile list and is confusing, so
     * override the background back to the default. */
    background-color: var(--table-cell-background-color) !important;
}

.profileViewSectionTitle:empty {
    display: none;
}

.pctTabView {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.profileViewProperty {
    width: 100%;
    margin: 10px 15px;
    display: table;
}

.profileViewPropertyLabel, .profileViewPropertyValueContainer {
    display: table-cell;
    vertical-align: middle;
}

.profileViewPropertyLabel {
    width: 40%;
}

.profileViewPropertyLabelName {
    font-family: monospace;
    font-size: 10pt;
}

.profileViewPropertyLabelDescription {
}

.profileViewPropertyValueContainer {
    width: 60%;
    padding: 2px 25px 2px 10px;
    max-width: 0; /* This enables text-overflow: ellipsis to work properly */
}

.profileViewPropertyViewer {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: pre;
}

.profileViewPropertyViewerMultiline {
    overflow-x: auto;
    white-space: pre;
}

.profileViewPropertyEditor textarea {
    white-space: pre;
    overflow-x: auto;
}

.profileViewPropertyEditorDefaultValue {
    width: 100%;
}

.profileViewPropertyEditorDefaultValueAbsent {
    display: none;
}

.profileViewPropertyEditorNotes {
    padding-top: 2px;
    color: var(--mw-color-secondary);
}

.profileViewPropertyError {
    color: var(--mw-color-error);
    padding: 0 5px 2px 10px;
}

.propertyEditorContainerButtons {
    text-align: right;
}

.tableEditorContainerButtons {
    margin-top: 4px;
}

.pctFolderEditorContainer {
    align-items: center;
    display: flex;
    padding-bottom: 4px;
}

.pctFolderEditorContainerButton {
    flex-shrink: 0;
    margin-left: 4px;
}

/* Toolstrip */

.profileManagerView .toolstrip .section .title {
    text-transform: uppercase;
}
`,"",{version:3,sources:["webpack://./../content/pct/css/profiles.css"],names:[],mappings:"AAAA;;EAEE;;AAEF,iBAAiB;;AAEjB;IACI,aAAa;IACb,aAAa;IACb,gBAAgB;IAChB,iBAAiB;AACrB;;AAEA;IACI,yBAAyB;IACzB,qBAAqB;AACzB;;AAEA;IACI,kBAAkB;IAClB,YAAY;AAChB;;AAEA;IACI,aAAa;IACb,mBAAmB;IACnB,eAAe;IACf,YAAY;AAChB;;AAEA;IACI,OAAO;IACP,qBAAqB;AACzB;;AAEA;IACI,4BAA4B;IAC5B,gBAAgB;IAChB,YAAY;IACZ,aAAa;IACb,mBAAmB;AACvB;;AAEA;IACI,yBAAyB;AAC7B;;AAEA;IACI,OAAO;AACX;AACA;IACI,iBAAiB;IACjB,eAAe;IACf,WAAW;AACf;;AAEA;;IAEI,6BAA6B;AACjC;;AAEA;IACI,iBAAiB;IACjB,eAAe;IACf,mBAAmB;IACnB,WAAW;IACX,mBAAmB;IACnB,gBAAgB;IAChB,uBAAuB;AAC3B;;AAEA;IACI,mBAAmB;AACvB;;AAEA;IACI,iBAAiB;AACrB;;AAEA;IACI,eAAe;AACnB;;AAEA;IACI,kBAAkB;AACtB;;AAEA;IACI,aAAa;IACb,mBAAmB;IACnB,mBAAmB;IACnB,uBAAuB;AAC3B;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,2BAA2B;IAC3B,iDAAiD;AACrD;;AAEA;IACI,cAAc;IACd,wDAAwD;IACxD,wBAAwB;IACxB,eAAe;IACf,iBAAiB;IACjB,qBAAqB;AACzB;;AAEA;IACI;;qDAEiD;IACjD,+DAA+D;AACnE;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,aAAa;IACb,sBAAsB;IACtB,YAAY;AAChB;;AAEA;IACI,WAAW;IACX,iBAAiB;IACjB,cAAc;AAClB;;AAEA;IACI,mBAAmB;IACnB,sBAAsB;AAC1B;;AAEA;IACI,UAAU;AACd;;AAEA;IACI,sBAAsB;IACtB,eAAe;AACnB;;AAEA;AACA;;AAEA;IACI,UAAU;IACV,0BAA0B;IAC1B,YAAY,EAAE,0DAA0D;AAC5E;;AAEA;IACI,gBAAgB;IAChB,uBAAuB;IACvB,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;IAChB,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;IAChB,gBAAgB;AACpB;;AAEA;IACI,WAAW;AACf;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,gBAAgB;IAChB,gCAAgC;AACpC;;AAEA;IACI,4BAA4B;IAC5B,uBAAuB;AAC3B;;AAEA;IACI,iBAAiB;AACrB;;AAEA;IACI,eAAe;AACnB;;AAEA;IACI,mBAAmB;IACnB,aAAa;IACb,mBAAmB;AACvB;;AAEA;IACI,cAAc;IACd,gBAAgB;AACpB;;AAEA,cAAc;;AAEd;IACI,yBAAyB;AAC7B",sourcesContent:[`/*
