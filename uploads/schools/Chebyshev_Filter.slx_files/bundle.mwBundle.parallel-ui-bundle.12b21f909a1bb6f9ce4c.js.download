         data-dojo-attach-event="selected-cluster-changed: _handleClusterSelectionChanged, cluster-dblclicked: _handleClusterListRowDoubleClicked"
         data-dojo-attach-point="clusterTable">
    </div>
    <mw-progress-or-icon-label
         id="\${id}ClusterHasProfiles"
