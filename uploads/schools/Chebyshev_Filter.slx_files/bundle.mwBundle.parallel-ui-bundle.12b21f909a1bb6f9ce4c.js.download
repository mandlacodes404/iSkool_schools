</div>
`},"dojo/text!pct/app/cluster/profiles/property/PropertySectionWidget.html":m=>{m.exports='<div>\n    <h1 class="${baseClass}Title"\n        id="profileViewSectionTitle${section.name}">${section.title}</h1>\n</div>'},"dojo/text!pct/app/cluster/profiles/property/PropertyWidget.html":m=>{m.exports=`<div>
