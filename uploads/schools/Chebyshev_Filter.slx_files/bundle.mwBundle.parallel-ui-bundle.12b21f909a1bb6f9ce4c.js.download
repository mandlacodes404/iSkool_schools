         id="\${id}Stages"
         data-dojo-attach-point="containerNode"></div>
</div>`},"dojo/text!pct/app/cluster/profiles/validation/ValidationView.html":m=>{m.exports=`<div class="pctTabView">
    <div class="\${baseClass}Body profileTabContainerBody">
        <div data-dojo-type="pct/app/cluster/profiles/validation/ValidationTable"
             id="\${id}TableContainer"
             class="\${baseClass}TableContainer"
             data-dojo-attach-point="table"
             data-dojo-attach-event="stage-selected: _handleStageSelected"></div>

        <div class="\${baseClass}NumWorkersContainer">
            <div class="\${baseClass}NumWorkersLabel"
                 data-dojo-type="mw-form/Label"
                 data-dojo-attach-point="numWorkersText"
                 data-dojo-props="text: '\${nls.ValidationNumWorkersLabel}'"></div>
            <div data-dojo-type="pct/app/cluster/profiles/validation/widgets/Spinner"
                 data-dojo-attach-point="numWorkersField"
                 data-dojo-attach-event="change: _handleNumWorkersChanged"
                 data-dojo-props="placeholder: '\${nls.PropertyUseDefault}', width: 'auto'"
                 class="\${baseClass}NumWorkers"
                 id="\${id}NumWorkers"></div>
             <div data-dojo-attach-point="numWorkersWarning"
                  data-dojo-type="mw-form/Label"
                  data-dojo-props="icon: { id: 'warning', width: 16, height: 16 }"
                  id="\${id}NumWorkersWarning"
                  class="\${baseClass}NumWorkersWarning"></div>
        </div>

        <div class="\${baseClass}Details">
            <h1 class="profileViewSectionTitle">\${nls.ValidationDetailsHeader}</h1>

            <div class="\${baseClass}DetailsContainer">
                <div id="\${id}DetailsInfoSection"
                     class="\${baseClass}DetailsInfoSection"
                     data-dojo-attach-point="detailsInfo"></div>
                <div id="\${id}MoreDetailsSection"
                     class="\${baseClass}MoreDetailsSection"
                     data-dojo-attach-point="moreDetails"
                     data-dojo-type="pct/app/cluster/profiles/validation/ValidationDetailsSection"
                     data-dojo-props="visible: false"></div>
                <div id="\${id}DetailsErrorSection"
                     class="\${baseClass}DetailsErrorSection"
                     data-dojo-attach-point="detailsErrorReport"
                     data-dojo-type="pct/app/cluster/profiles/validation/ValidationDetailsSection"
                     data-dojo-props="visible: false, label: '\${nls.ValidationLabelsErrorReport}'"></div>
                <div id="\${id}DetailsOutputSection"
                     class="\${baseClass}DetailsOutputSection"
                     data-dojo-attach-point="detailsCommandLineOutput"
                     data-dojo-type="pct/app/cluster/profiles/validation/ValidationDetailsSection"
                     data-dojo-props="visible: false, label: '\${nls.ValidationLabelsCommandLineOutput}'"></div>
                <div id="\${id}DetailsLogSection"
                     class="\${baseClass}DetailsLogSection"
                     data-dojo-attach-point="detailsDebugLog"
                     data-dojo-type="pct/app/cluster/profiles/validation/ValidationDetailsSection"
                     data-dojo-props="visible: false, label: '\${nls.ValidationLabelsDebugLog}'"></div>
            </div>
        </div>
    </div>

    <div class="\${baseClass}Footer profileTabContainerFooter">
        <button id="\${id}ValidateButton"
                class="\${baseClass}ValidateButton pctTabViewActionButton"
                data-dojo-type="mw-form/PushButton"
