\${0}`,UpdateFrequencyEvery15min:"Every 15 minutes",UpdateFrequencyEvery1hour:"Every hour",UpdateFrequencyEvery1min:"Every minute",UpdateFrequencyEvery30min:"Every 30 minutes",UpdateFrequencyEvery5min:"Every 5 minutes",UpdateFrequencyNever:"Never",UpdateNow:"Update Now",Updating:"Updating..."},"ja-jp":!0,"ko-kr":!0,"zh-cn":!0}},"pct/resources/parallel/web/nls/ko-kr/cloud":(m,T,t)=>{m.exports={BreadcrumbCloudCenter:"\uD074\uB7EC\uC2A4\uD130 \uC0DD\uC131",BreadcrumbFinal:"\uB9C8\uCE68",BreadcrumbLicenseCenter:"\uB300\uAE08 \uCCAD\uAD6C \uC815\uBCF4",BreadcrumbRequirements:"\uC694\uAD6C \uC0AC\uD56D",ButtonCancel:"\uCDE8\uC18C",ButtonContinue:"\uACC4\uC18D",ButtonFinish:"\uB9C8\uCE68",ButtonNext:"\uB2E4\uC74C",ButtonPrevious:"\uC774\uC804",ButtonSkip:"\uAC74\uB108\uB6F0\uAE30",DialogTitleCreateCloudCluster:"\uD074\uB77C\uC6B0\uB4DC \uD074\uB7EC\uC2A4\uD130 \uC0DD\uC131",ErrorNoEntitlementAfterSignup:"\uC9C0\uAE08\uC740 \uAC00\uC785 \uC808\uCC28\uB97C \uC644\uB8CC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.<br/>\uB098\uC911\uC5D0 \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC2ED\uC2DC\uC624.",ErrorNoEntitlementBeforeSignup:"\uC81C\uD488 \uB77C\uC774\uC120\uC2A4 \uC815\uBCF4\uAC00 \uB204\uB77D\uB418\uC5C8\uAE30 \uB54C\uBB38\uC5D0 \uAC00\uC785 \uC808\uCC28\uB97C \uC2DC\uC791\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4. <a href='https://www.mathworks.com/support/contact_us/'>MathWorks \uAE30\uC220 \uC9C0\uC6D0\uD300\uC5D0 \uBB38\uC758</a>\uD558\uC2ED\uC2DC\uC624.",HeadingCloudCenterRequirements:"\uD074\uB77C\uC6B0\uB4DC \uD074\uB7EC\uC2A4\uD130 \uC0DD\uC131 \uC694\uAD6C \uC0AC\uD56D",HeadingCompletedCloud:"\uD074\uB77C\uC6B0\uB4DC \uD074\uB7EC\uC2A4\uD130 \uAD00\uB9AC",HeadingCompletedMPC:"\uC644\uB8CC\uB428",HeadingConnectivityChecker:"\uD074\uB77C\uC6B0\uB4DC \uC5F0\uACB0 \uD14C\uC2A4\uD2B8",HeadingEntitlements:"\uAD8C\uD55C \uBD80\uC5EC(Entitlement) \uC120\uD0DD",HeadingError:"\uC624\uB958",HeadingInfo:"\uC815\uBCF4",HeadingWarning:"\uACBD\uACE0",LabelAlreadySignedUpNote:"<a href='https://www.mathworks.com/on-demand_distriben-lic-alt'>\uD074\uB77C\uC6B0\uB4DC \uD074\uB7EC\uC2A4\uD130\uB97C \uC0DD\uC131 \uD560 \uC218 \uC788\uB3C4\uB85D \uC774\uBBF8 \uAC00\uC785\uB41C \uC0C1\uD0DC</a>\uC785\uB2C8\uAE4C?",LabelCompletedCloud:'\uC774\uC81C \uD074\uB77C\uC6B0\uB4DC \uD074\uB7EC\uC2A4\uD130\uB97C \uC0AC\uC6A9\uD560 \uC900\uBE44\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC774 \uD074\uB7EC\uC2A4\uD130 \uBC0F \uAE30\uD0C0 \uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uD074\uB7EC\uC2A4\uD130\uB97C MATLAB\uACFC \uD074\uB7EC\uC2A4\uD130 \uD504\uB85C\uD30C\uC77C \uAD00\uB9AC\uC790\uC5D0\uC11C \uAD00\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. <br/><br/> <h4>MATLAB\uC5D0\uC11C \uD560 \uC218 \uC788\uB294 \uAD00\uB9AC \uC791\uC5C5.</h4> <ul><li><b>\uBCD1\uB82C</b> \uBA54\uB274\uB97C \uC0AC\uC6A9\uD558\uC5EC \uD574\uB2F9 \uD074\uB7EC\uC2A4\uD130\uB97C \uB514\uD3F4\uD2B8 \uAC12\uC73C\uB85C \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</li> <li><code>parcluster</code> \uBA85\uB839\uC744 \uC0AC\uC6A9\uD558\uC5EC \uD074\uB7EC\uC2A4\uD130\uC5D0 \uC561\uC138\uC2A4\uD558\uACE0<br/> \uD074\uB7EC\uC2A4\uD130 \uC0C1\uD0DC\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</li> </ul> <br/><br/> <h4>\uD074\uB7EC\uC2A4\uD130 \uD504\uB85C\uD30C\uC77C \uAD00\uB9AC\uC790\uC5D0\uC11C \uD560 \uC218 \uC788\uB294 \uAD00\uB9AC \uC791\uC5C5.</h4> <ul> <li>cluster \uC18D\uC131\uC744 \uD3B8\uC9D1\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</li> <li>\uC0C8 \uD074\uB77C\uC6B0\uB4DC \uD074\uB7EC\uC2A4\uD130\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</li> <li>\uC0AC\uC6A9\uB7C9 \uACBD\uACE0\uB97C \uC124\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</li> </ul> <br/><br/> <a data-ref="cc">\uD074\uB7EC\uC2A4\uD130 \uC0C1\uD0DC\uB97C \uD655\uC778</a>\uD558\uB824\uBA74 Cloud Center\uB85C \uC774\uB3D9\uD558\uC2ED\uC2DC\uC624.',LabelCompletedCloudNote:'\uD074\uB77C\uC6B0\uB4DC \uC81C\uACF5\uC5C5\uCCB4\uC5D0\uC11C \uACC4\uC0B0 \uB9AC\uC18C\uC2A4\uC640 \uC800\uC7A5 \uB9AC\uC18C\uC2A4 \uC0AC\uC6A9\uC5D0 \uB300\uD55C \uBE44\uC6A9\uC744 \uCCAD\uAD6C\uD569\uB2C8\uB2E4. <a data-ref="pricing">\uAC00\uACA9\uACFC \uB300\uAE08 \uCCAD\uAD6C, \uC0AC\uC6A9\uB7C9 \uBAA8\uB2C8\uD130\uB9C1</a>\uC5D0 \uB300\uD55C \uC790\uC138\uD55C \uB0B4\uC6A9\uC744 \uD655\uC778\uD558\uC2ED\uC2DC\uC624.',LabelCompletedMPC:'MATLAB Parallel Cloud\uAC00 \uC131\uACF5\uC801\uC73C\uB85C \uC124\uC815\uB418\uC5C8\uC2B5\uB2C8\uB2E4.<br/><br/>MATLAB Parallel Cloud \uC0AC\uC6A9\uC744 \uC2DC\uC791\uD558\uB824\uBA74 "MATLAB Parallel Cloud" \uD504\uB85C\uD30C\uC77C\uC744 \uC0AC\uC6A9\uD558\uC5EC \uBCD1\uB82C \uD480\uC744 \uC2DC\uC791\uD558\uC2ED\uC2DC\uC624.',LabelConnectivityGlobalStatus:"\uD074\uB77C\uC6B0\uB4DC \uC5F0\uACB0 \uD14C\uC2A4\uD2B8 \uC911...",LabelConnectivityNote:"<p>\uCC38\uACE0: \uD074\uB77C\uC6B0\uB4DC \uC5F0\uACB0 \uC911 \uCEF4\uD4E8\uD130\uC5D0\uC11C \uBC1C\uC0DD\uD560 \uC218 \uC788\uB294 \uC7A0\uC7AC\uC801\uC778 \uBB38\uC81C\uB97C \uAC10\uC9C0\uD558\uB824\uBA74 \uD074\uB77C\uC6B0\uB4DC \uC5F0\uACB0\uC744 \uD14C\uC2A4\uD2B8\uD574 \uBCF4\uC2ED\uC2DC\uC624. \uC774\uB7EC\uD55C \uD14C\uC2A4\uD2B8\uB294 \uD074\uB7EC\uC2A4\uD130\uB97C \uC2DC\uC791\uD558\uC9C0 \uC54A\uC73C\uBBC0\uB85C, \uD14C\uC2A4\uD2B8 \uC2E4\uD589 \uBE44\uC6A9\uC774 <b>\uBB34\uB8CC</b>\uC785\uB2C8\uB2E4.</p>",LabelEntitlementLabel:"\uB808\uC774\uBE14",LabelEntitlementLicenseNumber:"\uB77C\uC774\uC120\uC2A4 \uBC88\uD638",LabelEntitlementSelect:"\uC5EC\uB7EC \uAC1C\uC758 \uAD8C\uD55C \uBD80\uC5EC(Entitlement)\uAC00 \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC544\uB798 \uBAA9\uB85D\uC5D0\uC11C \uC0AC\uC6A9\uD560 \uAD8C\uD55C \uBD80\uC5EC\uB97C \uC120\uD0DD\uD558\uC2ED\uC2DC\uC624:",LabelSetDefaultProfile:"MATLAB\uC5D0\uC11C \uB0B4 \uB514\uD3F4\uD2B8 \uD074\uB7EC\uC2A4\uD130\uB85C \uC124\uC815",LoginContextualTextForOnlineServer:"\uD074\uB77C\uC6B0\uB4DC \uD074\uB7EC\uC2A4\uD130\uB97C \uC0AC\uC6A9\uD558\uB824\uBA74 MathWorks \uACC4\uC815\uC5D0 \uB85C\uADF8\uC778\uD558\uC2ED\uC2DC\uC624"}},"pct/resources/parallel/web/nls/ko-k