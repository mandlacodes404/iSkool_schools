 * Copyright 2015-2023 The MathWorks, Inc.
 */

.pctConnectivityCheckerDialog.mwDialog {
    width: 700px;
    height: 350px;
    min-width: 500px;
    min-height: 350px;
}

.connectivityCheckerWidget {
    display: flex;
    flex-direction: column;
    margin: 20px;
    height: 100%;
}

.pctConnectivityCheckerDialog .connectivityCheckerWidget {
    margin: 0;
}

.connectivityCheckerWidgetTopSection {
    display: flex;
    align-items: center;
}

.connectivityCheckerWidgetBottomSection {
    display: flex;
    justify-content: flex-end;
}

.connectivityCheckerWidgetBottomSection > .mwWidget {
    margin-left: 4px;
}

.connectivityCheckerWidgetTable {
    width: 100%;
    margin: 20px 0;
    cursor: default;
}

.connectivityCheckerWidgetTable > tbody > tr:nth-child(even) {
  background-color: var(--mw-backgroundColor-primary);
}

.connectivityCheckerWidgetTable > tbody > tr:nth-child(odd) {
  background-color: var(--mw-backgroundColor-secondary);
}

.connectivityCheckerWidgetTable td,
.connectivityCheckerWidgetTable th {
    white-space: nowrap;
    padding: 8px 4px;
    border: 1px solid var(--mw-borderColor-secondary);
}

.connectivityCheckerWidgetTable .field-status {
    min-width: 80px;
}

.connectivityCheckerWidgetTable .field-description {
    width: 100%;
}

.connectivityCheckerWidgetTable td.connectivityCheckerStageDescription {
    white-space: normal;
}

.connectivityCheckerWidgetStatus {
    margin: 0 10px;
    flex: 1;
}

.connectivityCheckerWidgetStatusLabel {
    font-weight: bold;
}

.connectivityCheckerStageStatusFailed .connectivityCheckerStageDescription {
    color: var(--mw-color-error);
}

.connectivityCheckerWidgetDetailsDialog.mwDialog {
    height: 510px;
    width: 450px;
}

.connectivityCheckerDetails {
    user-select: text;
    height: 100%;
    overflow: auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.connectivityCheckerDetailsStage:not(:first-child) {
    margin-top: 8px;
}

.connectivityCheckerDetailsStageHeading {
    font-weight: bold;
}
`,"",{version:3,sources:["webpack://./../content/pct/css/connectivityCheck.css"],names:[],mappings:"AAAA;;EAEE;;AAEF;IACI,YAAY;IACZ,aAAa;IACb,gBAAgB;IAChB,iBAAiB;AACrB;;AAEA;IACI,aAAa;IACb,sBAAsB;IACtB,YAAY;IACZ,YAAY;AAChB;;AAEA;IACI,SAAS;AACb;;AAEA;IACI,aAAa;IACb,mBAAmB;AACvB;;AAEA;IACI,aAAa;IACb,yBAAyB;AAC7B;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,WAAW;IACX,cAAc;IACd,eAAe;AACnB;;AAEA;EACE,mDAAmD;AACrD;;AAEA;EACE,qDAAqD;AACvD;;AAEA;;IAEI,mBAAmB;IACnB,gBAAgB;IAChB,iDAAiD;AACrD;;AAEA;IACI,eAAe;AACnB;;AAEA;IACI,WAAW;AACf;;AAEA;IACI,mBAAmB;AACvB;;AAEA;IACI,cAAc;IACd,OAAO;AACX;;AAEA;IACI,iBAAiB;AACrB;;AAEA;IACI,4BAA4B;AAChC;;AAEA;IACI,aAAa;IACb,YAAY;AAChB;;AAEA;IACI,iBAAiB;IACjB,YAAY;IACZ,cAAc;IACd,aAAa;IACb,sBAAsB;IACtB,8BAA8B;AAClC;;AAEA;IACI,eAAe;AACnB;;AAEA;IACI,iBAAiB;AACrB",sourcesContent:[`/*
