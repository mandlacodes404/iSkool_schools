         data-dojo-attach-point="clusterDetailsIncompatible"
         text="\${nls.LabelIncompatible}"
         iconId="warning"></mw-progress-or-icon-label>
</div>
`},"dojo/text!pct/app/cluster/discovery/panes/DiscoveryCompletedPane.html":m=>{m.exports=`<div>
