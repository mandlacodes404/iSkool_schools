 * Copyright 2015-2025 The MathWorks, Inc.
 */

.jobMonitor {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 16px;
}

.jobMonitorHeader, .jobMonitorFooter {
    display: flex;
    align-items: center;
}

.jobMonitorProfileSelector {
    margin: 0 4px;
}

.jobMonitorTableGrid {
    display: flex;
    position: relative;
    flex: 1;
    cursor: default;
    margin: 16px 0;
    overflow-y: hidden;
}

.jobMonitorTableGrid .mw-table-component > div {
    background-color: transparent;
}

.jobMonitorStatus {
    flex: 1 1 auto;
    font-style: italic;
}

.jobMonitorUpdateFrequency .mwTextFieldDisabled .mwInputNode,
.jobMonitorUpdateFrequency .mwTextFieldDisabled {
    cursor: default;
}

.jobMonitorUpdateButton,
.jobMonitorUpdateFrequency {
    margin-left: 4px;
}

.jobMonitorOverlay {
    justify-content: center;
    position: absolute;
    display: flex;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--mw-backgroundColor-tertiary, #fff);
    opacity: 0.85;
    z-index: 2;
}

.jobMonitorOverlay p {
    display: flex;
    align-items: center;
    text-align: center;
}

.jobMonitorTextLabel {
    color: var(--mw-color-primary);
}
