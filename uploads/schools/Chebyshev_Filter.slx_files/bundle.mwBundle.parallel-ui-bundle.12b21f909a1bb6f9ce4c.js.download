    </div>
    <div class="\${baseClass}Line">
        <span class="validationReportLabel">\${nls.ValidationReportLabelStageFinishTime}</span>
        <span class="validationReportValue"
              data-dojo-attach-point="finishTimeNode">\${stage.finishedAt}</span>
    </div>
    <div class="\${baseClass}Line">
        <span class="validationReportLabel">\${nls.ValidationReportLabelStageDuration}</span>
        <span class="validationReportValue"
              data-dojo-attach-point="durationNode">\${stage.duration}</span>
    </div>
    <div class="\${baseClass}Line">
        <span class="validationReportLabel">\${nls.ValidationReportLabelStageDescription}</span>
