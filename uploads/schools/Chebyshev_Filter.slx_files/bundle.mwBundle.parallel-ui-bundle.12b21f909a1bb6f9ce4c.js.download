                data-dojo-attach-point="cancelValidationButton"
                data-dojo-attach-event="click: _stopValidation"
                data-dojo-props="text: '\${nls.ActionsValidateStopText}'">
        </button>
        <button id="\${id}ReportButton"
                class="\${baseClass}ReportButton pctTabViewActionButton"
                data-dojo-type="mw-form/PushButton"
                data-dojo-attach-event="click: _handleShowReport"
                data-dojo-props="text: '\${nls.ValidationReportButton}'">
        </button>
    </div>
</div>
`},"dojo/text!pct/app/jobmonitor/JobMonitor.html":m=>{m.exports=`<div>
    <div class="\${baseClass}Header">
        <div class="pctNoWrap \${baseClass}TextLabel">\${nls.SelectProfile}</div>
