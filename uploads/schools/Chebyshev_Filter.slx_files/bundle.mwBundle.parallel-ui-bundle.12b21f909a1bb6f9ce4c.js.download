 * Copyright 2024 The MathWorks, Inc.
 */

/* TOOLBAR */

.panelToolbarContainer {
    width: 100%;
    height: 76px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    background-color: transparent;
    overflow: hidden;
}

/* TOOLBAR BUTTONS */

.environmentToolbarButton {
    height: 72px;
    max-width: 54px;
    --mw-backgroundColor-button: transparent;
    --mw-borderColor-button: transparent;
    margin-right: 0px;
    margin-left: 2px;
}

/* ENVIRONMENT PANES */

#pctClusterPane .dijitTitlePaneTitle,
#pctGpuPane     .dijitTitlePaneTitle {
    background: var(--mw-backgroundColor-secondary);
    border: 1px solid var(--mw-borderColor-secondary);
    color: var(--mw-color-primary);
}

#pctClusterPane .dijitTitlePaneContentOuter,
#pctClusterPane .dijitTitlePaneContentInner,
#pctGpuPane     .dijitTitlePaneContentOuter,
#pctGpuPane     .dijitTitlePaneContentInner {
    padding: 0;
    background: var(--mw-backgroundColor-primary);
    border: none !important;
    overflow: hidden;
}

/* CLUSTER PROFILE TABLE */

#pct_parallel_panel .mw-table-outer-wrapper,
#pct_parallel_panel .mw-table-outer-wrapper-blurred {
    border: none;
}

#pct_parallel_panel td.mw-table-cell {
    /* Ensures the mw-table cells are large enough to show the full cards */
    height: 100%;
}

#pct_parallel_panel td.mw-table-row {
    border-radius: 2px;
}

#pct_parallel_panel .mw-table-inner-wrapper {
    /* Prevents pointless vertical scrollbar appearing within table.
       The only scrollbar we want is that of the parallel panel itself. */
    overflow: hidden;
}

/* CLUSTER PROFILE AND GPU CARDS */

.pctPanelClusterProfileCardContainer {
    display: flex;
    overflow: hidden;
    justify-content: space-between;
    padding: 4px;
}

.pctPanelClusterProfileCardInfoContainer {
    flex-grow: 1;
    overflow: hidden;
}

.pctPanelClusterProfileCardDescription {
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 100%;
}

.pctPanelClusterProfileCardButtonContainer {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    padding: 2px;
    align-items: center;
    gap: 1px;
}

.pctPanelGpuCardContainer {
    padding: 4px;
}

/* Profile/GPU name */
.pctPanelClusterProfileCardTitle,
.pctPanelGpuCardName {
    font-size: 15;
    font-weight: bold;
}

/* Buttons on cluster profile cards */
.cardButton {
    height: 24px;
    width: 24px;
    background-color: transparent;
    border: transparent solid 1px;
    --mw-backgroundColor-button: transparent;
    --mw-borderColor-button: transparent;
}

/* Bottom of GPU section, offering help for if your GPU isn't shown */
.missingGpuCard {
    padding: 10px 4px;
    color: var(--mw-color-primary);
    background-color: transparent;
    justify-content: center;
    align-items: center;
    display: flex;
    overflow: hidden;
}
