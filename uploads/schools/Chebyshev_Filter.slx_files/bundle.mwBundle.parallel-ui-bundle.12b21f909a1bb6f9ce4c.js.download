.pctDialogNoScrollbar.mwDialog .mwDialogBody {
    /* workaround for forced padding for scroll-bar in mw-dialogs. See g1887490 */
    padding: 0 0 4px 0 !important;
    overflow: hidden;
}

.pctDialog.mwDialog .mwDialogBody.mwNoButtons {
    height: calc(100% - 35px);
}

.mwProgressOrIconLabel {
    display: flex;
    align-items: center;
    line-height: 1;
