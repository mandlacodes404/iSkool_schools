    <div class="\${baseClass}Line">
        <span class="validationReportLabel">\${nls.ValidationReportLabelStageDebugLog}</span>
        <span class="validationReportValue"
              data-dojo-attach-point="debugLogNode">\${stage.debugLog}</span>
    </div>
</div>
`},"dojo/text!pct/app/cluster/profiles/validation/ValidationReportView.html":m=>{m.exports=`<div>
    <div class="\${baseClass}Header Header">\${nls.ValidationReportHeader}</div>
