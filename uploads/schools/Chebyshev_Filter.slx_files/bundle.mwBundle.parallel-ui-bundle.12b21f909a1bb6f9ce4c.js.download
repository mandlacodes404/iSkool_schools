 * Copyright 2015-2023 The MathWorks, Inc.
 */

.discoverWizardDialogFrame {
    height: 415px;
    min-height: 415px;
    width: 723px;
    min-width: 710px;
}

.discoveryWizard {
    height: 100%;
    display: flex;
    flex-direction: column;
}

.discoveryWizard:not(.discoverAllTargets) .discoveryWizardPaneAllTargets,
.discoveryWizard.discoverAllTargets .discoveryWizardPaneCloudOnly {
    display: none;
}

.discoveryWizardStackContainer {
    border-bottom: 1px solid var(--mw-borderColor-primary);
    flex: 1;
}

.discoveryWizardButtons {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    height: 42px;
}

.discoveryWizardButton {
    margin-left: 5px;
}

.discoveryTableGrid {
    height: 100%;
    cursor: default;
}

.discoveryTableGrid .mw-table-component > div {
    background-color: transparent;
}


.discoveryClusterIncompatible {
    color: var(--mw-icon-border-disabled-gray);
}

.discoveryWizardPaneStatus {
    padding-bottom: 20px;
    display: block;
}

.discoveryWizardPaneStatusNotFound {
    line-height: 32px;
}

.discoveryWizardPaneClusterNotFoundDescription {
    padding-left: 30px;
}

.discoveryWizardPaneClusters {
    display: flex;
    flex-direction: column;
}

.discoveryWizardPaneClustersTable {
    flex: 1;
    padding: 10px 0;
}

.discoveryWizardPaneClustersTable .mw-table-scroll-container {
    max-height: 120px;
}

.discoveryWizardPaneClusterDetails {
    padding: 3px 0;
}

.discoveryWizardPaneTargetGroup {
    margin: 25px 0;
}

.discoveryWizardPaneTargetDescription {
    padding: 3px 0 0 17px;
}

`,"",{version:3,sources:["webpack://./../content/pct/css/discovery.css"],names:[],mappings:"AAAA;;EAEE;;AAEF;IACI,aAAa;IACb,iBAAiB;IACjB,YAAY;IACZ,gBAAgB;AACpB;;AAEA;IACI,YAAY;IACZ,aAAa;IACb,sBAAsB;AAC1B;;AAEA;;IAEI,aAAa;AACjB;;AAEA;IACI,sDAAsD;IACtD,OAAO;AACX;;AAEA;IACI,aAAa;IACb,qBAAqB;IACrB,yBAAyB;IACzB,YAAY;AAChB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,YAAY;IACZ,eAAe;AACnB;;AAEA;IACI,6BAA6B;AACjC;;;AAGA;IACI,0CAA0C;AAC9C;;AAEA;IACI,oBAAoB;IACpB,cAAc;AAClB;;AAEA;IACI,iBAAiB;AACrB;;AAEA;IACI,kBAAkB;AACtB;;AAEA;IACI,aAAa;IACb,sBAAsB;AAC1B;;AAEA;IACI,OAAO;IACP,eAAe;AACnB;;AAEA;IACI,iBAAiB;AACrB;;AAEA;IACI,cAAc;AAClB;;AAEA;IACI,cAAc;AAClB;;AAEA;IACI,qBAAqB;AACzB",sourcesContent:[`/*
