            ><div data-dojo-attach-point="iconNode" class="mwIconNode"></div
            ><div data-dojo-attach-point="textNode" class="mwTextNode"></div
        ></div
    ></div
></div>`},"dojo/text!mw-notifications/templates/ProgressBar.html":m=>{m.exports='<div data-test-id="${data-test-id}" data-value="${value}">\n    <div data-dojo-attach-point="gutterNode" class="${baseClass}Gutter">\n        <div data-dojo-attach-point="progressNode" class="${baseClass}Progress"></div>\n    </div>\n    <div data-dojo-attach-point="progressTextNode" class="${baseClass}Text">50%</div>\n</div>'},"dojo/text!mw-overlay-utils/templates/busyOverlayTemplate.html":m=>{m.exports=`<div class="mw-busyIndicator" data-dojo-attach-point="_busyOverlayNode">
	<div class="underlayNode"  data-dojo-attach-point="_underlayNode"></div>
	<div class="spinnerBgPanel" tabindex = "0" data-dojo-attach-point="_spinnerBgPanel">
		<div class="spinnerNode" data-dojo-attach-point="_spinnerNode" ></div>
	</div>
</div>
`},"dojo/text!pct/app/cloud/connectivity/ConnectivityCheckDetailsStageWidget.html":m=>{m.exports=`<div>
    <div id="\${id}Heading"
         class="\${baseClass}Heading"
         data-dojo-attach-point="nameNode">\${name}
    </div>
    <div id="\${id}Status"
         class="\${baseClass}Status">
         <span class="\${baseClass}Label">\${nls.LabelDetailsStatus}</span>
         <span class="\${baseClass}Value"
               data-dojo-attach-point="statusNode">\${statusLabel}</span>
    </div>
    <div id="\${id}Details"
         class="\${baseClass}Details">
         <span class="\${baseClass}Label">\${nls.LabelDetailsDetails}</span>
         <span class="\${baseClass}Value"
               data-dojo-attach-point="detailsNode">\${details}</span>
    </div>
    <div id="\${id}Description"
         class="\${baseClass}Description">
         <span class="\${baseClass}Label">\${nls.LabelDetailsDescription}</span>
         <span class="\${baseClass}Value"
               data-dojo-attach-point="descriptionNode">\${description}</span>
    </div>
    <div id="\${id}Error"
         class="\${baseClass}Error">
         <span class="\${baseClass}Label">\${nls.LabelDetailsErrorReport}</span>
         <span class="\${baseClass}Value"
               data-dojo-attach-point="errorNode">\${error}</span>
    </div>
</div>`},"dojo/text!pct/app/cloud/connectivity/ConnectivityCheckStageWidget.html":m=>{m.exports=`<tr>
    <td data-dojo-attach-point="nameNode">\${stage.name}</td>
    <td class="\${baseClass}Status">
        <mw-progress-or-icon-label
            data-dojo-attach-point="statusNode"></mw-progress-or-icon-label>
    </td>
    <td data-dojo-attach-point="descriptionNode">\${stage.description}</td>
</tr>
`},"dojo/text!pct/app/cloud/connectivity/ConnectivityCheckTable.html":m=>{m.exports=`<table>
    <thead>
    <tr>
        <th class="field-stage">\${nls.TableColumnStage}</th>
        <th class="field-status">\${nls.TableColumnStatus}</th>
        <th class="field-description">\${nls.TableColumnDescription}</th>
    </tr>
    </thead>
    <tbody data-dojo-attach-point="tableBody">
    </tbody>
</table>`},"dojo/text!pct/app/cloud/connectivity/ConnectivityCheckWidget.html":m=>{m.exports=`<div>
    <div class="\${baseClass}TopSection">
        <div class="\${baseClass}StatusLabel">\${nls.LabelVerificationStatus}</div>
        <mw-progress-or-icon-label
             id="\${id}Status"
             class="\${baseClass}Status"
             data-dojo-attach-point="statusNode"></mw-progress-or-icon-label>
    </div>

    <div id="\${id}Table"
         class="\${baseClass}Table"
         data-dojo-attach-point="table"
         data-dojo-type="pct/app/cloud/connectivity/ConnectivityCheckTable"></div>

    <div class="\${baseClass}BottomSection">
        <div id="\${id}StartButton"
             data-dojo-type="mw-form/PushButton"
             data-dojo-props="text: '\${nls.ButtonStart}', disabled: true"
             data-dojo-attach-point="startButton"
             data-dojo-attach-event="click: _handleStartClicked">
        </div>
        <div id="\${id}CancelButton"
             style="display: none"
             data-dojo-type="mw-form/PushButton"
             data-dojo-props="text: '\${nls.ButtonCancel}'"
             data-dojo-attach-point="cancelButton"
             data-dojo-attach-event="click: _handleCancelClicked">
        </div>

        <div id="\${id}DetailsButton"
             class="\${baseClass}DetailsButton"
             data-dojo-type="mw-form/PushButton"
             data-dojo-props="text: 'Show Details', disabled: true"
             data-dojo-attach-point="detailsButton"
             data-dojo-attach-event="click: _handleDetailsButtonClicked">
        </div>
    </div>
</div>
`},"dojo/text!pct/app/cluster/discovery/DiscoveryWizard.html":m=>{m.exports=`<div>
    <div id="\${id}StackContainer"
         class="\${baseClass}StackContainer"
         data-dojo-props="doLayout: false"
         data-dojo-type="dijit/layout/StackContainer"
         data-dojo-attach-point="stackContainer"
         data-dojo-id="stackContainer">
        <div data-dojo-type="pct/app/cluster/discovery/panes/DiscoveryWelcomePane"
             id="\${id}WelcomePane"></div>
        <div data-dojo-type="pct/app/cluster/discovery/panes/DiscoveryClusterListPane"
             id="\${id}ClusterListPane"></div>
        <div data-dojo-type="pct/app/cluster/discovery/panes/DiscoveryCompletedPane"
             id="\${id}CompletedPane"></div>
    </div>
    <div class="\${baseClass}Buttons">
        <button id="\${id}NextButton"
                class="\${baseClass}Button"
                data-dojo-type="mw-form/PushButton"
                data-dojo-props="text: '\${nls.ButtonsNext}'"
                data-dojo-attach-point="nextButton"
                data-dojo-attach-event="click: showNextPane">
        </button>
        <button id="\${id}CancelButton"
                class="\${baseClass}Button"
                data-dojo-type="mw-form/PushButton"
                data-dojo-props="text: '\${nls.ButtonsCancel}'"
                data-dojo-attach-point="cancelButton"
                data-dojo-attach-event="click: _handleCancelClicked">
        </button>
        <button id="\${id}FinishButton"
                class="\${baseClass}Button"
                data-dojo-type="mw-form/PushButton"
                data-dojo-props="text: '\${nls.ButtonsFinish}'"
                data-dojo-attach-point="finishButton"
                data-dojo-attach-event="click: _handleFinishClicked">
        </button>
    </div>
</div>
`},"dojo/text!pct/app/cluster/discovery/panes/DiscoveryClusterListPane.html":m=>{m.exports=`<div class="\${baseClass}Clusters">
    <mw-progress-or-icon-label
         data-dojo-attach-point="statusMessage"
         text="\${nls.StatusStarted}"
         progress="true"
         id="\${id}Status"
         class="\${baseClass}Status">
    </mw-progress-or-icon-label>
    <div>
        \${nls.LabelSelectCluster}
    </div>
    <div id="\${id}Table"
         class="\${baseClass}ClustersTable"
