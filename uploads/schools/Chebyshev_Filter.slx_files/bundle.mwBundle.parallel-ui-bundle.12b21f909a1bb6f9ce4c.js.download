</div>`},"dojo/text!MW/layout/templates/CollapsedBorderChildH.html":m=>{m.exports='<div class="gripH"></div>'},"dojo/text!MW/layout/templates/CollapsedBorderChildV.html":m=>{m.exports='<div class="gripV"></div>'},"dojo/text!MW/layout/templates/Tab.html":m=>{m.exports=`<div class="tab">
