    border-bottom: 1px solid #F8F9FA;
}

.rtePane .veSpecifier .veTable .dataBody .cell .plainText {
    text-align: right;
}

.rtePane .veSpecifier .veTable .dataBody .row .cell {
    border-bottom: 1px solid #E9E9E9;
    border-right: 1px solid #E9E9E9;
}`},a68a816f4358eae82690c9a7fcb0b586ed11131a:a=>{a.exports=`.rtePane .embeddedOutputsVariableElement {
