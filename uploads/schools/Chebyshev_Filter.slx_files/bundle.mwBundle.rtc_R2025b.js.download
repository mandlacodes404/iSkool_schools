            % of the task by clicking the options button`,createComponents:"% Add your implementation here"}},"ja-jp":!0,"ko-kr":!0,"zh-cn":!0}},"l10n/nls/toolstrip":(a,A,t)=>{a.exports={root:{toolstripLabel:"Toolstrip",showLabel:"Show Label",hideLabel:"Hide Label",QAB:"Quick Access Toolbar",removeFromQAB:"Remove from Quick Access Toolbar",addToQAB:"Add to Quick Access Toolbar",qabDefaultDropdownLabel:"Common Controls",qabOverflowDropdownLabel:"More Controls",restoreFactoryControls:"Restore Defaults",restoreFactoryControlsDialogTitle:"Confirm Restore",restoreFactoryControlsDialogMessage:"All customizations will be deleted and the Quick Access Toolbar will be restored to the default settings.\u200B",minimizeToolstrip:"Minimize Toolstrip",restoreToolstrip:"Restore Toolstrip",closeWidget:'Close "${0}" Tab',removeWidget:'Remove "${0}" from Gallery',homeButtonLabel:"MATLAB Home",gallerySearch:"Search",showMore:"Show more",noSearchMatchNode:"No items match your search.",emptyCategoryPlaceholder:"This category is empty",listView:"Details view",iconView:"Icon view",navTop:"Move category to top",navBottom:"Move category to bottom",favStarAdd:"Add to favorites",favStarRemove:"Remove from favorites",editWidget:'Edit "${0}"',favoritesCategoryTitle:"FAVORITES",closeGallery:"Close gallery popup",colorPickerRecentColorsTitle:"Recent Colors"},"ja-jp":!0,"ko-kr":!0,"zh-cn":!0}},"l10n/nls/zh-cn/exportFolderDialog":(a,A,t)=>{a.exports={copyFilesLabel:"\u590D\u5236\u652F\u6301\u6587\u4EF6",copyFilesTooltip:"\u5C06\u652F\u6301\u6587\u4EF6\u590D\u5236\u5230\u5BFC\u51FA\u7684\u6587\u4EF6\u5939\u3002",exportFolder:"\u5BFC\u51FA",error:"\u6587\u4EF6\u4E2D\u7684\u9519\u8BEF ",labelFormats:"\u5BFC\u51FA\u5230:",labelSource:"\u8981\u5BFC\u51FA\u7684\u6587\u4EF6\u5939:",labelTarget:"\u5BFC\u51FA\u7684\u6587\u4EF6\u7684\u4F4D\u7F6E:",overwriteLabel:"\u8986\u76D6\u524D\u8BE2\u95EE",overwriteTooltip:"\u5982\u679C\u5B58\u5728\u540C\u540D\u6587\u4EF6\uFF0C\u5728\u8986\u76D6\u8BE5\u6587\u4EF6\u4E4B\u524D\u8BE2\u95EE\u3002",placeholderSource:"/path/to/source/folder",placeholderTarget:"/path/to/export/folder",processingFile:"\u5904\u7406\u6587\u4EF6 ",startExport:"\u5F00\u59CB\u5BFC\u51FA",title:"\u5BFC\u51FA\u6587\u4EF6\u5939\u4E2D\u7684\u6587\u4EF6"}},"l10n/nls/zh-cn/template":(a,A,t)=>{a.exports={liveFunction:{summary:"\u6B64\u51FD\u6570\u7684\u7B80\u77ED\u6458\u8981\u3002",description:"\u6B64\u51FD\u6570\u7684\u8BE6\u7EC6\u8BF4\u660E\u3002"},plainExample:{title:"\u793A\u4F8B\u6807\u9898",summary:"\u793A\u4F8B\u76EE\u6807\u6458\u8981",sectionTitle1:"\u7B2C 1 \u8282\u6807\u9898",description1:"\u7B2C\u4E00\u4E2A\u4EE3\u7801\u5757\u7684\u63CF\u8FF0",sectionTitle2:"\u7B2C 2 \u8282\u6807\u9898",description2:"\u7B2C\u4E8C\u4E2A\u4EE3\u7801\u5757\u7684\u63CF\u8FF0"},plainFunction:{summary:"\u6B64\u5904\u663E\u793A\u6709\u5173\u6B64\u51FD\u6570\u7684\u6458\u8981",description:"\u6B64\u5904\u663E\u793A\u8BE6\u7EC6\u8BF4\u660E"},plainClass:{summary:"\u6B64\u5904\u663E\u793A\u6709\u5173\u6B64\u7C7B\u7684\u6458\u8981",description:"\u6B64\u5904\u663E\u793A\u8BE6\u7EC6\u8BF4\u660E",constructorSummary:"\u6784\u9020\u6B64\u7C7B\u7684\u5B9E\u4F8B",methodSummary:"\u6B64\u5904\u663E\u793A\u6709\u5173\u6B64\u65B9\u6CD5\u7684\u6458\u8981"},plainTestClass:{sharedSetupForTestClass:"\u6574\u4E2A\u6D4B\u8BD5\u7C7B\u7684\u5171\u4EAB\u8BBE\u7F6E",testLevelSetup:"\u6BCF\u4E2A\u6D4B\u8BD5\u7684\u8BBE\u7F6E",testMethodBlock:"\u6D4B\u8BD5\u65B9\u6CD5"},basisSysObj:{summary:"\u5728\u6B64\u6DFB\u52A0\u6458\u8981",description:`\u6B64\u6A21\u677F\u5305\u62EC\u5B9A\u4E49 System object 
    % \u6240\u9700\u7684\u6700\u5C0F\u51FD\u6570\u96C6\u3002`,publicTunableProp:"\u516C\u5171\u53EF\u8C03\u5C5E\u6027",precomputedConst:"\u9884\u5148\u8BA1\u7B97\u7684\u5E38\u91CF\u6216\u5185\u90E8\u72B6\u6001",setupImplSummary:"\u6267\u884C\u4E00\u6B21\u6027\u8BA1\u7B97\uFF0C\u4F8B\u5982\u8BA1\u7B97\u5E38\u91CF",stepImplSummary:`\u5B9E\u73B0\u7B97\u6CD5\u3002\u91C7\u7528\u5305\u542B\u8F93\u5165 u \u548C\u5185\u90E8\u72B6\u6001\u7684
            % \u51FD\u6570\u6765\u8BA1\u7B97 y\u3002`,resetImplSummary:"\u521D\u59CB\u5316/\u91CD\u7F6E\u5185\u90E8\u72B6\u6001"},advancedSysObj:{summary:"\u5728\u6B64\u6DFB\u52A0\u6458\u8981",note:`\u6CE8\u610F: \u5F53\u91CD\u547D\u540D\u7C7B\u65F6\uFF0C\u5FC5\u987B\u66F4\u65B0\u6587\u4EF6\u540D\u548C\u6784\u9020\u51FD\u6570\u540D\u79F0
    % \u4EE5\u4F7F\u7528\u7C7B\u540D\u79F0\u3002`,description:`\u6B64\u6A21\u677F\u5305\u62EC\u60A8\u53EF\u4EE5\u4E3A System object \u5B9E\u73B0\u7684\u5927\u90E8\u5206(\u4F46\u5E76\u975E\u5168\u90E8)\u53EF\u80FD\u7684\u5C5E\u6027\u3001
