            % false \uBC18\uD658`,getOutputSizeImplSummary:"\uAC01 \uCD9C\uB825 \uD3EC\uD2B8\uC5D0 \uB300\uD55C \uD06C\uAE30 \uBC18\uD658",getOutputSizeImplExample:"\uC608: \uCCAB \uBC88\uC9F8 \uC785\uB825 \uD3EC\uD2B8\uB85C\uBD80\uD130 \uD06C\uAE30 \uC0C1\uC18D",getIconImplSummary:"System \uBE14\uB85D\uC5D0 \uB300\uD55C \uC544\uC774\uCF58 \uC815\uC758",useClassName:"\uD074\uB798\uC2A4 \uC774\uB984 \uC0AC\uC6A9",getIconImplExample1:"\uC608: \uD14D\uC2A4\uD2B8 \uC544\uC774\uCF58",getIconImplExample2:"\uC608: \uC5EC\uB7EC \uB77C\uC778 \uD14D\uC2A4\uD2B8 \uC544\uC774\uCF58",getIconImplExample3:"\uC608: \uC774\uBBF8\uC9C0 \uD30C\uC77C \uC544\uC774\uCF58",simulinkCustomizationFunctions:"Simulink \uC0AC\uC6A9\uC790 \uC9C0\uC815 \uD568\uC218",getHeaderImplSummary:"System \uBE14\uB85D \uB300\uD654 \uC0C1\uC790\uC5D0 \uB300\uD55C \uD5E4\uB354 \uD328\uB110 \uC815\uC758",getPropertyGroupsImplSummary:"System \uBE14\uB85D \uB300\uD654 \uC0C1\uC790\uC5D0 \uB300\uD55C \uC18D\uC131 \uC139\uC158 \uC815\uC758"},liveTaskClass:{classSummary:"% \uC5EC\uAE30\uC5D0 \uC694\uC57D \uCD94\uAC00    % \uCC38\uACE0: \uC791\uC5C5\uC744 \uB4F1\uB85D/\uC5C5\uB370\uC774\uD2B8\uD558\uB824\uBA74 \uBA85\uB839 \uCC3D\uC5D0\uC11C matlab.task.configureMetadata\uB97C    % \uC2E4\uD589\uD558\uC2ED\uC2DC\uC624. \uB4F1\uB85D\uC744 \uCDE8\uC18C\uD558\uB824\uBA74 matlab.task.removeMetadata\uB97C \uC2E4\uD589\uD558\uC2ED\uC2DC\uC624    % \uC774 \uD074\uB798\uC2A4\uB294 \uAE30\uBCF8 \uD074\uB798\uC2A4 LiveTask\uB97C \uD655\uC7A5\uD558\uACE0    % \uBD80\uBAA8 \uD074\uB798\uC2A4\uC5D0 \uC815\uC758\uB41C \uBAA8\uB4E0 \uCD94\uC0C1 \uBA54\uC11C\uB4DC\uC5D0 \uB300\uD55C    % \uAD6C\uD604\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4.",commentForUIElements:"% \uC5EC\uAE30\uC5D0 UI \uC694\uC18C \uC120\uC5B8",statePropComment:"% \uC0C1\uD0DC \uC18D\uC131\uC740 \uC791\uC5C5\uC5D0 \uC788\uB294 UI \uAC1D\uCCB4\uC758 \uD604\uC7AC \uC0C1\uD0DC\uB97C \uC800\uC7A5\uD558\uBA70, \uAD6C\uC870\uCCB4\uB85C \uC9C0\uC815\uB429\uB2C8\uB2E4.",summaryPropComment:"% \uC791\uC5C5 \uC694\uC57D\uC73C\uB85C, string\uD615 \uC2A4\uCE7C\uB77C \uB610\uB294 \uBB38\uC790\uD615 \uBCA1\uD130\uB85C \uC9C0\uC815\uB429\uB2C8\uB2E4.",setupMethodComment:"% \uC791\uC5C5\uC758 \uCD08\uAE30 \uC0C1\uD0DC\uB97C \uC124\uC815\uD558\uB294 \uBA54\uC11C\uB4DC\uC785\uB2C8\uB2E4.            % \uC774 \uBA54\uC11C\uB4DC\uB294 \uC791\uC5C5\uC774 \uC0DD\uC131\uB420 \uB54C \uD638\uCD9C\uB429\uB2C8\uB2E4.            % \uC5EC\uAE30\uC5D0 \uAD6C\uD604 \uCD94\uAC00",generateCodeMethodComment:"% \uC791\uC5C5\uC5D0 \uB300\uD55C \uCF54\uB4DC \uBC0F \uCD9C\uB825\uAC12\uC744 \uC0DD\uC131\uD558\uB294 \uBA54\uC11C\uB4DC\uC785\uB2C8\uB2E4.            % \uC774 \uD074\uB798\uC2A4\uC758 \uC815\uBCF4\uB9CC \uC0AC\uC6A9\uD558\uC5EC \uCF54\uB4DC\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4.            % \uC5EC\uAE30\uC5D0 \uAD6C\uD604 \uCD94\uAC00",getSummaryComment:"% \uC791\uC5C5\uC758 \uC694\uC57D\uC744 \uAC00\uC838\uC624\uAE30 \uC704\uD574 \uC774 \uBA54\uC11C\uB4DC\uB97C \uC815\uC758\uD569\uB2C8\uB2E4.            % \uD574\uB2F9 \uC791\uC5C5\uC774 \uD558\uB294 \uC77C\uC5D0 \uB300\uD55C \uC124\uBA85\uC744 \uB3D9\uC801\uC73C\uB85C \uC0DD\uC131\uD558\uB294 \uB370 \uC0AC\uC6A9\uB429\uB2C8\uB2E4.",getStateComment:"% \uC791\uC5C5 \uC9C1\uB82C\uD654\uB97C \uC704\uD574 jsonencode\uC640 \uD568\uAED8 \uC0AC\uC6A9\uB428",setStateComment:"% \uC791\uC5C5 \uBCF5\uC6D0\uC744 \uC704\uD574 jsondecode\uC640 \uD568\uAED8 \uC0AC\uC6A9\uB428",resetMethodComment:"% \uC774 \uBA54\uC11C\uB4DC\uB294 \uC0AC\uC6A9\uC790\uAC00 \uC635\uC158 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uC5EC \uC791\uC5C5\uC758 \uB514\uD3F4\uD2B8 \uAC12\uC744            % \uBCF5\uC6D0\uD560 \uB54C \uD638\uCD9C\uB429\uB2C8\uB2E4",createComponents:"% \uC5EC\uAE30\uC5D0 \uAD6C\uD604 \uCD94\uAC00"}}},"l10n/nls/ko-kr/toolstrip":(a,A,t)=>{a.exports={toolstripLabel:"\uD234\uC2A4\uD2B8\uB9BD",showLabel:"\uB808\uC774\uBE14 \uD45C\uC2DC",hideLabel:"\uB808\uC774\uBE14 \uC228\uAE30\uAE30",QAB:"\uBE60\uB978 \uC561\uC138\uC2A4 \uB3C4\uAD6C \uBAA8\uC74C",removeFromQAB:"\uBE60\uB978 \uC561\uC138\uC2A4 \uB3C4\uAD6C \uBAA8\uC74C\uC5D0\uC11C \uC81C\uAC70",addToQAB:"\uBE60\uB978 \uC561\uC138\uC2A4 \uB3C4\uAD6C \uBAA8\uC74C\uC5D0 \uCD94\uAC00",qabDefaultDropdownLabel:"\uC77C\uBC18 \uCEE8\uD2B8\uB864",qabOverflowDropdownLabel:"\uCD94\uAC00 \uCEE8\uD2B8\uB864",restoreFactoryControls:"\uB514\uD3F4\uD2B8 \uAC12 \uBCF5\uC6D0",restoreFactoryControlsDialogTitle:"\uBCF5\uC6D0 \uD655\uC778",restoreFactoryControlsDialogMessage:"\uBAA8\uB4E0 \uC0AC\uC6A9\uC790 \uC9C0\uC815\uC774 \uC0AD\uC81C\uB418\uACE0 \uBE60\uB978 \uC561\uC138\uC2A4 \uB3C4\uAD6C \uBAA8\uC74C\uC774 \uB514\uD3F4\uD2B8 \uC124\uC815\uC73C\uB85C \uBCF5\uC6D0\uB429\uB2C8\uB2E4.\u200B",minimizeToolstrip:"\uD234\uC2A4\uD2B8\uB9BD \uCD5C\uC18C\uD654",restoreToolstrip:"\uD234\uC2A4\uD2B8\uB9BD \uBCF5\uC6D0",closeWidget:'"${0}" \uD0ED \uB2EB\uAE30',removeWidget:'\uAC24\uB7EC\uB9AC\uC5D0\uC11C "${0}" \uC81C\uAC70',homeButtonLabel:"MATLAB \uD648",gallerySearch:"\uAC80\uC0C9",showMore:"\uB354 \uBCF4\uAE30",noSearchMatchNode:"\uAC80\uC0C9\uC5B4\uC640 \uC77C\uCE58\uD558\uB294 \uD56D\uBAA9\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.",emptyCategoryPlaceholder:"\uC774 \uBC94\uC8FC\uB294 \uBE44\uC5B4 \uC788\uC74C",listView:"\uC138\uBD80 \uC815\uBCF4 \uBCF4\uAE30",iconView:"\uC544\uC774\uCF58 \uBCF4\uAE30",navTop:"\uBC94\uC8FC\uB97C \uB9E8 \uC704\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.",navBottom:"\uBC94\uC8FC\uB97C \uB9E8 \uC544\uB798\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.",favStarAdd:"\uC990\uACA8\uCC3E\uAE30\uC5D0 \uCD94\uAC00",favStarRemove:"\uC990\uACA8\uCC3E\uAE30\uC5D0\uC11C \uC81C\uAC70",editWidget:'"${0}" \uD3B8\uC9D1',favoritesCategoryTitle:"\uC990\uACA8\uCC3E\uAE30",closeGallery:"\uAC24\uB7EC\uB9AC \uD31D\uC5C5 \uB2EB\uAE30",colorPickerRecentColorsTitle:"\uCD5C\uADFC\uC5D0 \uC0AC\uC6A9\uD55C \uC0C9"}},"l10n/nls/template":(a,A,t)=>{a.exports={root:{liveFunction:{summary:"Brief summary of this function.",description:"Detailed explanation of this function."},plainExample:{title:"Example Title",summary:"Summary of example objective",sectionTitle1:"Section 1 Title",description1:"Description of first code block",sectionTitle2:"Section 2 Title",description2:"Description of second code block"},plainFunction:{summary:"Summary of this function goes here",description:"Detailed explanation goes here"},plainClass:{summary:"Summary of this class goes here",description:"Detailed explanation goes here",constructorSummary:"Construct an instance of this class",methodSummary:"Summary of this method goes here"},plainTestClass:{sharedSetupForTestClass:"Shared setup for the entire test class",testLevelSetup:"Setup for each test",testMethodBlock:"Test methods"},basisSysObj:{summary:"Add summary here",description:`This template includes the minimum set of functions required
