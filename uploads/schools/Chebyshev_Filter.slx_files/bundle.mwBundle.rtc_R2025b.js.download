tReset dijitInline" role="presentation"
	><span class="dijitReset dijitInline dijitButtonNode"
		data-dojo-attach-event="ondijitclick:__onClick" role="presentation"
		><span class="dijitReset dijitStretch dijitButtonContents"
			data-dojo-attach-point="titleNode,focusNode"
			role="button" aria-labelledby="\${id}_label"
			><span class="dijitReset dijitInline dijitIcon" data-dojo-attach-point="iconNode"></span
			><span class="dijitReset dijitToggleButtonIconChar">&#x25CF;</span
			><span class="dijitReset dijitInline dijitButtonText"
				id="\${id}_label"
				data-dojo-attach-point="containerNode"
			></span
		></span
	></span
	><input \${!nameAttrSetting} type="\${type}" value="\${value}" class="dijitOffScreen"
		data-dojo-attach-event="onclick:_onClick"
		tabIndex="-1" aria-hidden="true" data-dojo-attach-point="valueNode"
/></span>
`},"dojo/text!dijit/layout/templates/ScrollingTabController.html":a=>{a.exports=`<div class="dijitTabListContainer-\${tabPosition}" style="visibility:hidden">
	<div data-dojo-type="dijit.layout._ScrollingTabControllerMenuButton"
		 class="tabStripButton-\${tabPosition}"
		 id="\${id}_menuBtn"
		 data-dojo-props="containerId: '\${containerId}', iconClass: 'dijitTabStripMenuIcon',
					dropDownPosition: ['below-alt', 'above-alt']"
		 data-dojo-attach-point="_menuBtn" showLabel="false" title="">&#9660;</div>
	<div data-dojo-type="dijit.layout._ScrollingTabControllerButton"
		 class="tabStripButton-\${tabPosition}"
		 id="\${id}_leftBtn"
		 data-dojo-props="iconClass:'dijitTabStripSlideLeftIcon', showLabel:false, title:''"
		 data-dojo-attach-point="_leftBtn" data-dojo-attach-event="onClick: doSlideLeft">&#9664;</div>
	<div data-dojo-type="dijit.layout._ScrollingTabControllerButton"
		 class="tabStripButton-\${tabPosition}"
		 id="\${id}_rightBtn"
		 data-dojo-props="iconClass:'dijitTabStripSlideRightIcon', showLabel:false, title:''"
		 data-dojo-attach-point="_rightBtn" data-dojo-attach-event="onClick: doSlideRight">&#9654;</div>
	<div class='dijitTabListWrapper' data-dojo-attach-point='tablistWrapper'>
		<div role='tablist' data-dojo-attach-event='onkeydown:onkeydown'
			 data-dojo-attach-point='containerNode' class='nowrapTabStrip'></div>
	</div>
</div>`},"dojo/text!dijit/layout/templates/TabContainer.html":a=>{a.exports=`<div class="dijitTabContainer">
	<div class="dijitTabListWrapper" data-dojo-attach-point="tablistNode"></div>
	<div data-dojo-attach-point="tablistSpacer" class="dijitTabSpacer \${baseClass}-spacer"></div>
	<div class="dijitTabPaneWrapper \${baseClass}-container" data-dojo-attach-point="containerNode"></div>
</div>
`},"dojo/text!dijit/layout/templates/_ScrollingTabControllerButton.html":a=>{a.exports=`<div data-dojo-attach-event="ondijitclick:_onClick" class="dijitTabInnerDiv dijitTabContent dijitButtonContents"  data-dojo-attach-point="focusNode" role="button">
	<span role="presentation" class="dijitInline dijitTabStripIcon" data-dojo-attach-point="iconNode"></span>
	<span data-dojo-attach-point="containerNode,titleNode" class="dijitButtonText"></span>
</div>`},"dojo/text!dijit/layout/templates/_TabButton.html":a=>{a.exports=`<div role="presentation" data-dojo-attach-point="titleNode,innerDiv,tabContent" class="dijitTabInner dijitTabContent">
	<span role="presentation" class="dijitInline dijitIcon dijitTabButtonIcon" data-dojo-attach-point="iconNode"></span>
	<span data-dojo-attach-point='containerNode,focusNode' class='tabLabel'></span>
	<span class="dijitInline dijitTabCloseButton dijitTabCloseIcon" data-dojo-attach-point='closeNode'
		  role="presentation">
		<span data-dojo-attach-point='closeText' class='dijitTabCloseText'>[x]</span
				></span>
</div>
`},"dojo/text!dijit/templates/Dialog.html":a=>{a.exports=`<div class="dijitDialog" role="dialog" aria-labelledby="\${id}_title">
	<div data-dojo-attach-point="titleBar" class="dijitDialogTitleBar">
		<span data-dojo-attach-point="titleNode" class="dijitDialogTitle" id="\${id}_title"
				role="heading" level="1"></span>
		<span data-dojo-attach-point="closeButtonNode" class="dijitDialogCloseIcon" data-dojo-attach-event="ondijitclick: onCancel" title="\${buttonCancel}" role="button" tabindex="-1">
			<span data-dojo-attach-point="closeText" class="closeText" title="\${buttonCancel}">x</span>
		</span>
	</div>
	<div data-dojo-attach-point="containerNode" class="dijitDialogPaneContent"></div>
	\${!actionBarTemplate}
</div>

`},"dojo/text!dijit/templates/Menu.html":a=>{a.exports=`<table class="dijit dijitMenu dijitMenuPassive dijitReset dijitMenuTable" role="menu" tabIndex="\${tabIndex}"
	   cellspacing="0">
	<tbody class="dijitReset" data-dojo-attach-point="containerNode"></tbody>
</table>
`},"dojo/text!dijit/templates/MenuItem.html":a=>{a.exports=`<tr class="dijitReset" data-dojo-attach-point="focusNode" role="menuitem" tabIndex="-1">
	<td class="dijitReset dijitMenuItemIconCell" role="presentation">
		<span role="presentation" class="dijitInline dijitIcon dijitMenuItemIcon" data-dojo-attach-point="iconNode"></span>
	</td>
	<td class="dijitReset dijitMenuItemLabel" colspan="2" data-dojo-attach-point="containerNode,textDirNode"
		role="presentation"></td>
	<td class="dijitReset dijitMenuItemAccelKey" style="display: none" data-dojo-attach-point="accelKeyNode"></td>
	<td class="dijitReset dijitMenuArrowCell" role="presentation">
		<span data-dojo-attach-point="arrowWrapper" style="visibility: hidden">
			<span class="dijitInline dijitIcon dijitMenuExpand"></span>
			<span class="dijitMenuExpandA11y">+</span>
		</span>
	</td>
</tr>
`},"dojo/text!dijit/templates/Tooltip.html":a=>{a.exports=`<div class="dijitTooltip dijitTooltipLeft" id="dojoTooltip" data-dojo-attach-event="mouseenter:onMouseEnter,mouseleave:onMouseLeave"
	><div class="dijitTooltipConnector" data-dojo-attach-point="connectorNode"></div
	><div class="dijitTooltipContainer dijitTooltipContents" data-dojo-attach-point="containerNode" role='alert'></div
></div>
`},"dojo/text!dijit/templates/TooltipDialog.html":a=>{a.exports=`<div role="alertdialog" tabIndex="-1">
	<div class="dijitTooltipContainer" role="presentation">
		<div data-dojo-attach-point="contentsNode" class="dijitTooltipContents dijitTooltipFocusNode">
			<div data-dojo-attach-point="containerNode"></div>
			\${!actionBarTemplate}
		</div>
	</div>
	<div class="dijitTooltipConnector" role="presentation" data-dojo-attach-point="connectorNode"></div>
</div>
`},"dojo/text!mw-colorpicker/templates/ColorGradient.html":a=>{a.exports=`<div class="mwDisableSelection"
	><div data-dojo-attach-point='gradientNode' class="\${baseClass}SatVal"
        ><div id="gradientMarker" tabindex="0" data-dojo-attach-point='gradientMarkerNode' class="\${baseClass}Marker"
        ></div
    ></div

    ><div data-dojo-attach-point='hueNode' class="\${baseClass}Hue"
        ><div id="hueMarker" tabindex="0" data-dojo-attach-point='hueMarkerNode' class="\${baseClass}HueMarker"
        ></div
    ></div
></div>
`},"dojo/text!mw-colorpicker/templates/ColorPalette.html":a=>{a.exports=`<div class="dijitInline mwDisableSelection"
    ><span data-dojo-attach-point="titleNode" class="\${baseClass}Title">\${!title}</span
    ><table dojoAttachPoint="paletteTableNode" class="dijitPaletteTable" cellSpacing="0" cellPadding="0"
        ><tbody data-dojo-attach-point="gridNode"></tbody
    ></table
></div>`},"dojo/text!mw-colorpicker/templates/ColorPaletteSwatch.html":a=>{a.exports='<div class="dijitInline mwPaletteDiv"\n    ><div title="${title}" class="mwColorPaletteSwatch" style="background-color: ${color}" data-test-id="${color}"></div\n></div>\n'},"dojo/text!mw-colorpicker/templates/ColorPicker.html":a=>{a.exports=`<div class="mwDisableSelection" data-test-id="mwColorPicker"
	><table
		><tr
			><td
				><div class="\${baseClass}HeaderContainer"
					><span data-dojo-attach-point="titleNode" class="\${baseClass}Title"
					></span
					><div class="\${baseClass}ToggleButtonContainer"
						><div class="\${baseClass}ToggleButton" data-dojo-attach-point="standardButtonNode"
						></div
						><div class="\${baseClass}ToggleButton" data-dojo-attach-point="customButtonNode"
						></div
					></div
				></div
			></td
		></tr

		><tr
            ><td
            	><div data-dojo-attach-point="standardPickerRow"
	            	><div data-dojo-attach-point="paletteContainerNode" 
	            	><div class="\${baseClass}Palette" data-dojo-type="mw-colorpicker/ColorPalette" 
	            	data-dojo-attach-point="paletteNode" data-test-id="palette" data-dojo-props="palette: \${_parsedStandardColors}"
	            	></div
	            	></div
					><div class="\${baseClass}StylesContainer" data-dojo-attach-point="stylesContainerNode"></div
	    			><table class="\${baseClass}Middle"
	       				><tr
	            			><div class="\${baseClass}Recent" data-dojo-attach-point="recentColorsNode"
	            			data-test-id="recentColors"></div
	        			></tr
	    			></table
	    		></div
	    		><div class="\${baseClass}ViewHidden" data-dojo-attach-point="customPickerRow"
	    			><div class="\${baseClass}GradientContainer" data-dojo-attach-point="gradientContainerNode"></div
            		><div data-dojo-attach-point="spinnerContainerNode"></div
            	></div
			></td
		></tr

		><tr
			><td
				><div class="\${baseClass}Preview"
                    ><span data-dojo-attach-point="previewContainerNode"></span
                    ><div class="\${baseClass}PreviewColor" data-dojo-attach-point="previewColorNode"></div
            	></div 
            ></td
		></tr
	></table
></div>`},"dojo/text!mw-colorpicker/templates/ColorSpinner.html":a=>{a.exports=`<div class="mwDisableSelection"
    ><div
        ><div class="\${baseClass}ComboBox" data-dojo-type="mw-form/ComboBox" data-dojo-attach-point="comboBox"></div
    ></div
    ><div
        ><table
            ><tr data-dojo-attach-point="spinnersNode"
                ><td class="\${baseClass}Column"
                    ><div data-dojo-type="mw-form/Label" data-dojo-attach-point="titleNode1"
                    ></div
                    ><div class="\${baseClass}Spinner" data-dojo-type="mw-form/Spinner" data-test-id="ColorSpinner1" data-dojo-attach-point="spinnerNode1"
                    ></div
                ></td
                ><td class="\${baseClass}Column"
                    ><div data-dojo-type="mw-form/Label" data-dojo-attach-point="titleNode2"
                    ></div
                    ><div class="\${baseClass}Spinner" data-dojo-type="mw-form/Spinner" data-test-id="ColorSpinner2" data-dojo-attach-point="spinnerNode2" 
                    ></div
                ></td
                ><td class="\${baseClass}Column"
                    ><div data-dojo-type="mw-form/Label" data-dojo-attach-point="titleNode3"
                    ></div
                    ><div class="\${baseClass}Spinner" data-dojo-type="mw-form/Spinner" data-test-id="ColorSpinner3" data-dojo-attach-point="spinnerNode3" 
                    ></div>
                </td
            ></tr

            ><tr data-dojo-attach-point="hexNode" style="display: none"
                ><td class="\${baseClass}Column" colspan="3">\${_hexTitle}
                <div class="\${baseClass}TextField" data-dojo-type="mw-form/TextField" data-test-id="HexTextField" data-dojo-attach-point="hexTextField"></div
                ></td
            ></tr
        ></table
    ></div
></div>`},"dojo/text!mw-colorpicker/templates/ColorStyle.html":a=>{a.exports='<div tabindex="0" class="${baseClass}" data-dojo-attach-point="colorStyleButton" data-test-id="${value}ColorStyle"\n	><div class="${baseClass}Swatch" data-dojo-attach-point="colorStyleSwatch"></div\n	><span class="${baseClass}Label" data-dojo-attach-point="colorStyleLabel"></span\n></div>'},"dojo/text!mw-form/templates/CheckBox.html":a=>{a.exports=`<div data-dojo-attach-point="focusNode" role="checkbox" aria-checked="false"
    ><div data-dojo-attach-point="checkBoxRadioIconNode" class="mwCheckBoxRadioIconNode"
        ><div class="mwCheckBoxRadioIconInner"></div></div
    ><div data-dojo-attach-point="textNode" class="mwTextNode"></div
></div>`},"dojo/text!mw-form/templates/CheckBoxRadioButtonMenuItem.html":a=>{a.exports=`<div data-dojo-attach-point="focusNode" aria-checked="false"
    ><div class="mwTextAndDescriptionContainerNode" data-dojo-attach-point="textAndDescriptionContainerNode"
        ><div data-dojo-attach-point="textNode" class='mwTextNode'></div
        ><div data-dojo-attach-point="descriptionNode" class='mwDescriptionNode'></div
    ></div
    ><div class="mwShortcutKeyNode" data-dojo-attach-point="shortcutKeyNode"></div
    ><div class="mwOverlayNode"></div
></div>
`},"dojo/text!mw-form/templates/ComboBox.html":a=>{a.exports=`<div>
    <div class="mwComboBoxInnerContainer"><div class="mwTextFieldContainerNode" data-dojo-attach-point="textFieldContainerNode"></div><div class="mwArrowContainerNode" data-dojo-attach-point="arrowNode"><div class="mwArrowNode"></div></div></div>
</div>`},"dojo/text!mw-form/templates/DropDownButton.html":a=>{a.exports=`<div data-dojo-attach-point="contentWrapperNode" class="mwContentWrapperNode"
    ><div data-dojo-attach-point="focusNode" class="mwFocusNode"  role="button" aria-haspopup="true"
          aria-expanded="false"
        ><div data-dojo-attach-point="buttonNode" class="mwButtonNode"
            ><div data-dojo-attach-point="buttonAlignmentNode" class="mwButtonAlignmentNode"></div
            ><div data-dojo-attach-point="buttonContainerNode" class="mwButtonContainerNode"
                ><div data-dojo-attach-point="iconNode" class="mwIconNode"></div
                ><div data-dojo-attach-point="textNode" class="mwTextNode mwBlockTextNode"
                    ><div data-dojo-attach-point="textLine" class="mwTextContentNode"></div
                ></div
            ></div
        ></div
        ><div data-dojo-attach-point="dropDownNode" class="mwDropDownNode"
            ><div data-dojo-attach-point="dropDownAlignmentNode" class="mwDropDownAlignmentNode"></div
            ><div data-dojo-attach-point="dropDownContainerNode" class="mwDropDownContainerNode"
                ><div data-dojo-attach-point="inlineTextNode" class="mwTextNode mwInlineTextNode"
                    ><div data-dojo-attach-point="inlineTextLine" class="mwTextContentNode"></div
                ></div
                ><div data-dojo-attach-point="arrowNode" class="mwArrowNode"
                    ><div data-dojo-attach-point="lastTextLineNode" class="mwLastTextLineNode"
                        ><div data-dojo-attach-point="lastTextLine" class="mwTextContentNode"></div
                    ></div
                    ><div data-dojo-attach-point="arrowIconNode" class="mwArrowIconNode"></div
                ></div
            ></div
