    % {description}

    % {publicTunableProp}
    properties

    end

    % {publicNontunableProp}
    properties (Nontunable)

    end

    % {discreteProp}
    properties (DiscreteState)

    end

    % {precomputedConst}
    properties (Access = private)

    end

    methods
        % {constructorText}
        function obj = {fileName}(varargin)
            % {constructorSummary}
            setProperties(obj,nargin,varargin{:})
        end
    end

    methods (Access = protected)
        %% {commonFunctions}
        function setupImpl(obj)
            % {setupImplSummary}
        end

        function y = stepImpl(obj,u)
            % {stepImplSummary}
            y = u;
        end

        function resetImpl(obj)
            % {resetImplSummary}
        end

        %% {backupRestoreFunctions}
        function s = saveObjectImpl(obj)
            % {saveObjectImplSummary}

            % {setPublicPropState}
            s = saveObjectImpl@matlab.System(obj);

            % {setPrivateProtectedProp}
            %s.myproperty = obj.myproperty;
        end

        function loadObjectImpl(obj,s,wasLocked)
            % {loadObjectImplSummary}

            % {setPrivateProtectedProp}
            % obj.myproperty = s.myproperty; 

            % {setPublicPropState}
            loadObjectImpl@matlab.System(obj,s,wasLocked);
        end

        %% {advancedFunctions}
        function validateInputsImpl(obj,u)
            % {validateInputsImplSummary}
        end

        function validatePropertiesImpl(obj)
            % {validatePropertiesImplSummary}
        end

        function ds = getDiscreteStateImpl(obj)
            % {getDiscreteStateImplSummary}
            ds = struct([]);
        end

        function processTunedPropertiesImpl(obj)
            % {processTunedPropertiesImplSummary}
        end

        function flag = isInputSizeMutableImpl(obj,index)
            % {isInputSizeMutableImplSummary}
            flag = false;
        end

        function flag = isInactivePropertyImpl(obj,prop)
            % {isInactivePropertyImplSummary}
            flag = false;
        end
    end
end
`,simulinkExtensionSysObj:`classdef (StrictDefaults) {fileName} < matlab.System
    % {fileName} {summary}
    %
    % {note}
    %
    % {description}

    % {publicTunableProp}
    properties

    end

    % {publicNontunableProp}
    properties (Nontunable)

    end

    % {discreteProp}
    properties (DiscreteState)

    end

    % {precomputedConst}
    properties (Access = private)

    end

    methods
        % {constructorText}
        function obj = {fileName}(varargin)
            % {constructorSummary}
            setProperties(obj,nargin,varargin{:})
        end
    end

    methods (Access = protected)
        %% {commonFunctions}
        function setupImpl(obj)
            % {setupImplSummary}
        end

        function y = stepImpl(obj,u)
            % {stepImplSummary}
            y = u;
        end

        function resetImpl(obj)
            % {resetImplSummary}
        end

        %% {backupRestoreFunctions}
        function s = saveObjectImpl(obj)
            % {saveObjectImplSummary}

            % {setPublicPropState}
            s = saveObjectImpl@matlab.System(obj);

            % {setPrivateProtectedProp}
            %s.myproperty = obj.myproperty;
        end

        function loadObjectImpl(obj,s,wasLocked)
            % {loadObjectImplSummary}

            % {setPrivateProtectedProp}
            % obj.myproperty = s.myproperty; 

            % {setPublicPropState}
            loadObjectImpl@matlab.System(obj,s,wasLocked);
        end

        %% {simulinkFunctions}
        function ds = getDiscreteStateImpl(obj)
            % {getDiscreteStateImplSummary}
            ds = struct([]);
        end

        function flag = isInputSizeMutableImpl(obj,index)
            % {isInputSizeMutableImplSummary}
            flag = false;
        end

        function out = getOutputSizeImpl(obj)
            % {getOutputSizeImplSummary}
            out = [1 1];
            % {getOutputSizeImplExample}
            % out = propagatedInputSize(obj,1);
        end

        function icon = getIconImpl(obj)
            % {getIconImplSummary}
            icon = mfilename('class'); % {useClassName}
            % icon = 'My System'; % {getIconImplExample1}
            % icon = ['My','System']; % {getIconImplExample2}
            % icon = matlab.system.display.Icon('myicon.jpg'); % {getIconImplExample3}
        end
    end

    methods (Static, Access = protected)
        %% {simulinkCustomizationFunctions}
        function header = getHeaderImpl
            % {getHeaderImplSummary}
            header = matlab.system.display.Header(mfilename('class'));
        end

        function group = getPropertyGroupsImpl
            % {getPropertyGroupsImplSummary}
            group = matlab.system.display.Section(mfilename('class'));
        end
    end
end
