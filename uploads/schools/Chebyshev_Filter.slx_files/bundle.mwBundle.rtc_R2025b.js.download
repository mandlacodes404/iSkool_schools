  height: 22px;
  white-space: nowrap;
}

.rtePane .embeddedOutputsVariableTableElement .ClientViewDiv  table tr td,
.rtePane .embeddedOutputsVariableTableElement .ClientViewDiv  table tr th {
  background-color:white;
  text-overflow: ellipsis;
  font-family: 'Arial', sans-serif;
  font-size: 12px;
  overflow : hidden;
}

.rtePane .embeddedOutputsVariableTableElement .ClientViewDiv  table tr span {
  text-overflow: ellipsis;
  padding: 3px;
}
.rtePane .embeddedOutputsVariableTableElement .ClientViewDiv  table tr th {  
  color: rgba(0,0,0,0.5);
  padding: 3px;
  font-size: 9px;
}

/* ClientDocument has a summary bar child that takes up 17px, this clashes with overflow on the view which allots space for scrollbars. 
On print preview, this causes headers from <thead> to overlap on subsequent pages. Displaying Document as flex renders summarybar and view in column format and fixes the issue g2788485 */
.rtePane .embeddedOutputsVariableTableElement .ClientDocument {
  display: flex;
  flex-direction: column;
}`},"61403203f130ebb3131afe99186c27227e789137":a=>{a.exports=`/* Styling that is common to warnings and errors is in diagnosticOutput.css */

