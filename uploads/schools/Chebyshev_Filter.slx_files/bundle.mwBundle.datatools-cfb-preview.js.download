    .vePrintDom {
        display: none
    }
}

@media print {

    @page {
        margin: 5%;
    }

    table {
        page-break-after: always;
    }
    #printTable {
        width: 100%;
    }

    #leftHeaderContent {
        white-space: pre;
    }
    #veHeader {
        border: 1px solid black;
        margin-bottom: 5mm;
        padding: 3mm;
        display: block;
    }
    #veHeader #leftHeader {
        display: inline-block;
    }
    #veHeader #rightHeader {
        float: right;
        display: inline-block;
    }

    #printTable .ClientViewDiv .textArea {
        width: 100%;
        height: 100%;
        white-space: pre;
    }

    #printTable .varIconNode > svg {
        /* Set the min/max width for SVG variable icons */
        min-width: 16px;
        max-width: 16px;
        min-height: 16px;
        max-height: 16px;
    }

    /*#rightHeader:before {
        counter-increment: page;
        content:"Page " counter(page);
        left: 0;
        top: 100%;
        white-space: nowrap;
        z-index: 20;
        -moz-border-radius: 5px;
        -moz-box-shadow: 0px 0px 4px #222;
        background-image: -moz-linear-gradient(top, #eeeeee, #cccccc);
    }*/


    table { page-break-inside:auto }
    tr    { page-break-inside:avoid; page-break-after:auto }
}`},7971:(h,S,t)=>{h.exports=t}},h=>{var S=M=>h(h.s=M),t=S(7971)}]);
