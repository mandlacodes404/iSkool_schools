            <div class="summaryBarVarName">\${summaryName}</div><span class="summaryBarAssign"> = </span>
            <div class="summaryBarSize" data-dojo-attach-point="summaryBarSize">\${summarySize}</div>
            <div class="summaryBarType"><a class="summaryBarType">\${summaryType}</a></div>
            <div class="summaryBarStatus" data-dojo-attach-point="summaryBarStatus">\${status}</div>
        </div>
        <div class="filterSummaryData hide" data-dojo-attach-point="FilteredSummary">Filtering Placeholders</div>
    </div>
</div>
`},"dojo/text!variableeditor_peer/HeaderMenus/DateTimeHeaderMenu.html":h=>{h.exports=`<div class="DateTimeHeaderMenu">
