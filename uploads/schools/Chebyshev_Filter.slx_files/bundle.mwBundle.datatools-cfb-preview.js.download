<html>
    <head>
        <meta http-equiv='Content-Type' content='text/html; charset=utf-8'>
        <meta http-equiv='X-UA-Compatible' content='IE=edge,IE=9,chrome=1'>
        <meta name='generator' content='MATLAB'>
    </head>
    <body>
        <div class='vePrintDom'>
            <table id='printTable'>
                <thead>
                    <tr>
                        <td id='printTableHeader'>
                            <div id='veHeader'>
                                <div id='leftHeader'>
                                    <span id = 'leftHeaderContent'></span>
                                </div>
                                <div id='rightHeader'></div>
                            </div>
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td id='printTableCell'></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </body>
</html>`},"dojo/text!variableeditor_client/SummaryBar.html":h=>{h.exports=`<div class="summaryBar" data-dojo-attach-point="summaryBarOuterContainer">
