            position: absolute;
            overflow: hidden;
            max-height: 400px;
            max-width: min(calc(100vw - 20px), 400px);
            z-index: 951;
            opacity: 1;
            transition: opacity  0.2s linear;
            background-color: var(--mw-backgroundColor-tertiary, $mw-backgroundColor-tertiary);
